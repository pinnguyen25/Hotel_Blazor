@page "/book-now"

<div class="container my-4">

    <!-- Tìm kiếm phòng -->
    <div class="card p-4 mb-4 shadow-sm">
        <div class="row g-3">
            <div class="col-12 col-md-4">
                <input type="text" class="form-control" placeholder="Địa điểm" @bind="Location" />
            </div>
            <div class="col-12 col-md-4">
                <input type="date" class="form-control" @bind="CheckInDate" />
            </div>
            <div class="col-12 col-md-4">
                <input type="date" class="form-control" @bind="CheckOutDate" />
            </div>
            <div class="col-12 col-md-4">
                <select class="form-select" @bind="Adults">
                    <option value="1">1 người</option>
                    <option value="2">2 người</option>
                    <option value="3">3 người</option>
                </select>
            </div>
            <div class="col-12 col-md-4">
                <select class="form-select" @bind="SelectedRoomType">
                    <option value="Single">Phòng đơn</option>
                    <option value="Double">Phòng đôi</option>
                    <option value="Suite">Phòng suite</option>
                </select>
            </div>
            <div class="col-12 col-md-4">
                <button class="btn btn-primary w-100" @onclick="SearchRooms">Tìm phòng</button>
            </div>
        </div>
    </div>

    <!-- Danh sách phòng -->
    <div class="row g-4">
        @foreach (var room in Rooms)
        {
            <div class="col-12 col-sm-6 col-md-4">
                <div class="card h-100 shadow-sm">
                    <img src="@room.ImageUrl" class="card-img-top" alt="@room.Name" style="height:200px; object-fit:cover;" />
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">@room.Name</h5>
                        <p class="card-text">Giá: @room.PriceVND.ToString("N0") VND/đêm</p>
                        <button class="btn btn-secondary mt-auto">Đặt ngay</button>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@code {
    private string Location { get; set; } = "";
    private DateTime? CheckInDate { get; set; }
    private DateTime? CheckOutDate { get; set; }
    private int Adults { get; set; } = 1;

    private RoomType SelectedRoomType { get; set; } = RoomType.Single;

    private List<Room> Rooms { get; set; } = new List<Room>
    {
        new Room { Name = "Phòng Deluxe", PriceVND = 2000000, ImageUrl = "images/room1.jpg" },
        new Room { Name = "Phòng Superior", PriceVND = 1500000, ImageUrl = "images/room2.jpg" },
        new Room { Name = "Phòng Suite", PriceVND = 3000000, ImageUrl = "images/room3.jpg" }
    };

    private void SearchRooms()
    {
        // TODO: filter Rooms theo Location, Date, Adults, SelectedRoomType
    }

    public class Room
    {
        public string Name { get; set; } = "";
        public int PriceVND { get; set; }
        public string ImageUrl { get; set; } = "";
    }

    public enum RoomType
    {
        Single,
        Double,
        Suite
    }
}
