@page "/wishlist-page"
@using HotelBooking.webapp.ViewModels.Hotel
@inject IHttpClientFactory _httpClientFactory
@inject AuthenticationStateProvider AuthStateProvider
@using MudBlazor

<h2 class="mb-4">Khách sạn đã lưu</h2>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <MudAlert Severity="Severity.Error">@errorMessage</MudAlert>
}
<div class="row">
    @if (SavedHotels == null)
    {
        <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
    }
    else if (!SavedHotels.Any())
    {
        <MudAlert Severity="Severity.Info">Bạn chưa lưu khách sạn nào.</MudAlert>
    }
    else
    {
        @foreach (var hotel in SavedHotels)
        {
            <div class="col-sm-6 col-md-3 mb-4">
                <HotelCard Hotel="hotel" OnWishlistToggle="ToggleWishlist" />
            </div>
        }
    }
</div>

@code {
    private List<HotelListItemVM> SavedHotels = new List<HotelListItemVM>();
    private HashSet<int> loadingHotels = new HashSet<int>();
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var httpClient = _httpClientFactory.CreateClient("HotelBookingAPI");
            var res = await httpClient.GetFromJsonAsync<List<HotelListItemVM>>("Wishlist/GetUserWishlist");

            if (res != null)
            {
                SavedHotels = res.Select(h => new HotelListItemVM
                {
                    HotelId = h.HotelId,
                    HotelName = h.HotelName,
                    Address = h.Address,
                    City = h.City,
                    Country = h.Country,
                    ShortDescription = h.ShortDescription,
                    CoverImageUrl = string.IsNullOrEmpty(h.CoverImageUrl) ? "/images/default-hotel.jpg" : h.CoverImageUrl,
                    ImageUrls = h.ImageUrls ?? new List<string>(),
                    HighlightAmenities = h.HighlightAmenities.Select(a => new AmenityVM { Id = a.Id, Name = a.Name }).ToList(),
                    IsWishlist = true, // Always true in wishlist
                    MinPricePerNight = h.MinPricePerNight,
                    AverageRating = h.AverageRating,
                    ReviewCount = h.ReviewCount,
                    AvailableRooms = h.AvailableRooms,
                    MaxAdultCapacity = h.MaxAdultCapacity,
                    MaxChildCapacity = h.MaxChildCapacity,
                    IsVerified = false, // Not in HotelListItemh, default
                    Status = "PendingVerification" // Not in HotelListItemh, default
                }).ToList();
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Lỗi khi tải danh sách khách sạn đã lưu.";
            Console.WriteLine($"Error: {ex.Message}");
            SavedHotels = new List<HotelListItemVM>();
        }
    }

    private async Task ToggleWishlist(int hotelId)
    {
        if (loadingHotels.Contains(hotelId)) return;
        loadingHotels.Add(hotelId);
        try
        {
            var hotel = SavedHotels.FirstOrDefault(h => h.HotelId == hotelId);
            if (hotel != null)
            {
                var prevState = hotel.IsWishlist;
                hotel.IsWishlist = !hotel.IsWishlist;

                var httpClient = _httpClientFactory.CreateClient("HotelBookingAPI");
                var res = await httpClient.PostAsync($"Wishlist/toggle/{hotelId}", null);

                if (res.IsSuccessStatusCode)
                {
                    if (!hotel.IsWishlist)
                    {
                        SavedHotels.Remove(hotel);
                    }
                }
                else
                {
                    hotel.IsWishlist = prevState;
                }
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error: {ex.Message}");
        }
        finally
        {
            loadingHotels.Remove(hotelId);
        }
    }

}