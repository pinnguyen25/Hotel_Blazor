@* @page "/hoteldetail/{HotelId:int}" *@
@page "/hoteldetail"
@layout MainLayout
@using MudBlazor
<div class="container my-4">

    <!-- Nút quay lại -->
    <div class="row mb-2 mt-2 ">
        <div class="col-12">
            <button style="border-radius:50%;" @onclick="GoBack">
                <i class="bi bi-arrow-left-short fs-2"></i>
            </button>
        </div>
    </div>

    <!-- Ảnh của khách sạn -->
    <MudForm Model="HotelImages" Class="pb-5">
        <MudGrid>
            <!-- Ảnh chính lớn -->
            <MudItem xs="12" sm="6">
                <div style="width:100%;">
                    <img src="@HotelImages[0]" style="width:100%; height:390px; object-fit:cover; border-radius:8px;" />
                </div>
            </MudItem>

            <!-- Ảnh phụ -->
            <MudItem xs="12" sm="6">
                <div style="display:grid; grid-template-columns:1fr 1fr; gap:10px;">
                    @for (int i = 1; i < HotelImages.Count; i++)
                    {
                        <img src="@HotelImages[i]"
                            style="width:100%;height:190px;object-fit:cover; border-radius:6px;border:2px solid #ddd;" />
                    }
                </div>
            </MudItem>
        </MudGrid>
    </MudForm>

    <div class="row g-4">
        <!-- Thông tin khách sạn -->
        <div class="col-12">
            <!-- Tên khách sạn & Rating -->
            <div class="d-flex justify-content-between align-items-start mb-3 flex-wrap">
                <!-- Tên khách sạn -->
                <div class="flex-grow-1 me-3">
                    <h2 class="fw-bold ">Khách sạn ABC</h2>
                    <p class="text-muted mb-0">123 Phố Nguyễn Huệ, Hà Nội, Việt Nam</p>
                </div>

                <!-- Rating -->
                <div class="d-flex align-items-center gap-2 mt-2 mt-md-0">
                    <div class="d-flex flex-column text-end">
                        <span class="fw-semibold">Excellent</span>
                        <small class="text-muted">1,920 reviews</small>
                    </div>
                    <span class="badge bg-warning text-dark fs-5 fw-bold">9.6</span>
                </div>
            </div>

            <!-- Tiện nghi & Mô tả-->
            <div class="row mb-4">
                <!-- Tiện nghi -->
                <div class="col-12 col-md-6">
                    <h5>Tiện nghi</h5>
                    <div class="row g-2">
                        @* Chia mỗi 3 tiện nghi thành 1 col *@
                        @{
                            var amenities = new List<(string Icon, string Name)>
                                                {
                                                ("bi-wifi", "WiFi miễn phí"),
                                                ("bi-ui-checks-grid", "Hồ bơi"),
                                                ("bi-dumbbell", "Gym"),
                                                ("bi-cup-straw", "Nhà hàng"),
                                                ("bi-spa", "Spa")
                                                };
                        }

                        @for (int i = 0; i < amenities.Count; i++)
                        {
                            <div class="col-4 d-flex align-items-center">
                                <i class="bi @amenities[i].Icon me-1"></i> @amenities[i].Name
                            </div>
                        }
                    </div>
                </div>

                <!-- Mô tả -->
                <div class="col-12 col-md-6">
                    <h5>Mô tả</h5>
                    <p>Khách sạn sang trọng với phòng hiện đại, tiện nghi đầy đủ, vị trí trung tâm.
                        Phòng nghỉ được thiết kế thoáng đãng, view đẹp, phục vụ chu đáo và tiện nghi đa dạng.</p>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Danh sách phòng -->
<section class="w-100 py-5" style="background-color:#f8f9fa;">
    <div class="container my-4">
        <h5 class="mb-4 fw-semibold">Các loại phòng</h5>
        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-4 g-4">
            @foreach (var room in Rooms.Take(4))
            {
                <div class="col">
                    <div class="card h-100 shadow-sm border-0">
                        <img src="@room.ImageUrl" class="card-img-top" alt="@room.Name"
                            style="height:180px; object-fit:cover; border-radius:8px 8px 0 0;" />
                        <div class="card-body d-flex flex-column">
                            <h6 class="card-title fw-semibold">@room.Name</h6>
                            <p class="card-text text-muted mb-2">Giá: @room.PriceVND.ToString("N0") VND/đêm</p>
                            <button class="btn btn-outline-primary mt-auto">Đặt ngay</button>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<div class="container my-5">
    <h5 class="mb-4 fw-semibold text-primary">Đánh giá</h5>

    <MudCarousel TData="Review" ShowArrows="true" AutoCycle="false" Class="py-4" Color="Color.Info">
        @foreach (var review in Reviews)
        {
            <MudCarouselItem>
                <div class="card border-0 shadow-sm p-4 d-flex flex-column align-items-center justify-content-center"
                     style="min-height:250px; border-radius:16px; background-color:#ffffff;">

                    <!-- Điểm đánh giá -->
                    <span class="badge bg-info text-white fs-5 fw-bold mb-3 px-3 py-2" 
                          style="border-radius:12px;">
                        @review.Rating / 10
                    </span>

                    <!-- Nội dung -->
                    <p class="text-center fst-italic text-secondary px-3 mb-3" 
                       style="font-size:1.05rem;">
                        "@review.Content"
                    </p>

                    <!-- Avatar + Tên -->
                    <div class="d-flex align-items-center mt-auto">
                        <i class="bi bi-person-circle fs-3 me-2 text-info"></i>
                        <span class="fw-semibold text-dark">@review.UserName</span>
                    </div>

                    <!-- Ngày -->
                    <small class="text-muted mt-2">@review.Date.ToString("dd/MM/yyyy")</small>
                </div>
            </MudCarouselItem>
        }
    </MudCarousel>
</div>

@code {
    [Inject] private NavigationManager Navigation { get; set; } = default!;
    public class Review
    {
        public string UserName { get; set; } = "";
        public string Content { get; set; } = "";
        public int Rating { get; set; }
        public DateTime Date { get; set; }
    }

    private List<Review> Reviews = new()
{
new Review { UserName="Nguyễn Văn A", Content="Phòng sạch sẽ, nhân viên thân thiện!", Rating=9, Date=new
DateTime(2025,9,25)},
new Review { UserName="Trần Thị B", Content="Vị trí tốt, nhưng giá hơi cao.", Rating=8, Date=new DateTime(2025,9,22)},
new Review { UserName="Lê Văn C", Content="Bữa sáng ngon và đa dạng.", Rating=10, Date=new DateTime(2025,9,20)},
};

    private void GoBack()
    {
        // Quay về trang trước (hoặc một trang cụ thể)
        Navigation.NavigateTo("/", true); // "/" là trang trước, bạn có thể thay bằng url danh sách khách sạn
    }
    private List<Room> Rooms { get; set; } = new List<Room>
{
new Room { Name = "Phòng Deluxe", PriceVND = 2000000, ImageUrl = "images/room1.jpg" },
new Room { Name = "Phòng Superior", PriceVND = 1500000, ImageUrl = "images/room2.jpg" },
new Room { Name = "Phòng Suite", PriceVND = 3000000, ImageUrl = "images/room3.jpg" },
new Room { Name = "Phòng Family", PriceVND = 2500000, ImageUrl = "images/room4.jpg" }
};
    private List<string> HotelImages { get; set; } = new List<string>
{
"images/hotel1.jpg",
"images/hotel1-1.jpg",
"images/hotel1-2.jpg",
"images/hotel1-3.jpg",
"images/hotel1-4.jpg"
};
    public class Room
    {
        public string Name { get; set; } = "";
        public int PriceVND { get; set; }
        public string ImageUrl { get; set; } = "";
    }
}