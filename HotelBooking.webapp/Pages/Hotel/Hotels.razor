@code
{
    // Danh sách khách sạn gốc
    private List<HotelListItemVM> originHotelList = new List<HotelListItemVM>();
    // Danh sách khách sạn hiển thị
    private List<HotelListItemVM> FilterHotelList = new List<HotelListItemVM>();
    // Các biến trạng thái cho bộ lọc
    private decimal _priceRangeValue = 10000000m; // Giá trị khởi tạo cao để hiển thị tất cả
    private HashSet<double> _selectedRatings = new() { 8, 6 };
    private HashSet<int> loadingHotels = new HashSet<int>();
    private string? errorMessage;
    private bool isLoading = true;
    private bool isSearchResult;
    private string searchDestination = "";
    private SearchResultVM currentSearchQuery = new SearchResultVM();
    protected override async Task OnInitializedAsync()
    {
        _nav.LocationChanged += HandleLocationChanged;
        await LoadHotelAsync();
    }

    private async void HandleLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        await LoadHotelAsync();
    }

    private async Task LoadHotelAsync()
    {
        isLoading = true;
        await InvokeAsync(StateHasChanged);

        var httpClient = _httpClientFactory.CreateClient("HotelBookingAPI");
        var uri = _nav.ToAbsoluteUri(_nav.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);

        // lấy accTypeId từ query
        int.TryParse(query["accTypeId"], out int accTypeId);

        var queryParams = new SearchResultVM
        {
            Destination = query["destination"] ?? "",
            CheckIn = DateTime.TryParse(query["checkin"], out var checkInDate) ? checkInDate : null,
            CheckOut = DateTime.TryParse(query["checkout"], out var checkOutDate) ? checkOutDate : null,
            Adults = int.TryParse(query["adults"], out var a) ? a : 1,
            Children = int.TryParse(query["children"], out var c) ? c : 0,
            Rooms = int.TryParse(query["rooms"], out var r) ? r : 1,
        };
        currentSearchQuery = queryParams;

        try
        {
            if (accTypeId > 0)
            {
                var response = await httpClient.GetAsync($"Hotel/get-hotel-by-accTypeId/{accTypeId}");
                if (!response.IsSuccessStatusCode)
                {
                    errorMessage = "Không thể tải danh sách khách sạn.";
                    originHotelList = new List<HotelListItemVM>();
                    return;
                }

                var json = await response.Content.ReadAsStringAsync();
                var apiResponse = JsonSerializer.Deserialize<ApiResponse<List<HotelListItemVM>>>(json,
                new JsonSerializerOptions { PropertyNameCaseInsensitive = true });

                originHotelList = apiResponse?.StatusCode == StatusCodeResponse.Success
                ? apiResponse.Content ?? new List<HotelListItemVM>()
                : new List<HotelListItemVM>();
            }
            else if (!string.IsNullOrEmpty(queryParams.Destination))
            {
                // truyền dữ liệu tìm kiếm vào searchform
                isSearchResult = true;
                searchDestination = queryParams.Destination;
                var queryDict = new Dictionary<string, string?>
                {
                    ["destination"] = queryParams.Destination,
                    ["checkIn"] = queryParams.CheckIn?.ToString("yyyy-MM-dd"),
                    ["checkOut"] = queryParams.CheckOut?.ToString("yyyy-MM-dd"),
                    ["adults"] = queryParams.Adults.ToString(),
                    ["children"] = queryParams.Children.ToString(),
                    ["rooms"] = queryParams.Rooms.ToString(),
                };

                var apiUrl = QueryHelpers.AddQueryString("Hotel/get-search-options", queryDict);
                originHotelList = await httpClient.GetFromJsonAsync<List<HotelListItemVM>>(apiUrl) ?? new List<HotelListItemVM>();
            }
            else
            {
                // dữ liệu tìm kiếm null
                isSearchResult = false;
                originHotelList = await httpClient.GetFromJsonAsync<List<HotelListItemVM>>("Hotel/get-all") ?? new
                List<HotelListItemVM>();
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Đã có lỗi xảy ra khi tải dữ liệu. Vui lòng thử lại.";
            Console.WriteLine($"Error loading hotels: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            ApplyFilters(); // Luôn gọi ApplyFilters sau khi tải xong, kể cả khi có lỗi
            await InvokeAsync(StateHasChanged);
        }
    }

    private void ApplyFilters()
    {
        // Bắt đầu từ danh sách gốc
        var query = originHotelList.AsQueryable();

        // 1. Lọc theo giá
        query = query.Where(h => (h.MinPricePerNight ?? 0) <= _priceRangeValue);

        // 2. Lọc theo đánh giá
        if (_selectedRatings.Any())
        {
            query = query.Where(h =>
            _selectedRatings.Any(rating => h.AverageRating >= (decimal)rating && h.AverageRating < (decimal)rating + 2)
            );
        }

        // 3. (Tùy chọn) Lọc theo các tiêu chí khác (Free Cancellation, etc.)
        // if (freeCancellation) { query = query.Where(h => h.HasFreeCancellation); }

        // Cập nhật danh sách hiển thị
        FilterHotelList = query.ToList();

        // render lại giao diện
        StateHasChanged();
    }

    private void OnRatingFilterChanged(bool isChecked, double ratingValue)
    {
        if (isChecked)
        {
            _selectedRatings.Add(ratingValue);
        }
        else
        {
            _selectedRatings.Remove(ratingValue);
        }
        ApplyFilters();
    }
    @* private HashSet<int> loadingHotels = new(); *@
    private async Task HandleWishlistToggle(int hotelId)
    {
        if (loadingHotels.Contains(hotelId)) return;
        loadingHotels.Add(hotelId);

        try
        {
            var hotel = originHotelList.FirstOrDefault(h => h.HotelId == hotelId);
            if (hotel != null)
            {
                var prevState = hotel.IsWishlist;
                hotel.IsWishlist = !hotel.IsWishlist;

                var httpClient = _httpClientFactory.CreateClient("HotelBookingAPI");
                var res = await httpClient.PostAsync($"Wishlist/toggle/{hotelId}", null);

                if (!res.IsSuccessStatusCode)
                {
                    hotel.IsWishlist = prevState;
                }
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error:{ex.Message}");
        }
        finally
        {
            loadingHotels.Remove(hotelId);
        }
    }

    public void Dispose()
    {
        _nav.LocationChanged -= HandleLocationChanged;
    }
}