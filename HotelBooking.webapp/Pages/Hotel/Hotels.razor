@page "/Hotels"
@layout MainLayout
@using Blazored.LocalStorage
@using HotelBooking.webapp.ViewModels.Hotel
@using MudBlazor
@using System.Net.Http
@using Microsoft.AspNetCore.WebUtilities
@using System.Text.Json
@using Microsoft.Extensions.Primitives
@inject NavigationManager _nav
@inject IHttpClientFactory _httpClientFactory
@inject IHotelServices HotelServices
@inject ILocalStorageService _localStorage
@inject ISnackbar Snackbar
<Header IsFixed="true" />
<section class="hero-section position-relative min-vh-100">
    <div class="hero-bg h-100 w-100">
        @if (banners != null && banners.Any())
        {
            <MudCarousel Class="mud-width-full vh-100" ShowArrows="false" ShowBullets="false" AutoCycle="true"
                TData="object" Interval="4000"> @foreach (var banner in banners)
                {
                    <MudCarouselItem Transition="Transition.Fade" Color="@Color.Transparent">
                        <div class="d-flex h-100 w-100">
                            @if (!string.IsNullOrEmpty(banner.LinkUrl))
                            {
                                <a href="@banner.LinkUrl" class="w-100 h-100 d-block">
                                    <img src="@banner.ImageUrl" alt="@banner.Title" class="w-100 h-100 object-fit-cover" />
                                </a>
                            }
                            else
                            {
                                <img src="@banner.ImageUrl" alt="@banner.Title" class="w-100 h-100 object-fit-cover" />
                            }
                        </div>
                    </MudCarouselItem>
                }
            </MudCarousel>
        }
        else
        {
            <img src="" alt="Hero Background" class="w-100 vh-100 object-fit-cover" />
        }
    </div>

    @* <div class="hero-overlay"></div> *@
    <SearchForm SearchResult="@currentSearchState" />
</section>

<section class="container my-5">
    <div class="row">
        <div class="col-lg-3">
            <HotelsFilter OnFilterChanged="ApplyFilterLocal" InitialState="@currentFilterState" />
        </div>

        <div class="col-lg-9">
            <h2 class="handwriting mb-4 text-center" style="color: #54a9ffff">
                @(string.IsNullOrEmpty(currentSearchState.Destination) ? "Tất cả địa điểm" : $"Kết quả cho {currentSearchState.Destination}")
            </h2>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <MudAlert Severity="Severity.Error">@errorMessage</MudAlert>
            }
            <div class=" hotel-list-container">
                @if (isLoading)
                {
                    <div class="text-center mt-5">
                        <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Large" />
                        <p class="mt-2">Đang tải dữ liệu khách sạn...</p>
                    </div>
                }
                else if (hotels == null || !hotels.Any())
                {
                    <MudAlert Severity="Severity.Info">Không tìm thấy khách sạn nào phù hợp.</MudAlert>
                }
                else
                {
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <MudText>Tìm thấy <b>@hotels.Count</b> chỗ ở phù hợp.</MudText>
                    </div>
                    <div class="row">
                        @foreach (var hotel in hotels)
                        {
                            <div class="col-12 mb-4">
                                <HotelListCard Hotel="@hotel" OnWishlistToggle="HandleWishlistToggle" />
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    // 1. DATA
    private List<HotelListItemVM> hotels = new();
    private List<BannerVM> banners = new();
    // 2. STATE
    private SearchResultVM currentSearchState = new(); // Lưu thông tin Search (Destination, Date...)
    private FilterHotelsVM currentFilterState = new(); // Lưu thông tin Filter (Price, Amenity...)

    // 3. UI FLAGS
    private bool isLoading = true;
    private string? errorMessage;
    private HashSet<int> loadingHotels = new HashSet<int>();

    protected override async Task OnInitializedAsync()
    {
        // Chỉ lắng nghe URL khi người dùng Back/Forward trình duyệt
        _nav.LocationChanged += HandleLocationChanged;

        // Lần đầu vào trang: Parse URL -> Load Data
        var loadDataTask = LoadDataFromUrl();
        var loadBannerTask = LoadBanners();

        await Task.WhenAll(loadDataTask, loadBannerTask);
    }

    private async void HandleLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        // Khi URL thực sự đổi (VD: Bấm Back), ta load lại từ đầu
        await LoadDataFromUrl();
        StateHasChanged();
    }

    // --- LOGIC 1: XỬ LÝ KHI BẤM FILTER (Tại chỗ - Không đổi URL) ---
    private async Task ApplyFilterLocal(FilterHotelsVM filter)
    {
        // 1. Cập nhật State Filter
        currentFilterState = filter;

        // 2. Lấy thông tin Search cơ bản (giữ nguyên từ lúc load trang)
        // Ta cần kết hợp: [Search Params] + [New Filter Params]
        var queryParams = new Dictionary<string, string?>();

        // - Đưa Search Params vào (Destination, Date, Rooms...)
        if (!string.IsNullOrEmpty(currentSearchState.Destination)) queryParams["destination"] = currentSearchState.Destination;
        if (currentSearchState.CheckIn.HasValue) queryParams["checkIn"] =
        currentSearchState.CheckIn.Value.ToString("yyyy-MM-dd");
        if (currentSearchState.CheckOut.HasValue) queryParams["checkOut"] =
        currentSearchState.CheckOut.Value.ToString("yyyy-MM-dd");
        queryParams["adults"] = currentSearchState.Adults.ToString();
        queryParams["children"] = currentSearchState.Children.ToString();
        queryParams["rooms"] = currentSearchState.Rooms.ToString();

        // - Đưa Filter Params mới vào
        if (filter.PriceMin.HasValue && filter.PriceMin > 0) queryParams["priceMin"] = filter.PriceMin.ToString();
        if (filter.PriceMax.HasValue && filter.PriceMax < 10000000m) queryParams["priceMax"] = filter.PriceMax.ToString();
        if (filter.RatingMin.HasValue && filter.RatingMin > 0) queryParams["ratingMin"] = filter.RatingMin.ToString();
        if (!string.IsNullOrEmpty(filter.AccommodationTypeIds)) queryParams["accommodationTypeIds"] =
        filter.AccommodationTypeIds;
        if (!string.IsNullOrEmpty(filter.AmenityIds)) queryParams["amenityIds"] = filter.AmenityIds;
        if (!string.IsNullOrEmpty(filter.ServiceIds)) queryParams["serviceIds"] = filter.ServiceIds;
        // 3. Build Query String thủ công để gọi API
        var newQueryString = QueryHelpers.AddQueryString("", queryParams);

        // 4. Gọi API Load lại List (Chỉ phần List xoay xoay, trang không cuộn)
        await FetchHotelsApi(newQueryString);
    }

    // --- LOGIC 2: LOAD DỮ LIỆU BAN ĐẦU TỪ URL ---
    private async Task LoadDataFromUrl()
    {
        var uri = _nav.ToAbsoluteUri(_nav.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);

        // Parse URL vào State
        ParseUrlToState(query);

        // Xử lý logic accTypeId (Category)
        string queryString = uri.Query;
        if (query.ContainsKey("accTypeId") && int.TryParse(query["accTypeId"], out int accId))
        {
            var prefix = string.IsNullOrEmpty(queryString) ? "?" : "&";
            queryString += $"{prefix}accommodationTypeIds={accId}";
        }

        await FetchHotelsApi(queryString);
    }

    private async Task LoadBanners()
    {
        try
        {
            var client = _httpClientFactory.CreateClient("HotelBookingAPI");
            var options = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };

            // Gọi API lấy banner trang Home
            var response = await client.GetAsync("hotel/get-by-page/Hotels");

            if (response.IsSuccessStatusCode)
            {
                var apiRes = await response.Content.ReadFromJsonAsync<ApiResponse<List<BannerVM>>>(options);
                if (apiRes != null && apiRes.Content != null)
                {
                    banners = apiRes.Content;
                }
            }
        }
        catch (Exception)
        {
            // Nếu lỗi kết nối, banners sẽ rỗng -> Hiển thị Fallback (Mục 3)
            Console.WriteLine("Không thể tải banner từ API");
        }
    }

    // --- LOGIC 3: GỌI API (Dùng chung) ---
    private async Task FetchHotelsApi(string queryString)
    {
        isLoading = true;
        errorMessage = null;
        StateHasChanged(); // Bật loading spinner ngay

        try
        {
            var client = _httpClientFactory.CreateClient("HotelBookingAPI");
            var options = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };

            // Nếu queryString bắt đầu bằng ? thì OK, nếu chưa có thì thêm (cho hàm AddQueryString trả về)
            if (!string.IsNullOrEmpty(queryString) && !queryString.StartsWith("?")) queryString = "?" + queryString;

            var endpoint = string.IsNullOrEmpty(queryString)
            ? "Hotel/get-search-options"
            : $"Hotel/get-search-options{queryString}";

            var response = await client.GetAsync(endpoint);

            if (response.IsSuccessStatusCode)
            {
                hotels = await response.Content.ReadFromJsonAsync<List<HotelListItemVM>>(options) ?? new();
            }
            else
            {
                hotels.Clear();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error: {ex.Message}");
            errorMessage = "Lỗi kết nối máy chủ.";
        }
        finally
        {
            isLoading = false;
            StateHasChanged(); // Tắt loading
        }
    }

    // Helper: Parse URL -> State
    private void ParseUrlToState(Dictionary<string, StringValues> query)
    {
        // Search State
        currentSearchState = new SearchResultVM
        {
            Destination = query.TryGetValue("destination", out var d) ? d.ToString() : "",
            CheckIn = query.TryGetValue("checkIn", out var ci) && DateTime.TryParse(ci, out var d1) ? d1 : DateTime.Today,
            CheckOut = query.TryGetValue("checkOut", out var co) && DateTime.TryParse(co, out var d2) ? d2 :
        DateTime.Today.AddDays(1),
            Adults = query.TryGetValue("adults", out var a) && int.TryParse(a, out int av) ? av : 1,
            Children = query.TryGetValue("children", out var c) && int.TryParse(c, out int cv) ? cv : 0,
            Rooms = query.TryGetValue("rooms", out var r) && int.TryParse(r, out int rv) ? rv : 1,
        };

        // Filter State
        currentFilterState = new FilterHotelsVM
        {
            PriceMax = query.TryGetValue("priceMax", out var pm) && decimal.TryParse(pm, out var pmv) ? pmv : null,
            RatingMin = query.TryGetValue("ratingMin", out var rm) && decimal.TryParse(rm, out var rmv) ? rmv : null,
            AccommodationTypeIds = query.TryGetValue("accommodationTypeIds", out var acc) ? acc.ToString() : null,
            AmenityIds = query.TryGetValue("amenityIds", out var am) ? am.ToString() : null,
            ServiceIds = query.TryGetValue("serviceIds", out var sv) ? sv.ToString() : null
        };
    }

    private async Task HandleWishlistToggle(int hotelId)
    {
        // Giữ nguyên logic cũ của bạn
        if (loadingHotels.Contains(hotelId)) return;

        var token = await _localStorage.GetItemAsync<string>("accessToken");
        if (string.IsNullOrEmpty(token)) return;

        loadingHotels.Add(hotelId);
        var hotel = hotels.FirstOrDefault(h => h.HotelId == hotelId);
        if (hotel != null)
        {
            var oldState = hotel.IsWishlist;
            hotel.IsWishlist = !oldState;
            try
            {
                var client = _httpClientFactory.CreateClient("HotelBookingAPI");
                client.DefaultRequestHeaders.Authorization =
                new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
                var res = await client.PostAsync($"Wishlist/toggle/{hotelId}", null);
                if (res.IsSuccessStatusCode)
                {
                    Snackbar.Add(hotel.IsWishlist ? "Đã lưu" : "Đã bỏ lưu", Severity.Success);
                }
                else if (res.StatusCode == System.Net.HttpStatusCode.Unauthorized)
                {
                    // Token hết hạn -> Rollback & Logout
                    hotel.IsWishlist = oldState;
                    Snackbar.Add("Phiên đăng nhập hết hạn.", Severity.Error);
                    await _localStorage.RemoveItemAsync("accessToken");
                    _nav.NavigateTo("/customer-login");
                }
                else
                {
                    hotel.IsWishlist = oldState; // Rollback
                    Snackbar.Add("Lỗi cập nhật.", Severity.Error);
                }
            }
            catch
            {
                hotel.IsWishlist = oldState; // Rollback
                Snackbar.Add("Lỗi kết nối.", Severity.Error);
            }
            finally
            {
                loadingHotels.Remove(hotelId);
                StateHasChanged();
            }
        }
    }

    public void Dispose() => _nav.LocationChanged -= HandleLocationChanged;
}