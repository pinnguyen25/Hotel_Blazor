@code {
  private List<HotelCardVM> hotels = null!;
  private HashSet<int> loadingHotels = new HashSet<int>(); 
  private string? errorMessage;
  private int? userId; // Giả sử userId là 1 cho ví dụ này

  protected override async Task OnInitializedAsync()
  {
    await LoadUserId();
    await LoadHotels();
  }

  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if (firstRender)
    {
      // Gọi JS init carousel sau khi render xong lần đầu
      await JS.InvokeVoidAsync("initMultiCardCarousel");
    }
  }


  private async Task LoadUserId()
  {
    var authState = await AuthStateProvider.GetAuthenticationStateAsync();
    var user = authState.User;
    if (user.Identity?.IsAuthenticated == true)
    {
      userId = int.Parse(user.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? "0");
    }
  }

  // Hàm tải danh sách khách sạn từ API
  private async Task LoadHotels()
    {
        try
        {
            var httpClient = HttpClientFactory.CreateClient("HotelBookingAPI");
            var query = userId.HasValue ? $"?userId={userId}" : "";
            hotels = await httpClient.GetFromJsonAsync<List<HotelCardVM>>($"api/hotels/highly-rated{query}");
        }
        catch (Exception ex)
        {
            errorMessage = "Lỗi khi tải danh sách khách sạn.";
            Console.WriteLine($"Error loading hotels: {ex.Message}");
            hotels = new List<HotelCardVM>();
        }
    }
  private async Task ToggleWishlist(int hotelId)
  {
    if(loadingHotels.Contains(hotelId)) return; // chặn double click
    loadingHotels.Add(hotelId);
    
    var hotel = hotels.FirstOrDefault(h => h.HotelId == hotelId);
    if (hotel != null)
    {
      hotel.IsWishlist = !hotel.IsWishlist;
      try
      {
        var httpClient = HttpClientFactory.CreateClient("HotelBookingAPI");
        await httpClient.PostAsJsonAsync($"api/wishlist/toggle/{hotelId}", new { IsWishlist = hotel.IsWishlist });
      }
      catch (Exception ex)
      {
        Console.WriteLine($"Error toggling wishlist: {ex.Message}");
      }
      StateHasChanged();
    }
  }

}
