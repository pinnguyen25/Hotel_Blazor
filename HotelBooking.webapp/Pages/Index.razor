<!-- Chỗ ở được đánh giá cao -->
<div class="container mt-5">
  <h2 class="mb-4 text-center">Chỗ ở được đánh giá cao</h2>
  @if (hotels == null)
  {
    <p>Loading...</p>
  }
  else if (!hotels.Any())
  {
    <p>Không có khách sạn nào được đánh giá cao.</p>
  }
  else
  {
    <div class="row">
      @foreach (var hotel in hotels)
      {
        <div class="col-sm-6 col-md-3 mb-4">
          <HotelCard Hotel="hotel" OnWishlistToggle="ToggleWishlist" />
        </div>
      }
    </div>
  }
</div>


