@page "/admin/manages/manage-policies"
@using Blazored.LocalStorage
@using HotelBooking.webapp.ViewModels.Hotel
@using HotelBooking.webapp.Components.Policy
@layout AdminLayout
@inject IHttpClientFactory HttpClientFactory
@inject ILocalStorageService _localStorage
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Quản lý chính sách khách sạn</PageTitle>

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="mb-1 fw-bold text-primary">Quản lý chính sách khách sạn</h3>
        </div>
        <button class="btn btn-primary d-flex align-items-center gap-2" @onclick="OpenAddPolicyTypeModal">
            <i class="bi bi-plus-circle"></i> Thêm loại mới
        </button>
    </div>

    @if (policyTypes == null)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary"></div>
            <p class="mt-3">Đang tải...</p>
        </div>
    }
    else if (!policyTypes.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-journal-text display-1 text-muted opacity-50"></i>
            <p class="mt-4 fs-4">Chưa có loại chính sách nào</p>
            <button class="btn btn-primary btn-lg" @onclick="OpenAddPolicyTypeModal">
                Tạo loại đầu tiên
            </button>
        </div>
    }
    else
    {
        <div class="accordion" id="policyAccordion">
            @foreach (var type in policyTypes)
            {
                var accordionId = $"collapse-{type.Id}";
                var isOpen = OpenAccordions.Contains(type.Id);

                <div class="accordion-item border-0 shadow-sm mb-3 rounded">

                    <h2 class="accordion-header" id="heading-@type.Id">
                        <button class="accordion-button @(isOpen ? "" : "collapsed") fw-medium bg-white" type="button"
                            @onclick="() => ToggleAccordion(type.Id)">
                            <div class="d-flex justify-content-between w-100 align-items-center pe-3">
                                <div>
                                    <i class="bi bi-tag-fill text-primary me-2"></i>
                                    <strong>@type.Name</strong>
                                    <span class="ms-3 text-muted small">
                                        @type.PolicyCount chính sách
                                    </span>
                                    @if (!string.IsNullOrEmpty(type.Code))
                                    {
                                        <code class="ms-2 small">@type.Code</code>
                                    }
                                </div>
                            </div>
                        </button>
                    </h2>

                    <div id="@accordionId" class="accordion-collapse collapse @(isOpen ? "show" : "")"
                        data-bs-parent="#policyAccordion">
                        <div class="accordion-body pt-2">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h6 class="mb-0 fw-medium">Danh sách chính sách
                                    @if (type.PolicyCount > 0)
                                    {
                                        <small class="text-muted ms-2">(có @type.PolicyCount chính sách đang được sử dụng)</small>
                                    }
                                </h6>


                                <div class="d-flex align-items-center gap-2">
                                    <div class="form-check form-switch form-switch-lg d-flex align-items-center">
                                        <input class="form-check-input" type="checkbox" role="switch" id="switch-@type.Id"
                                            checked="@type.IsActive" disabled="@(type.PolicyCount > 0 || isToggling)"
                                            @onchange="() => TogglePolicyTypeActive(type.Id)" />
                                        @if (isToggling && togglingId == type.Id)
                                        {
                                            <div class="spinner-border spinner-border-sm ms-2" role="status"></div>
                                        }
                                    </div>

                                    <button class="btn btn-sm btn-outline-primary me-2"
                                        @onclick="() => OpenAddPolicyModal(type.Id)" @onclick:stopPropagation>
                                        <i class="bi bi-plus"></i> Thêm
                                    </button>
                                    <button class="btn btn-sm btn-outline-warning me-1" @onclick="() => EditPolicyType(type)"
                                        @onclick:stopPropagation>
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => DeletePolicyType(type.Id)"
                                        disabled="@(type.PolicyCount > 0)" @onclick:stopPropagation>
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </div>

                            @if (!type.Policies?.Any() ?? true)
                            {
                                <div class="text-center py-4 text-muted">
                                    <i class="bi bi-inbox fs-3"></i>
                                    <p class="mt-2 small">Chưa có chính sách nào</p>
                                </div>
                            }
                            else
                            {
                                <ul class="list-group list-group-flush">
                                    @foreach (var p in type.Policies.OrderBy(x => x.CreatedAt))
                                    {
                                        <li
                                            class="list-group-item px-0 py-3 border-0 border-bottom d-flex justify-content-between align-items-start">
                                            <div class="flex-fill">
                                                <div class="fw-medium">@p.Name</div>
                                                @if (!string.IsNullOrWhiteSpace(p.Description))
                                                {
                                                    <small class="text-muted">@p.Description</small>
                                                }
                                            </div>
                                            <div class="btn-group btn-group-sm">
                                                <button class="btn btn-outline-warning" @onclick="() => EditPolicy(p)"
                                                    @onclick:stopPropagation>
                                                    <i class="bi bi-pencil"></i>
                                                </button>
                                                <button class="btn btn-outline-danger" @onclick="() => DeletePolicy(p.Id ?? 0)"
                                                    @onclick:stopPropagation>
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </div>
                                        </li>
                                    }
                                </ul>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- Modal loại chính sách -->
@if (showTypeModal)
{
    <PolicyTypeForm PolicyType="currentType" OnSubmit="SavePolicyType" OnCancel="CloseModals" />
}

<!-- Modal chính sách con -->
@if (showPolicyModal)
{
    <PolicyForm Model="currentPolicy" PolicyTypes="policyTypes!" IsSubmitting="isSubmitting" OnSubmit="SavePolicy"
        OnCancel="CloseModals" />
}

@code {
    private List<PolicyTypeVM>? policyTypes;
    private PolicyTypeVM currentType = new();
    private PolicyVM currentPolicy = new();
    private bool showTypeModal = false;
    private bool showPolicyModal = false;
    private bool isSubmitting = false;
    private HttpClient? http;
    private HashSet<int> OpenAccordions { get; set; } = new();

    private bool isToggling = false;
    private int togglingId = 0;
    protected override async Task OnInitializedAsync()
    {
        http = HttpClientFactory.CreateClient("HotelBookingAPI");
        await LoadPolicies();
    }

    private void ToggleAccordion(int typeId)
    {
        if (OpenAccordions.Contains(typeId))
            OpenAccordions.Remove(typeId);
        else
            OpenAccordions.Add(typeId);
    }

    private async Task LoadPolicies()
    {
        try
        {
            await SetAuthHeader();
            var resp = await http!.GetAsync("hotel/get-all-policy");
            var result = await resp.Content.ReadFromJsonAsync<ApiResponse<List<PolicyTypeVM>>>();

            policyTypes = result?.StatusCode == StatusCodeResponse.Success
            ? result.Content ?? new()
            : new();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Lỗi tải dữ liệu: {ex.Message}", Severity.Error);
            policyTypes = new();
        }
        StateHasChanged();
    }

    private async Task SetAuthHeader()
    {
        var token = await _localStorage.GetItemAsync<string>("accessToken");
        if (!string.IsNullOrEmpty(token))
            http!.DefaultRequestHeaders.Authorization = new("Bearer", token);
    }

    private void OpenAddPolicyTypeModal() { currentType = new(); showTypeModal = true; }
    private void EditPolicyType(PolicyTypeVM type)
    {
        currentType = new PolicyTypeVM { Id = type.Id, Name = type.Name, Code = type.Code };
        showTypeModal = true;
    }

    private void OpenAddPolicyModal(int policyTypeId)
    {
        currentPolicy = new PolicyVM { PolicyTypeId = policyTypeId };
        showPolicyModal = true;
    }

    private void EditPolicy(PolicyVM p)
    {
        currentPolicy = new PolicyVM
        {
            Id = p.Id,
            Name = p.Name,
            Description = p.Description,
            PolicyTypeId = p.PolicyTypeId
        };
        showPolicyModal = true;
    }

    private async Task SavePolicyType()
    {
        isSubmitting = true;
        try
        {
            await SetAuthHeader();
            var resp = currentType.Id > 0
            ? await http!.PutAsJsonAsync($"admin/policy-type/{currentType.Id}", currentType)
            : await http!.PostAsJsonAsync("admin/policy-type", currentType);

            if (resp.IsSuccessStatusCode)
            {
                Snackbar.Add("Thành công!", Severity.Success);
                CloseModals();
                await LoadPolicies();
            }
            else
            {
                var msg = await resp.Content.ReadAsStringAsync();
                Snackbar.Add($"Lỗi: {msg}", Severity.Error);
            }
        }
        finally { isSubmitting = false; }
    }

    private async Task SavePolicy()
    {
        isSubmitting = true;
        try
        {
            await SetAuthHeader();
            var resp = currentPolicy.Id > 0
            ? await http!.PutAsJsonAsync($"admin/policy/{currentPolicy.Id}", currentPolicy)
            : await http!.PostAsJsonAsync("admin/policy", currentPolicy);

            if (resp.IsSuccessStatusCode)
            {
                Snackbar.Add("Thành công!", Severity.Success);
                CloseModals();
                await LoadPolicies();
            }
        }
        finally { isSubmitting = false; }
    }

    private async Task DeletePolicyType(int id)
    {
        bool? confirm = await DialogService.ShowMessageBox(
        "Bạn muốn xóa loại chính sách?",
        "Không thể khôi phục sau khi xóa!",
        yesText: "Xóa", cancelText: "Hủy");

        if (confirm == true)
        {
            await SetAuthHeader();
            var resp = await http!.DeleteAsync($"admin/policy-type/{id}");
            Snackbar.Add(resp.IsSuccessStatusCode ? "Đã xóa!" : "Không thể xóa!",
            resp.IsSuccessStatusCode ? Severity.Success : Severity.Error);
            if (resp.IsSuccessStatusCode) await LoadPolicies();
        }
    }

    private async Task DeletePolicy(int id)
    {
        bool? confirm = await DialogService.ShowMessageBox(
        "Xóa chính sách?",
        "Không thể khôi phục sau khi xóa!",
        yesText: "Xóa", cancelText: "Hủy");

        if (confirm == true)
        {
            await SetAuthHeader();
            var resp = await http!.DeleteAsync($"admin/policy/{id}");
            Snackbar.Add(resp.IsSuccessStatusCode ? "Đã xóa!" : "Không thể xóa!",
            resp.IsSuccessStatusCode ? Severity.Success : Severity.Error);
            if (resp.IsSuccessStatusCode) await LoadPolicies();
        }
    }

    private async Task TogglePolicyTypeActive(int id)
    {
        if (isToggling) return;

        var type = policyTypes!.First(x => x.Id == id);
        var oldState = type.IsActive;

        isToggling = true;
        togglingId = id;
        StateHasChanged();

        try
        {
            await SetAuthHeader();
            var resp = await http!.PutAsync($"admin/policy-type/{id}/toggle", null);

            if (resp.IsSuccessStatusCode)
            {
                var result = await resp.Content.ReadFromJsonAsync<ApiResponse<PolicyTypeVM>>();
                type.IsActive = result?.Content?.IsActive ?? !oldState;

                Snackbar.Add(
                type.IsActive ? "Đã bật loại chính sách" : $"Đã tắt {type.Name}",
                Severity.Info);
            }
            else
            {
                type.IsActive = oldState; // rollback
                Snackbar.Add("Lỗi khi thay đổi trạng thái", Severity.Error);
            }
        }
        catch
        {
            type.IsActive = oldState;
            Snackbar.Add("Lỗi kết nối", Severity.Error);
        }
        finally
        {
            isToggling = false;
            togglingId = 0;
            StateHasChanged();
        }
    }
    private void CloseModals() { showTypeModal = showPolicyModal = false; }
}