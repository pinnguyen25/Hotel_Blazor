@page "/customer-login"
@using HotelBooking.Client
@inject NavigationManager _nav
@inject AuthenticationStateProvider AuthStateProvider
@using Microsoft.AspNetCore.WebUtilities
@inject IHttpClientFactory HttpClientFactory
@inject Blazored.LocalStorage.ILocalStorageService localStorage

<div class="auth-bg">
    <div class="auth-overlay"></div>
    
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-10 col-xl-9">
                <div class="glass-card animate-fade-in-up">
                    <div class="row g-0">
                        <div class="col-md-6 d-none d-md-block position-relative">
                            <img src="https://images.unsplash.com/photo-1542314831-068cd1dbfeeb?q=80&w=1000&auto=format&fit=crop" 
                                 class="w-100 h-100 object-fit-cover" 
                                 style="border-top-left-radius: 20px; border-bottom-left-radius: 20px;" 
                                 alt="Relax">
                            <div class="position-absolute bottom-0 start-0 p-5 text-white bg-gradient-dark w-100" style="background: linear-gradient(to top, rgba(0,0,0,0.8), transparent);">
                                <h3 class="fw-bold text-white-70">Chào mừng trở lại!</h3>
                                <p class="mb-0 text-white-50">Sẵn sàng cho kỳ nghỉ tiếp theo của bạn chưa?</p>
                            </div>
                        </div>

                        <div class="col-md-6 p-5 bg-white">
                            <div class="text-center mb-4">
                                <span class="brand-logo">ChillZone</span>
                                <h4 class="fw-bold mt-3 text-dark">Đăng Nhập</h4>
                                <p class="text-muted small">Nhập thông tin tài khoản của bạn</p>
                            </div>

                            @if (!string.IsNullOrEmpty(ReturnUrl) && ReturnUrl.Contains("upgrade-owner"))
                            {
                                <div class="alert alert-info border-0 bg-info bg-opacity-10 text-info d-flex align-items-center mb-4 rounded-3 p-3">
                                    <i class="bi bi-info-circle-fill me-3 fs-4"></i>
                                    <div class="small">Vui lòng <strong>đăng nhập</strong> để tiếp tục đăng ký Đối tác.</div>
                                </div>
                            }

                            @if (!string.IsNullOrEmpty(errorMessage))
                            {
                                <div class="alert alert-danger border-0 bg-danger bg-opacity-10 text-danger mb-4 rounded-3 text-center small">
                                    <i class="bi bi-exclamation-circle me-1"></i> @errorMessage
                                </div>
                            }

                            <EditForm Model="userLogin" OnValidSubmit="HandleValidSubmit">
                                <DataAnnotationsValidator />
                                
                                <div class="form-floating mb-3">
                                    <InputText @bind-Value="userLogin.UsernameOrEmail" class="form-control" id="floatingInput" placeholder="name@example.com" />
                                    <label for="floatingInput" class="text-muted"><i class="bi bi-person me-1"></i> Username / Email</label>
                                    <ValidationMessage For="@(() => userLogin.UsernameOrEmail)" class="text-danger extra-small" />
                                </div>

                                <div class="form-floating mb-3">
                                    <InputText @bind-Value="userLogin.Password" type="password" class="form-control" id="floatingPassword" placeholder="Password" />
                                    <label for="floatingPassword" class="text-muted"><i class="bi bi-lock me-1"></i> Mật khẩu</label>
                                    <ValidationMessage For="@(() => userLogin.Password)" class="text-danger extra-small" />
                                </div>

                                <div class="d-flex justify-content-between align-items-center mb-4">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="rememberMe">
                                        <label class="form-check-label small text-muted" for="rememberMe">Ghi nhớ</label>
                                    </div>
                                    <a href="#" class="small text-decoration-none text-primary fw-bold">Quên mật khẩu?</a>
                                </div>

                                <button type="submit" class="btn-chill mb-4 shadow-sm">
                                    Đăng Nhập <i class="bi bi-arrow-right ms-2"></i>
                                </button>

                                <div class="text-center">
                                    <p class="small text-muted mb-0">Chưa có tài khoản?</p>
                                    <a href="/customer-register@(string.IsNullOrEmpty(ReturnUrl) ? "" : $"?returnUrl={Uri.EscapeDataString(ReturnUrl)}")" 
                                       class="text-decoration-none fw-bold text-primary">Tạo tài khoản mới</a>
                                </div>
                            </EditForm>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    /* CSS đã định nghĩa ở trên (bạn copy paste vào đây hoặc file .css) */
    .extra-small { font-size: 0.75rem; margin-top: 4px; display: block; }
    .object-fit-cover { object-fit: cover; }
    /* ... copy phần css global ... */
</style>

@code {
    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }
    private UserLoginVM userLogin = new UserLoginVM();
    private string? errorMessage;
    private HttpClient? _httpClient;
    protected override void OnInitialized()
    {
        _httpClient = HttpClientFactory.CreateClient("HotelBookingAPI");
    }

    private async Task HandleValidSubmit()
    {
        try
        {
            var response = await _httpClient.PostAsJsonAsync("Account/login", userLogin);
            if (response.IsSuccessStatusCode)
            {
                var loginResponse = await response.Content.ReadFromJsonAsync<LoginResponseDTO>();
                if (loginResponse?.AccessToken != null)
                {
                    await ((CustomAuthStateProvider)AuthStateProvider).MarkUserAsAuthenticated(loginResponse.AccessToken);
                    errorMessage = null;
                    NavigateUserBasedOnRole(loginResponse.Roles, loginResponse.AccessToken);
                }
                else
                {
                    errorMessage = "Không nhận được token đăng nhập.";
                }
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                errorMessage = string.IsNullOrEmpty(errorContent) ? "Đăng nhập thất bại." : errorContent;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Lỗi khi đăng nhập: {ex.Message}";
        }
        await InvokeAsync(StateHasChanged);
    }

    private class UserLoginVM
    {
        public string UsernameOrEmail { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
    }

    private class LoginResponseDTO
    {
        public string AccessToken { get; set; } = string.Empty;
        public string FullName { get; set; } = string.Empty;
        public string? AvatarUrl { get; set; }
        public string Message { get; set; } = string.Empty;
        public List<string> Roles { get; set; } = new();
    }

    private void NavigateUserBasedOnRole(List<string> roles, string token)
    {
        // Giải mã token để lấy HotelId (nếu là Staff)
        // Lưu ý: Blazor không có sẵn JwtSecurityTokenHandler ở client side dễ dàng như server,
        // nhưng CustomAuthStateProvider của bạn đã giải mã rồi.
        // Tuy nhiên, ở đây ta có thể dùng thư viện System.IdentityModel.Tokens.Jwt (nếu đã cài)
        // Hoặc đơn giản là decode payload base64.

        // Cách đơn giản nhất: Lấy AuthenticationState vừa cập nhật
        // Nhưng vì MarkUserAsAuthenticated là async void/task, có thể state chưa update kịp ngay tức thì trong dòng này.
        if (!string.IsNullOrEmpty(ReturnUrl))
        {
            _nav.NavigateTo(ReturnUrl, true);
            return;
        }
        // GIẢI PHÁP: Decode Token thủ công (nhanh)
        var handler = new System.IdentityModel.Tokens.Jwt.JwtSecurityTokenHandler();
        var jwtToken = handler.ReadJwtToken(token);

        if (roles.Contains("Staff"))
        {
            var hotelIdClaim = jwtToken.Claims.FirstOrDefault(c => c.Type == "HotelId")?.Value;
            if (!string.IsNullOrEmpty(hotelIdClaim))
            {
                _nav.NavigateTo($"/owner/hotels/{hotelIdClaim}/room-map", true);
                return; // Dừng luôn, không check tiếp
            }
        }

        if (roles.Contains("Admin"))
        {
            _nav.NavigateTo("/admin/dashboard", true);
        }
        else
        {
            // Bao gồm cả Owner và Customer
            _nav.NavigateTo("/", true);
        }
    }
}