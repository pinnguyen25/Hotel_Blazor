    private async Task UpdateServiceQuantity(ServiceAddOnVM item, int change)
    {
        item.Quantity += change;
        if (item.Quantity < 0) item.Quantity = 0;
        await CalculatePriceAsync();
    }

    private async Task CalculatePriceAsync()
    {
        if (BookingModel.SelectedRooms == null || !BookingModel.SelectedRooms.Any()) return;

        isCalculating = true;
        StateHasChanged();
        try
        {
            // 1. Tạo DTO chuẩn bị gửi lên Server
            var calcRequest = new PriceCalculationVM
            {
                HotelId = HotelId,
                UserId = 0, // Server tự lấy từ token
                CheckInDate = BookingModel.CheckIn.ToDateTime(TimeOnly.MinValue),
                CheckOutDate = BookingModel.CheckOut.ToDateTime(TimeOnly.MinValue),
                VoucherCode = BookingModel.VoucherCode?.Trim(), // Mã hiện tại đang áp dụng

                SelectedRooms = BookingModel.SelectedRooms.Select(r => new BookingRoomDetailRequestVM
                {
                    RoomTypeId = r.RoomTypeId,
                    Quantity = r.Quantity
                }).ToList(),

                SelectedServices = AllAddOnServices.Where(s => s.Quantity > 0).Select(s => new ServiceAddOnVM
                {
                    ServiceId = s.ServiceId,
                    Quantity = s.Quantity
                }).ToList()
            };

            // 2. Gọi API
            var response = await _httpClient!.PostAsJsonAsync("hotel/booking/preview-price", calcRequest);
            if (response.IsSuccessStatusCode)
            {
                var apiRes = await response.Content.ReadFromJsonAsync<ApiResponse<PriceResultVM>>();
                if (apiRes?.StatusCode == StatusCodeResponse.Success && apiRes.Content != null)
                {
                    priceResult = apiRes.Content; // Cập nhật kết quả hiển thị
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("Lỗi tính toán: " + ex.Message);
        }
        finally
        {
            isCalculating = false;
            StateHasChanged();
        }
    }

    private async Task ApplyVoucher()
    {
        // Khi user bấm "Áp dụng", gán mã vào Model và gọi tính lại giá
        BookingModel.VoucherCode = inputVoucherCode;
        await CalculatePriceAsync();
    }

    private decimal CalculateRoomTotal()
    {
        if (BookingModel.SelectedRooms == null) return 0;
        return BookingModel.SelectedRooms.Sum(r => r.PricePerNight * r.Quantity * TotalNights);
    }

    private decimal CalculateServiceTotal()
    {
        if (AllAddOnServices == null) return 0;
        return AllAddOnServices.Sum(s => s.Price * s.Quantity);
    }

    // Hàm này để nút "ĐẶT NGAY" ở cột phải (ngoài form) kích hoạt được submit
    private async Task SubmitForm()
    {
        // Vì nút này nằm ngoài EditForm, ta cần gọi trực tiếp hàm xử lý
        // Nhưng để kích hoạt Validation, ta cần trigger EditContext (nếu muốn chuẩn chỉ)
        // Ở đây gọi thẳng HandleSubmit cho đơn giản, validation sẽ check ở server hoặc check tay nếu cần
        if (string.IsNullOrWhiteSpace(BookingModel.ContactName) || string.IsNullOrWhiteSpace(BookingModel.ContactPhone))
        {
            Snackbar.Add("Vui lòng điền đầy đủ thông tin liên hệ.", Severity.Warning);
            return;
        }
        await HandleSubmit();
    }

    private decimal TotalAmount => priceResult.FinalTotal > 0 ? priceResult.FinalTotal : (CalculateRoomTotal() +
    CalculateServiceTotal());

    private decimal DepositRequired
    {
        get
        {
            if (BookingModel.PaymentMethod == "VNPAY")
                return Math.Round(TotalAmount * 0.5m, 0); // Cọc 50%

            return 0; // Trả sau thì hiện 0 hoặc Total tùy chính sách
        }
    }

    private async Task HandleSubmit()
    {
        isSubmitting = true;
        try
        {
            // 1. Map VM -> DTO (BookingCreateDTO của Backend)
            var requestDTO = new BookingCreateVM
            {
                HotelId = HotelId,
                CheckIn = BookingModel.CheckIn, // BE dùng DateOnly
                CheckOut = BookingModel.CheckOut,
                TotalAdults = _bookingState.Adults, // THÊM nếu BE cần
                TotalChildren = _bookingState.Children,
                ContactName = BookingModel.ContactName,
                ContactEmail = BookingModel.ContactEmail,
                ContactPhone = BookingModel.ContactPhone,
                Note = BookingModel.Note,
                PaymentMethod = BookingModel.PaymentMethod,
                VoucherCode = BookingModel.VoucherCode,
                // Map Rooms
                SelectedRooms = BookingModel.SelectedRooms.Select(r => new BookingRoomDetailRequestVM
                {
                    RoomTypeId = r.RoomTypeId,
                    Quantity = r.Quantity,
                    SelectedBedTypeId = null // Tạm thời null, nếu muốn kỹ thì thêm UI chọn giường
                }).ToList(),

                // Map Services (Chỉ lấy những cái > 0)
                Services = AllAddOnServices.Where(s => s.Quantity > 0).Select(s => new ServiceAddOnVM
                {
                    ServiceId = s.ServiceId,
                    Quantity = s.Quantity
                }).ToList()
            };

            // 2. Call API
            var response = await _httpClient!.PostAsJsonAsync("hotel/booking/create", requestDTO);

            if (response.IsSuccessStatusCode)
            {
                await _bookingState.ClearAsync();
                var result = await response.Content.ReadFromJsonAsync<ApiResponse<BookingResponseVM>>();
                if (result != null && result.StatusCode == StatusCodeResponse.Success)
                {
                    await _bookingState.ClearAsync();

                    if (BookingModel.PaymentMethod == "Direct")
                    {
                        // Success -> Chuyển trang cảm ơn
                        Snackbar.Add("Đặt phòng thành công!", Severity.Success);
                        _nav.NavigateTo($"/booking/success/{result.Content!.BookingId}");
                    }
                    else if (BookingModel.PaymentMethod == "VNPAY")
                    {
                        // Logic VNPAY: Gọi API lấy link
                        decimal amountToPay = result.Content?.DepositAmount > 0 ? result.Content.DepositAmount : DepositRequired;
                        var payRes = await _httpClient!.PostAsJsonAsync("payment/create-url", new
                        {
                            BookingId = result.Content?.BookingId,
                            Amount = amountToPay,
                            Method = "VNPAY"
                        });

                        if (payRes.IsSuccessStatusCode)
                        {
                            var url = await payRes.Content.ReadAsStringAsync();
                            _nav.NavigateTo(url, forceLoad: true); // Chuyển trang sang VNPAY
                        }
                        else
                        {
                            Snackbar.Add("Lỗi tạo link thanh toán VNPAY", Severity.Error);
                        }
                    }
                }
                else
                {
                    Snackbar.Add(result?.Message ?? "Đặt phòng thất bại", Severity.Error);
                }
            }
            else
            {
                // Đọc lỗi từ BE trả về (ví dụ hết phòng)
                var errorBody = await response.Content.ReadAsStringAsync();
                try
                {
                    var apiError = JsonSerializer.Deserialize<ApiResponse<object>>(errorBody, new JsonSerializerOptions
                    {
                        PropertyNameCaseInsensitive = true
                    });
                    if (apiError != null && !string.IsNullOrEmpty(apiError.Message))
                    {
                        ShowError(apiError.Message);
                    }
                    else
                    {
                        ShowError(errorBody); // Fallback text thô
                    }
                }
                catch
                {
                    // Nếu không phải JSON, hiển thị text thô (thường là lỗi 500 hoặc 400 string)
                    // Backend của bạn throw Exception: "Rất tiếc, loại phòng... không đủ..."
                    // Nó sẽ rơi vào đây.
                    ShowError(errorBody);
                }
            }
        }
        catch (Exception ex)
        {
            ShowError($"Lỗi hệ thống: {ex.Message}");
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private void ShowError(string message)
    {
        // Làm sạch thông báo lỗi nếu cần (ví dụ bỏ bớt ký tự lạ)
        ErrorMessage = message.Replace("\"", "").Trim();

        // Hiện Snackbar cho lỗi nhẹ
        Snackbar.Add(ErrorMessage, Severity.Error);

        // Hiện Modal cho lỗi nghiêm trọng để chặn user spam nút click
        IsErrorModalVisible = true;
        StateHasChanged();
    }

    private int GetIncludedCount(string serviceName)
    {
        int count = 0;
        foreach (var room in BookingModel.SelectedRooms)
        {
            if (room.IncludedServiceNames != null &&
            room.IncludedServiceNames.Any(inc => inc.Equals(serviceName, StringComparison.OrdinalIgnoreCase)))
            {
                count += room.Quantity;
            }
        }
        return count;
    }

