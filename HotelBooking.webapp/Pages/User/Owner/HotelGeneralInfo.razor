@* @page "/owner/hotels/{HotelId:int}/general"
@layout OwnerLayout
@using Blazored.LocalStorage
@using HotelBooking.webapp.ViewModels.Hotel
@using System.Net.Http.Headers
@inject IHttpClientFactory _httpClientFactory
@inject ISnackbar Snackbar
@inject ILocalStorageService _localStorage

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div class="d-flex align-items-center">
            <a href="/owner/hotels" class="btn btn-light btn-sm me-3 text-muted shadow-sm border">
                <i class="bi bi-arrow-left fs-5"></i>
            </a>
            <div>
                <h3 class="fw-bold mb-0 text-dark">Thông tin & Hình ảnh</h3>
                <small class="text-muted">Chỉnh sửa thông tin cơ bản của khách sạn</small>
            </div>
        </div>
        @if (!IsLoading)
        {
             <div class="badge @GetStatusColor(CurrentStatus) p-2 fs-6">@CurrentStatus</div>
        }
    </div>

    @if (IsLoading)
    {
        <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
    }
    else
    {
        <div class="row">
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header bg-white py-3">
                        <h6 class="fw-bold mb-0">Thông tin chung</h6>
                    </div>
                    <div class="card-body">
                        <EditForm Model="HotelModel" OnValidSubmit="HandleSubmit">
                            <DataAnnotationsValidator />
                            
                            <div class="row g-3">
                                <div class="col-12">
                                    <label class="form-label fw-bold">Tên khách sạn <span class="text-danger">*</span></label>
                                    <InputText class="form-control" @bind-Value="HotelModel.Name" />
                                    <ValidationMessage For="@(() => HotelModel.Name)" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-bold">Thành phố</label>
                                    <InputSelect class="form-select" @bind-Value="HotelModel.CityId">
                                        <option value="0">-- Chọn thành phố --</option>
                                        @foreach (var city in Cities)
                                        {
                                            <option value="@city.Id">@city.Name</option>
                                        }
                                    </InputSelect>
                                    <ValidationMessage For="@(() => HotelModel.CityId)" />
                                </div>
                                <div class="col-md-12">
                                    <label class="form-label fw-bold">Địa chỉ</label>
                                    <InputText class="form-control" @bind-Value="HotelModel.Address" />
                                    <ValidationMessage For="@(() => HotelModel.Address)" />
                                </div>
                                <div class="col-12">
                                    <label class="form-label fw-bold">Mô tả</label>
                                    <InputTextArea class="form-control" rows="4" @bind-Value="HotelModel.Description" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-bold">Người liên hệ</label>
                                    <InputText class="form-control" @bind-Value="HotelModel.ContactName" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-bold">SĐT liên hệ</label>
                                    <InputText class="form-control" @bind-Value="HotelModel.ContactPhone" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-bold">Email liên hệ</label>
                                    <InputText class="form-control" @bind-Value="HotelModel.ContactEmail" />
                                    <ValidationMessage For="@(() => HotelModel.ContactEmail)" />
                                </div>
                            </div>

                            <div class="mt-4 text-end">
                                <button type="submit" class="btn btn-primary px-4 fw-bold" disabled="@IsSaving">
                                    @(IsSaving ? "Đang lưu..." : "Lưu thay đổi")
                                </button>
                            </div>

                            @if (ShowPendingAlert)
                            {
                                <div class="alert alert-warning mt-3 mb-0 small">
                                    <i class="bi bi-exclamation-triangle-fill me-1"></i>
                                    Khách sạn đang hoạt động. Thay đổi sẽ cần Admin duyệt trước khi áp dụng.
                                </div>
                            }
                        </EditForm>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white py-3">
                        <h6 class="fw-bold mb-0">Hình ảnh</h6>
                    </div>
                    <div class="card-body text-center">
                         <div class="mb-3">
                            <label class="form-label fw-bold d-block text-start small text-muted">Ảnh bìa</label>
                            <div class="position-relative border rounded overflow-hidden" style="height: 200px;">
                                @if (!string.IsNullOrEmpty(Images.CoverImageUrl))
                                {
                                    <img src="@Images.CoverImageUrl" class="w-100 h-100 object-fit-cover" />
                                }
                                else
                                {
                                    <div class="d-flex align-items-center justify-content-center h-100 bg-light text-muted">Chưa có ảnh</div>
                                }
                            </div>
                            <InputFile OnChange="UploadCover" class="form-control mt-2" accept=".jpg,.png,.jpeg" />
                        </div>
                        <hr/>
                        <div class="text-start">
                             <label class="form-label fw-bold small text-muted">Ảnh phụ (@Images.GalleryImageUrls.Count / 4)</label>
                             <div class="row g-2">
                                 @foreach (var img in Images.GalleryImageUrls)
                                 {
                                     <div class="col-6 position-relative">
                                         <img src="@img" class="img-thumbnail w-100" style="height: 80px; object-fit: cover;" />
                                         <button class="btn btn-danger btn-sm position-absolute top-0 end-0 m-1 p-0 px-1" 
                                                 @onclick="() => DeleteImage(img)"><i class="bi bi-x"></i></button>
                                     </div>
                                 }
                             </div>
                             @if(Images.GalleryImageUrls.Count < 4)
                             {
                                 <InputFile OnChange="UploadGallery" class="form-control mt-2" accept=".jpg,.png,.jpeg" />
                             }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public int HotelId { get; set; }
    
    // TÁI SỬ DỤNG VM CỦA BẠN TẠI ĐÂY
    private HotelCreateOrUpdateVM HotelModel = new();
    private HotelImagesVM Images = new();
    
    private List<CityVM> Cities = new();
    private bool IsLoading = true;
    private bool IsSaving = false;
    private string CurrentStatus = "";
    private bool ShowPendingAlert => CurrentStatus == "Active" || CurrentStatus == "PendingVerification";
    private HttpClient? _httpClient;

    protected override async Task OnInitializedAsync()
    {
        _httpClient = _httpClientFactory.CreateClient("HotelBookingAPI");
        var token = await _localStorage.GetItemAsync<string>("accessToken");
        if (!string.IsNullOrEmpty(token)) _httpClient.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);

        await LoadCities();
        await LoadData();
    }

    private async Task LoadData()
    {
        IsLoading = true;
        try
        {
            // Gọi API, hứng bằng class trung gian HotelDetailForOwnerResponse
            var res = await _httpClient!.GetFromJsonAsync<ApiResponse<HotelDetailVM>>($"hotel/owner/hotel-detail/{HotelId}");
            
            if (res?.StatusCode == StatusCodeResponse.Success && res.Content != null)
            {
                var info = res.Content.HotelInfo;
                var imgs = res.Content.ImageUrls;
                CurrentStatus = info.Status;

                // === MAPPING: CHUYỂN DỮ LIỆU API -> VM CỦA BẠN ===
                HotelModel = new HotelCreateOrUpdateVM
                {
                    HotelId = info.HotelId,
                    Name = info.HotelName,
                    Address = info.Address,
                    Description = info.Description,
                    ContactName = info.ContactName,
                    ContactPhone = info.ContactPhone,
                    ContactEmail = info.ContactEmail,
                    AccommodationTypeId = info.AccommodationTypeId,
                    ChainId = info.ChainId,
                    
                    // Map CityId bằng tên (vì API Detail trả về tên)
                    CityId = Cities.FirstOrDefault(c => c.Name == info.CityName)?.Id ?? 0 
                };

                Images = new HotelImagesVM
                {
                    CoverImageUrl = info.CoverImageUrl,
                    GalleryImageUrls = imgs.GalleryImageUrls ?? new List<string>()
                };
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Lỗi tải dữ liệu: {ex.Message}", Severity.Error);
        }
        finally { IsLoading = false; }
    }
    
    private async Task LoadCities()
    {
         var res = await _httpClient!.GetAsync("hotel/get-cityName");
         if (res.IsSuccessStatusCode)
             Cities = await res.Content.ReadFromJsonAsync<List<CityVM>>() ?? new();
    }

    private async Task HandleSubmit()
    {
        IsSaving = true;
        try
        {
            // Gửi chính cái HotelCreateOrUpdateVM lên
            var res = await _httpClient!.PutAsJsonAsync($"hotel/owner/update-hotel/{HotelId}", HotelModel);
            
            // Backend trả về message, ta dùng dynamic hoặc tạo class response nhỏ
            var content = await res.Content.ReadFromJsonAsync<ApiResponse<dynamic>>();

            if (res.IsSuccessStatusCode && content?.StatusCode == StatusCodeResponse.Success)
            {
                Snackbar.Add(content.Message, Severity.Success);
                // Nếu BE trả về status mới thì update lại (cần parse dynamic kỹ hơn hoặc tạo class response)
            }
            else
            {
                Snackbar.Add(content?.Message ?? "Lỗi cập nhật", Severity.Error);
            }
        }
        catch (Exception ex) { Snackbar.Add($"Lỗi: {ex.Message}", Severity.Error); }
        finally { IsSaving = false; }
    }

    // Logic Upload/Delete ảnh bạn tự điền vào như bài trước nhé (Post Multipart)
     private async Task UploadCover(InputFileChangeEventArgs e) 
     { 
         // ... Code upload cover ...
     }
     private async Task UploadGallery(InputFileChangeEventArgs e) { /*...*/ }
     private async Task DeleteImage(string url) { /*...*/ }

    private string GetStatusColor(string status) => status switch
    {
        "Active" => "bg-success",
        "PendingVerification" => "bg-warning text-dark",
        "Draft" => "bg-secondary",
        "Rejected" => "bg-danger",
        _ => "bg-light text-dark"
    };
} *@