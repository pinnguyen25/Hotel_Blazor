@inject HotelFormState FormState
@inject ISnackbar Snackbar

<MudGrid Spacing="8" Class="mt-2">

    <MudItem xs="12" md="8">
        <MudText Typo="Typo.h6" Class="mb-4 text-muted">Thông tin chung</MudText>

        <MudTextField @bind-Value="FormState.BasicInfo.Name" Label="Tên khách sạn" Required="true"
            RequiredError="Tên khách sạn không được để trống!" Class="mb-5" Immediate="true"
            TextChanged="@(() => FormState.Notify())" />

        <MudGrid Spacing="4">
            <MudItem xs="12" sm="6">
                <MudSelect T="int?" Label="Thành phố"
                    Value="@(FormState.BasicInfo.CityId == 0 ? null : FormState.BasicInfo.CityId)"
                    ValueChanged="@(val => OnCityChanged(val ?? 0))" Required="true" Class="mb-5" Clearable="true">
                    @if (!FormState.Cities.Any())
                    {
                        <MudSelectItem T="int?" Value="@((int?)null)" Disabled="true">Đang tải...</MudSelectItem>
                    }
                    else
                    {
                        @foreach (var city in FormState.Cities)
                        {
                            <MudSelectItem T="int?" Value="@((int?)city.Id)">@city.Name</MudSelectItem>
                        }
                    }
                </MudSelect>
            </MudItem>

            <MudItem xs="12" sm="6">
                <MudSelect T="int?" Label="Loại hình lưu trú" Value="FormState.BasicInfo.AccommodationTypeId"
                    RequiredError="Địa chỉ không được để trống!" ValueChanged="@(val => OnTypeChanged(val))"
                    Clearable="true" Class="mb-5">
                    @foreach (var item in FormState.AccommodationTypes)
                    {
                        <MudSelectItem T="int?" Value="@item.Id">@item.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
        </MudGrid>

        <MudTextField @bind-Value="FormState.BasicInfo.Address" Label="Địa chỉ chi tiết" Required="true"
            RequiredError="Địa chỉ không được để trống!" Class="mb-5" Immediate="true"
            TextChanged="@(() => FormState.Notify())" />

        <MudTextField @bind-Value="FormState.BasicInfo.Description" Label="Mô tả khách sạn (tối đa 1000 ký tự)"
            Lines="5" Class="mb-4" Immediate="true" TextChanged="@(() => FormState.Notify())" />
    </MudItem>

    <MudItem xs="12" md="4">
        <MudText Typo="Typo.h6" Class="mb-4 text-muted">Thông tin liên hệ</MudText>

        <div class="d-flex flex-column gap-4">
            <MudTextField @bind-Value="FormState.BasicInfo.ContactName" Label="Tên người liên hệ" Immediate="true"
                TextChanged="@(() => FormState.Notify())" />

            <MudTextField @bind-Value="FormState.BasicInfo.ContactPhone" Label="Số điện thoại *" Required="true"
                RequiredError="Vui lòng nhập số điện thoại" Immediate="true"
                TextChanged="@(() => FormState.Notify())" />

            <MudTextField @bind-Value="FormState.BasicInfo.ContactEmail" Label="Email" Immediate="true"
                TextChanged="@(() => FormState.Notify())" />
        </div>
    </MudItem>
</MudGrid>

@code
{
    private void OnCityChanged(int cityId)
    {
        FormState.BasicInfo.CityId = cityId;
        FormState.Notify();
    }

    private void OnTypeChanged(int? typeId)
    {
        FormState.BasicInfo.AccommodationTypeId = typeId;
        FormState.Notify();
    }
}