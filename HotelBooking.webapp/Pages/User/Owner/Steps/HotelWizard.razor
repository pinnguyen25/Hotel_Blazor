@page "/owner/hotel-wizard"
@page "/owner/hotel-wizard/{hotelId:int}"
@layout OwnerLayout
@using Blazored.LocalStorage
@using HotelBooking.webapp.Pages.User.Owner.Steps
@using MudBlazor
@using System.Net.Http.Headers
@inject HotelFormState FormState
@inject NavigationManager _nav
@inject IHttpClientFactory _httpClientFactory
@inject ILocalStorageService _localStorage
@inject ISnackbar Snackbar

<MudPaper Class="pa-8 my-8" Elevation="10" Style="max-width:1100px;margin:auto;border-radius:16px;">
    <MudText Typo="Typo.h4" Class="mb-6 text-center" Color="Color.Primary">
        @(FormState.BasicInfo.HotelId > 0 ? $"Cập nhật: {FormState.BasicInfo.Name}" : "Đăng ký khách sạn mới")
    </MudText>

    <MudStepper @bind-ActiveStepIndex="@ActiveStep" Linear="false" Class="mb-6" AlternativeLabel="true">
        <ChildContent>
            <MudStep Title="Thông tin cơ bản" Completed="@(ActiveStep > 0)" />
            <MudStep Title="Ảnh khách sạn" Completed="@(ActiveStep > 1)" />
            <MudStep Title="Tiện ích" Completed="@(ActiveStep > 2)" />
            <MudStep Title="Dịch vụ" Completed="@(ActiveStep > 3)" />
            <MudStep Title="Chính sách" Completed="@(ActiveStep > 4)" />
            <MudStep Title="Loại phòng" Completed="@(ActiveStep > 5)" />
        </ChildContent>
        <ActionContent>
            @* ĐỂ TRỐNG ĐỂ ẨN NÚT MẶC ĐỊNH *@
        </ActionContent>
    </MudStepper>

    <!-- Nội dung từng bước -->
    <div class="my-6">
        @if (IsGlobalLoading)
        {
            <div class="d-flex justify-center my-12">
                <MudProgressCircular Indeterminate="true" Size="Size.Large" />
                <MudText Class="ml-4">Đang tải dữ liệu...</MudText>
            </div>
            @* <div class="d-flex justify-center align-center h-100">
                <MudProgressCircular Indeterminate="true" Size="Size.Large" Color="Color.Primary"/>
            </div> *@
        }
        else
        {
            @switch (ActiveStep)
            {
                case 0:
                    <StepBasicInfo />
                    break;
                case 1:
                    <StepImages />
                    break;
                case 2:
                    <StepAmenities />
                    break;
                case 3:
                    <StepServices />
                    break;
                case 4:
                    <StepPolicies />
                    break;
                case 5:
                    <StepRoomTypes IsLoadingRoomTypes="IsLoadingRoomTypes" OnRoomTypeChanged="LoadRoomTypesAsync" />
                    break;
            }
        }
    </div>
    <MudDivider Class="my-6" />
    <!-- Nút điều hướng chung -->
    <div class="d-flex justify-space-between mt-10">
        <MudButton OnClick="PrevStep" Disabled="@(ActiveStep == 0)" StartIcon="@Icons.Material.Filled.ArrowBack"
            Size="Size.Large">
            Quay lại
        </MudButton>

        <div>
            @if (ActiveStep < 5)
            {
                <MudButton Variant="MudBlazor.Variant.Filled" Color="Color.Primary" OnClick="NextStep" Disabled="@IsNextDisabled"
                    EndIcon="@Icons.Material.Filled.ArrowForward">
                    Tiếp tục
                </MudButton>
            }
            else
            {
                <MudButton Variant="MudBlazor.Variant.Filled" Color="Color.Success" OnClick="SubmitForReview"
                    Disabled="@(IsSubmitting || FormState.RoomTypes.Count == 0)"
                    StartIcon="@(IsSubmitting ? Icons.Material.Filled.Loop : Icons.Material.Filled.Check)">
                    @(IsSubmitting ? "Đang xử lý..." : "Hoàn tất & Gửi duyệt")
                </MudButton>
            }
        </div>
    </div>
</MudPaper>

@code {
    [Parameter] public int? hotelId { get; set; }
    private int ActiveStep = 0;
    private bool IsSubmitting = false;
    private bool IsGlobalLoading = true;
    private bool IsLoadingRoomTypes = false;
    private HttpClient? _httpClient;

    // kiểm tra validation
    private bool IsNextDisabled => ActiveStep switch
    {
        0 => !FormState.BasicInfoIsValid,
        1 => !FormState.ImagesIsValid,
        2 => FormState.SelectedAmenityIds.Count == 0,
        3 => false,
        4 => FormState.SelectedPolicyByType.Count == 0 && FormState.CustomPolicies.Count == 0,
        _ => false
    };

    protected override async Task OnInitializedAsync()
    {
        _httpClient = _httpClientFactory.CreateClient("HotelBookingAPI");

        FormState.OnChange += StateHasChanged;

        // load data
        await FormState.LoadFromStorageAsync();
        await Task.WhenAll(
        FormState.LoadCitiesAsync(),
        FormState.LoadAmenitiesAsync(),
        FormState.LoadPoliciesAsync(),
        FormState.LoadAccommodationTypesAsync()
        );

        // Logic khôi phục step
        if (FormState.IsDraftCreated)
        {
            if (FormState.BasicInfoIsValid) ActiveStep = 1;
            if (ActiveStep == 1 && FormState.ImagesIsValid) ActiveStep = 2;
            if (ActiveStep == 2 && FormState.SelectedAmenityIds.Any()) ActiveStep = 3;
            if (ActiveStep == 3 && (FormState.SelectedPolicyByType.Any() || FormState.CustomPolicies.Any()))
            {
                ActiveStep = 4;
                await LoadRoomTypesAsync(); // Load luôn nếu đang ở step cuối
            }
        }

        IsGlobalLoading = false;
    }

    private void PrevStep()
    {
        if (ActiveStep > 0) ActiveStep--;
    }

    private async Task NextStep()
    {
        if (IsNextDisabled) return;
        IsSubmitting = true;
        // Bước 0: Tạo draft
        try
        {
            switch (ActiveStep)
            {
                case 0: // Step Basic Info
                    if (!FormState.IsDraftCreated)
                    {
                        // Chưa có ID -> Gọi TẠO MỚI
                        var created = await FormState.CreateDraftAsync();
                        if (!created) { IsSubmitting = false; return; }
                    }
                    else
                    {
                        // Đã có ID (do load draft) -> Gọi CẬP NHẬT
                        await FormState.UpdateBasicInfoAsync();
                    }
                    break;

                case 1: // Step Images
                    break;

                case 2: // Step Amenities
                    await FormState.SaveAmenitiesAsync();
                    break;
                case 3: // Step Service
                    break;
                case 4: // Step Policies
                    await FormState.SavePoliciesAsync();
                    break;
            }

            ActiveStep++;

            if (ActiveStep == 5)
            {
                await LoadRoomTypesAsync();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Lỗi: {ex.Message}", Severity.Error);
        }
        finally
        {
            IsSubmitting = false;
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        // Tạo mới (URL không có ID)
        if (!hotelId.HasValue)
        {
            // Nếu trước đó đang sửa hotel nào đó, phải clear đi để tạo mới
            if (FormState.DraftHotelId > 0)
            {
                await FormState.ClearDraftAsync();
                ActiveStep = 0;
            }
        }
        // Sửa Draft (URL có ID)
        else
        {
            // Nếu State hiện tại KHÁC với ID trên URL -> Phải load lại từ API
            if (FormState.DraftHotelId != hotelId.Value)
            {
                IsGlobalLoading = true; // Hiện loading
                StateHasChanged();
                // Gọi hàm load draft từ API (Hàm này bạn đã viết trong FormState)
                var success = await FormState.LoadDraftAsync(hotelId.Value);

                if (!success)
                {
                    Snackbar.Add("Không tìm thấy bản nháp hoặc bạn không có quyền truy cập.", Severity.Error);
                    _nav.NavigateTo("/owner/hotels");
                    return;
                }

                // Tự động nhảy đến bước phù hợp dựa trên dữ liệu vừa load
                DetermineActiveStep();

                IsGlobalLoading = false;
            }
        }
    }

    private void DetermineActiveStep()
    {
        ActiveStep = 0;
        if (FormState.BasicInfoIsValid) ActiveStep = 1;
        if (ActiveStep == 1 && FormState.ImagesIsValid) ActiveStep = 2;
        if (ActiveStep == 2 && FormState.SelectedAmenityIds.Any()) ActiveStep = 3;
        if (ActiveStep == 3) ActiveStep = 4;
        if (ActiveStep == 4 && (FormState.SelectedPolicyByType.Any() || FormState.CustomPolicies.Any()))
        {
            ActiveStep = 5;
        }

        // Nếu đang ở bước cuối, nhớ load RoomTypes
        if (ActiveStep == 5)
        {
            _ = LoadRoomTypesAsync(); // Gọi không cần await để UI render trước
        }
    }
    // Gọi khi state thay đổi → cập nhật UI realtime
    private void OnFormStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private async Task LoadRoomTypesAsync()
    {
        IsLoadingRoomTypes = true;
        await FormState.LoadRoomTypesAsync();
        IsLoadingRoomTypes = false;
    }

    private async Task SetAuthHeader()
    {
        var token = await _localStorage.GetItemAsync<string>("accessToken");
        if (!string.IsNullOrEmpty(token))
            _httpClient!.DefaultRequestHeaders.Authorization = new("Bearer", token);
    }

    private async Task SubmitForReview()
    {
        if (FormState.RoomTypes.Count == 0)
        {
            Snackbar.Add("Vui lòng thêm ít nhất 1 loại phòng trước khi gửi duyệt!", Severity.Warning);
            return;
        }

        if (FormState.SelectedPolicyByType.Any() || FormState.CustomPolicies.Any())
        {
            await FormState.SavePoliciesAsync(); // Ép lưu xuống DB ngay lập tức
        }
        else
        {
            // Nếu RAM trống trơn -> Bắt quay lại nhập
            Snackbar.Add("Vui lòng nhập Giờ nhận/trả phòng!", Severity.Warning);
            ActiveStep = 4;
            return;
        }
        IsSubmitting = true;
        StateHasChanged();

        try
        {
            await Task.WhenAll(
            FormState.SaveAmenitiesAsync(), // Lưu lại tiện ích
            FormState.SavePoliciesAsync() // Lưu lại chính sách
            );

            // Gọi API Submit
            var success = await FormState.SubmitForReviewAsync();

            if (success)
            {
                Snackbar.Add("Gửi duyệt thành công! Chúng tôi sẽ phản hồi trong 24h.", Severity.Success);

                // Dọn dẹp LocalStorage
                await _localStorage.RemoveItemAsync("WizardActiveStep");
                await FormState.ClearDraftAsync();

                // Chuyển trang
                _nav.NavigateTo("/owner/hotels");
            }
            // (Nếu lỗi thì FormState đã hiển thị Snackbar ở hàm SubmitForReviewAsync rồi)
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Lỗi hệ thống: {ex.Message}", Severity.Error);
        }
        finally
        {
            IsSubmitting = false;
        }
    }

    public void Dispose()
    {
        FormState.OnChange -= StateHasChanged;
    }

}