@inject HotelFormState FormState
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@using MudBlazor
@using Microsoft.AspNetCore.Components.Forms

<MudText Typo="Typo.h6" Class="mb-4">Hình ảnh khách sạn</MudText>

<MudGrid>
    <MudItem xs="12" md="5">
        <MudPaper Class="pa-4" Elevation="3">
            <MudText Typo="Typo.subtitle1" Class="mb-2 fw-bold">Ảnh bìa (Cover)</MudText>
            
            <div class="d-flex flex-column align-center justify-center border-2 border-dashed pa-4 rounded" 
                 style="height: 300px; background-color: #f5f5f5; position: relative;">
                
                @if (!string.IsNullOrEmpty(FormState.Images.CoverImageUrl))
                {
                    <MudImage Src="@FormState.Images.CoverImageUrl" ObjectFit="ObjectFit.Cover" 
                              Style="width: 100%; height: 100%; border-radius: 8px;" />
                              
                    <div class="position-absolute top-0 right-0 ma-2">
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Variant="MudBlazor.Variant.Filled" 
                                       OnClick="@(() => DeleteImage(FormState.Images.CoverImageUrl, true))" />
                    </div>
                }
                else
                {
                    <MudIcon Icon="@Icons.Material.Filled.Image" Size="Size.Large" Color="Color.Default" />
                    <MudText Typo="Typo.caption" Class="mt-2">Chưa có ảnh bìa</MudText>
                }
            </div>

            <MudFileUpload T="IBrowserFile" FilesChanged="UploadCover" Accept=".jpg, .jpeg, .png" Class="mt-3">
                <ActivatorContent>
                    <MudButton Variant="MudBlazor.Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.CloudUpload" FullWidth="true">
                        @(string.IsNullOrEmpty(FormState.Images.CoverImageUrl) ? "Tải ảnh bìa" : "Thay ảnh bìa")
                    </MudButton>
                </ActivatorContent>
            </MudFileUpload>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="7">
        <MudPaper Class="pa-4" Elevation="3" Style="height: 100%;">
            <div class="d-flex justify-space-between align-center mb-2">
                <MudText Typo="Typo.subtitle1" Class="fw-bold">Ảnh phụ (Gallery)</MudText>
                <MudText Typo="Typo.caption">@FormState.Images.GalleryImageUrls.Count / 4 ảnh</MudText>
            </div>

            <div class="d-flex flex-wrap gap-3 mb-3">
                @foreach (var url in FormState.Images.GalleryImageUrls)
                {
                    <div class="position-relative" style="width: 120px; height: 90px;">
                        <MudImage Src="@url" ObjectFit="ObjectFit.Cover" Width="120" Height="90" Class="rounded border" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" 
                                       Class="position-absolute top-0 right-0 ma-1 bg-white"
                                       OnClick="@(() => DeleteImage(url, false))" />
                    </div>
                }
                
                @if (FormState.Images.GalleryImageUrls.Count < 4)
                {
                    <div class="d-flex align-center justify-center border-2 border-dashed rounded" 
                         style="width: 120px; height: 90px; background-color: #fafafa;">
                        <MudIcon Icon="@Icons.Material.Filled.AddPhotoAlternate" Color="Color.Default" />
                    </div>
                }
            </div>

            <MudFileUpload T="IReadOnlyList<IBrowserFile>" FilesChanged="UploadGallery" Accept=".jpg, .jpeg, .png" MaximumFileCount="4">
                <ActivatorContent>
                    <MudButton Variant="MudBlazor.Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.AddAPhoto" 
                               Disabled="@(FormState.Images.GalleryImageUrls.Count >= 4)">
                        Thêm ảnh phụ
                    </MudButton>
                </ActivatorContent>
            </MudFileUpload>
        </MudPaper>
    </MudItem>
</MudGrid>

@if (IsUploading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mt-4" />
}

@code {
    private bool IsUploading = false;

    private async Task UploadCover(IBrowserFile file)
    {
        if (file == null) return;
        IsUploading = true;
        await FormState.UploadCoverAsync(file);
        IsUploading = false;
    }

    private async Task UploadGallery(IReadOnlyList<IBrowserFile> files)
    {
        if (files == null || !files.Any()) return;
        IsUploading = true;
        foreach (var file in files)
        {
            if (FormState.Images.GalleryImageUrls.Count >= 4) break;
            await FormState.UploadGalleryAsync(file);
        }
        IsUploading = false;
    }

    private async Task DeleteImage(string url, bool isCover)
    {
        await FormState.DeleteImageAsync(url);
        // State sẽ tự cập nhật UI thông qua Notify() trong FormState
    }

}