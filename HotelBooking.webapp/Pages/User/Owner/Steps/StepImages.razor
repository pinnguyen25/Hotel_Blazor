@inject HotelFormState FormState
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@using MudBlazor
@using Microsoft.AspNetCore.Components.Forms

<MudForm Class="pa-6" Elevation="6" Style="border-radius:16px; border: 2px dashed #1976d2; background: rgba(25,118,210,0.04);">

    @if (IsUploading)
    {
        <MudProgressLinear Indeterminate="true" Class="mt-6 rounded-xl" Color="Color.Primary" />
        <MudText Class="text-center mt-2">Đang xử lý...</MudText>
    }

    <MudGrid Spacing="4" Class="mt-4">
        @if (FormState.Images.TotalImages == 0)
        {
            <!-- Trường hợp chưa có ảnh nào → vẫn giữ ô lớn + 4 ô nhỏ -->
            <MudItem xs="12" md="7">
                <label class="h-96 rounded-xl border-4 border-dashed border-primary/40 bg-primary/5 cursor-pointer flex items-center justify-center hover:bg-primary/10 transition-all block">
                    <InputFile OnChange="e => AddNewFile(e, true)" accept="image/*" class="absolute inset-0 opacity-0 cursor-pointer" />
                    <div class="text-center">
                        <MudIcon Icon="@Icons.Material.Filled.AddPhotoAlternate" Size="Size.Large" Color="Color.Primary" />
                        <MudText Typo="Typo.h6" Class="mt-3">Thêm ảnh bìa</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">Ảnh đầu tiên sẽ tự động làm bìa</MudText>
                    </div>
                </label>
            </MudItem>

            <MudItem xs="12" md="5">
                <MudGrid Spacing="4">
                    @for (int i = 0; i < 4; i++)
                    {
                        <MudItem xs="6">
                            <div class="h-48 rounded-xl border-4 border-dashed border-gray bg-gray/5 flex items-center justify-center">
                                <MudIcon Icon="@Icons.Material.Filled.AddAPhoto" Size="Size.Large" Color="Color.Default" />
                            </div>
                        </MudItem>
                    }
                </MudGrid>
            </MudItem>
        }
        else
        {
            <!-- Có ít nhất 1 ảnh → layout chuẩn: bìa lớn trái + 4 ô phải (2x2) -->
            <MudItem xs="12" lg="6">
                <!-- Ảnh bìa lớn -->
                @if (FormState.Images.CoverImageUrl != null)
                {
                    <label class="relative rounded-xl overflow-hidden shadow-2xl group cursor-pointer block h-96">
                        <InputFile OnChange="e => ReplaceFile(e, true)" accept="image/*" class="absolute inset-0 opacity-0 cursor-pointer z-10" />
                        <img src="@FormState.Images.CoverImageUrl" class="w-100 h-full object-cover" />
                        <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-all flex items-center justify-center pointer-events-none">
                            <MudIcon Icon="@Icons.Material.Filled.CameraAlt" Size="Size.Large" Color="Color.Surface" />
                        </div>
                        <MudChip T="string" Color="Color.Primary" Class="absolute top-3 left-3 z-20">Bìa</MudChip>
                        <MudFab Color="Color.Error" Size="Size.Small"
                                Class="absolute top-3 right-3 opacity-0 group-hover:opacity-100 transition-all z-20"
                                Icon="@Icons.Material.Filled.Delete"
                                OnClick="() => ConfirmDelete(FormState.Images.CoverImageUrl!, true)"
                                OnClick:stopPropagation />
                    </label>
                }
                else if (FormState.Images.TotalImages < 5)
                {
                    <label class="h-96 rounded-xl border-4 border-dashed border-primary/40 bg-primary/5 cursor-pointer flex items-center justify-center hover:bg-primary/10 transition-all block">
                        <InputFile OnChange="e => AddNewFile(e, true)" accept="image/*" class="absolute inset-0 opacity-0 cursor-pointer" />
                        <div class="text-center">
                            <MudIcon Icon="@Icons.Material.Filled.AddPhotoAlternate" Size="Size.Large" Color="Color.Primary" />
                            <MudText Typo="Typo.h6" Class="mt-3">Thêm ảnh bìa</MudText>
                        </div>
                    </label>
                }
            </MudItem>

            <!-- 4 ảnh phụ bên phải – luôn 2x2, không bị tràn -->
            <MudItem xs="12" lg="6">
                <MudGrid Spacing="4">
                    @for (int i = 0; i < 4; i++)
                    {
                        var url = i < FormState.Images.GalleryImageUrls.Count ? FormState.Images.GalleryImageUrls[i] : null;

                        <MudItem xs="6">
                            @if (url != null)
                            {
                                <label class="relative rounded-xl overflow-hidden shadow-lg group cursor-pointer block h-56">
                                    <InputFile OnChange="e => ReplaceFile(e, false, url)" accept="image/*" class="absolute inset-0 opacity-0 cursor-pointer z-10" />
                                    <img src="@url" class="w-100 h-full object-cover" />
                                    <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-all flex items-center justify-center pointer-events-none">
                                        <MudIcon Icon="@Icons.Material.Filled.CameraAlt" Size="Size.Large" Color="Color.Surface" />
                                    </div>
                                    <MudFab Color="Color.Error" Size="Size.Small"
                                            Class="absolute top-2 right-2 opacity-0 group-hover:opacity-100 transition-all z-20"
                                            Icon="@Icons.Material.Filled.Delete"
                                            OnClick="() => ConfirmDelete(url, false)"
                                            OnClick:stopPropagation />
                                </label>
                            }
                            else if (FormState.Images.TotalImages < 5)
                            {
                                <label class="h-56 rounded-xl border-4 border-dashed border-gray bg-gray/5 cursor-pointer flex items-center justify-center hover:bg-gray/10 transition-all block">
                                    <InputFile OnChange="e => AddNewFile(e, false)" accept="image/*" class="absolute inset-0 opacity-0 cursor-pointer" />
                                    <MudIcon Icon="@Icons.Material.Filled.AddAPhoto" Size="Size.Large" Color="Color.Default" />
                                </label>
                            }
                        </MudItem>
                    }
                </MudGrid>
            </MudItem>
        }
    </MudGrid>

    @if (FormState.Images.IsComplete)
    {
        <MudAlert Severity="Severity.Success" Dense="true" Class="mt-6 rounded-lg">
            Đã đủ 5 ảnh – Sẵn sàng tiếp tục
        </MudAlert>
    }
    else
    {
        <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-6 rounded-lg">
            Cần thêm @(5 - FormState.Images.TotalImages) ảnh
        </MudAlert>
    }
</MudForm>

@code {
    private bool IsUploading = false;

    private async Task ReplaceFile(InputFileChangeEventArgs e, bool isCover, string? oldUrl = null)
    {
        var file = e.File;
        if (file == null || file.Size > 10 * 1024 * 1024) {
            Snackbar.Add("Ảnh quá lớn (tối đa 10MB)", Severity.Error); return;
        }

        IsUploading = true; StateHasChanged();

        bool success = isCover 
            ? await FormState.UploadCoverAsync(file)
            : await FormState.UploadGalleryAsync(file);

        if (success && oldUrl != null)
            _ = FormState.DeleteImageAsync(oldUrl);

        if (success) await FormState.SyncImagesFromServerAsync();
        IsUploading = false;
    }

    private async Task AddNewFile(InputFileChangeEventArgs e, bool isCover)
    {
        var file = e.File;
        if (file == null || file.Size > 10 * 1024 * 1024) {
            Snackbar.Add("Ảnh quá lớn (tối đa 10MB)", Severity.Error); return;
        }

        if (FormState.Images.TotalImages >= 5) return;

        IsUploading = true; StateHasChanged();

        bool success = string.IsNullOrEmpty(FormState.Images.CoverImageUrl) || isCover
            ? await FormState.UploadCoverAsync(file)
            : await FormState.UploadGalleryAsync(file);

        if (success) await FormState.SyncImagesFromServerAsync();
        IsUploading = false;
    }

    private async Task ConfirmDelete(string url, bool isCover)
    {
        var ok = await DialogService.ShowMessageBox("Xóa ảnh?", "Không thể khôi phục", yesText: "Xóa", cancelText: "Hủy");
        if (ok == true)
        {
            await FormState.DeleteImageAsync(url);
            await FormState.SyncImagesFromServerAsync();
            Snackbar.Add("Đã xóa ảnh", Severity.Info);
        }
    }
}