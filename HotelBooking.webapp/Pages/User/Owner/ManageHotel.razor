@page "/owner/hotels"
@using Blazored.LocalStorage
@using HotelBooking.webapp.ViewModels.Hotel
@layout OwnerLayout
@attribute [Authorize(Roles = "Owner")]
@inject IHttpClientFactory _httpClientFactory
@inject ISnackbar Snackbar
@inject ILocalStorageService _localStorage
@inject NavigationManager _nav
@inject IJSRuntime JSRuntime

<PageTitle>Quản lý khách sạn của tôi</PageTitle>

<div class="container-fluid py-5 overflow-hidden">

    <div class="container-fluid px-4 mb-3">
        <div class="d-flex justify-content-between align-items-end">
            <div>
                <h2 class="fw-bold mb-1" style="color: #54a9ffff;">Danh sách khách sạn</h2>
            </div>

            @if (hotels != null && hotels.Count > 2)
            {
                <div class="d-flex gap-2">
                    <button class="btn btn-white rounded-circle shadow border" @onclick="ScrollLeft"
                        style="width:40px; height:40px;">
                        <i class="bi bi-chevron-left text-dark"></i>
                    </button>
                    <button class="btn btn-white rounded-circle shadow border" @onclick="ScrollRight"
                        style="width:40px; height:40px;">
                        <i class="bi bi-chevron-right text-dark"></i>
                    </button>
                </div>
            }
        </div>
    </div>

    @if (hotels == null)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary"></div>
        </div>
    }
    else
    {
        <div class="scroll-container d-flex px-4 pb-5 pt-2" id="hotelScrollList">

            <div class="hotel-card-wrapper me-4">
                <a href="/owner/hotel-wizard"
                    class="card h-100 border-2 border-dashed bg-light text-decoration-none add-new-card d-flex align-items-center justify-content-center"
                    style="min-height: 480px;">

                    <div class="text-center">
                        <div class="icon-circle mb-3 mx-auto bg-white text-primary shadow-sm">
                            <i class="bi bi-plus-lg fs-2"></i>
                        </div>
                        <h5 class="fw-bold text-dark mb-1">Đăng ký mới</h5>
                        <p class="text-muted small mb-0 px-3">Thêm khách sạn vào hệ thống<br>quản lý của bạn</p>
                    </div>
                </a>
            </div>

            @foreach (var h in hotels)
            {
                <div class="hotel-card-wrapper me-4">
                    <div class="card h-100 border-0 shadow-sm hover-lift rounded-4 overflow-hidden">

                        <div class="position-relative" style="height: 240px;">
                            <img src="@(h.CoverImageUrl ?? "/images/no-hotel.png")" class="w-100 h-100 object-fit-cover"
                                alt="@h.HotelName" />

                            <div class="overlay-gradient"></div>

                            <div class="position-absolute top-0 start-0 m-3">
                                @if (h.IsVerified)
                                {
                                    <span class="badge bg-success bg-opacity-75 backdrop-blur shadow-sm">
                                        <i class="bi bi-patch-check-fill me-1"></i> Đã xác minh
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-dark bg-opacity-50 backdrop-blur shadow-sm text-warning">
                                        <i class="bi bi-exclamation-circle me-1"></i> Chưa xác minh
                                    </span>
                                }
                            </div>

                            <div class="position-absolute top-0 end-0 m-3">
                                <span class="badge rounded-pill px-3 py-2 fw-normal shadow-sm @GetStatusBadgeClass(h.Status)">
                                    @GetStatusText(h.Status)
                                </span>
                            </div>

                            <div class="position-absolute bottom-0 start-0 w-100 p-3 text-white">
                                <h4 class="fw-bold mb-1 text-shadow text-truncate" title="@h.HotelName">@h.HotelName</h4>
                                <div class="d-flex align-items-center small text-white-50">
                                    <i class="bi bi-geo-alt-fill me-1 text-warning"></i>
                                    <span class="text-truncate">@h.Address, @h.City</span>
                                </div>
                            </div>
                        </div>

                        <div class="card-body p-4">
                            <div class="row g-3 mb-4">
                                <div class="col-6">
                                    <div class="d-flex align-items-center">
                                        <div class="icon-box bg-primary-subtle text-primary me-2"><i
                                                class="bi bi-door-open-fill"></i></div>
                                        <div>
                                            <div class="fw-bold text-dark fs-5 lh-1">@h.TotalRooms</div>
                                            <small class="text-muted" style="font-size:0.75rem">Tổng phòng</small>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="d-flex align-items-center">
                                        <div class="icon-box bg-success-subtle text-success me-2"><i
                                                class="bi bi-check-circle-fill"></i></div>
                                        <div>
                                            <div class="fw-bold text-success fs-5 lh-1">@h.AvailableRooms</div>
                                            <small class="text-muted" style="font-size:0.75rem">Còn trống</small>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="d-flex align-items-center">
                                        <div class="icon-box bg-info-subtle text-info me-2"><i class="bi bi-layers-fill"></i>
                                        </div>
                                        <div>
                                            <div class="fw-bold text-dark fs-5 lh-1">@h.RoomTypeCount</div>
                                            <small class="text-muted" style="font-size:0.75rem">Loại phòng</small>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="d-flex align-items-center">
                                        <div class="icon-box bg-danger-subtle text-danger me-2"><i
                                                class="bi bi-bookmark-heart-fill"></i></div>
                                        <div>
                                            <div class="fw-bold text-dark fs-5 lh-1">@h.TotalBookings</div>
                                            <small class="text-muted" style="font-size:0.75rem">Đơn đặt</small>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <hr class="border-light mb-3">

                            <div class="d-flex justify-content-between align-items-center">
                                <div class="d-flex align-items-center">
                                    <span class="badge bg-warning text-dark fs-6 me-2">@h.AvgRating.ToString("F1")</span>
                                    <div class="small text-muted lh-sm">
                                        <div><strong>Rất tốt</strong></div>
                                        <div>@h.ReviewCount đánh giá</div>
                                    </div>
                                </div>

                                <button class="btn btn-link text-danger p-0" title="Xóa khách sạn"
                                    @onclick="() => Delete(h.HotelId)">
                                    <i class="bi bi-trash3 fs-5"></i>
                                </button>
                            </div>
                        </div>

                        <div class="p-3 bg-light border-top">
                            @if (h.Status == "Draft")
                            {
                                <a href="/owner/hotel-wizard/@h.HotelId" class="btn btn-outline-primary w-100 fw-bold rounded-pill">
                                    <i class="bi bi-pencil-square me-2"></i>Tiếp tục chỉnh sửa
                                </a>
                            }
                            else
                            {
                                <div class="d-flex gap-2">
                                    <a href="/Hotel/@h.HotelId" target="_blank" class="btn btn-white border w-25"
                                        title="Xem trang hiển thị">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a href="/owner/hotels/@h.HotelId/dashboard" class="btn btn-primary w-75 fw-bold shadow-sm">
                                        <i class="bi bi-gear-fill me-2"></i>Quản lý ngay
                                    </a>
                                </div>
                            }
                        </div>

                    </div>
                </div>
            }
        </div>
    }
</div>
<HotelEditForm IsVisible="showDeleteModal" Message="Dữ liệu khách sạn và các đơn đặt phòng sẽ bị xóa vĩnh viễn."
    OnConfirm="HandleDeleteConfirmed" OnCancel="() => showDeleteModal = false" />
<style>
    /* 1. Kích thước Card Lớn hơn */
    .hotel-card-wrapper {
        min-width: 400px;
        /* Rộng hơn hẳn (cũ là 320px) */
        max-width: 400px;
    }

    /* 2. Scroll Container ẩn thanh cuộn */
    .scroll-container {
        overflow-x: auto;
        scroll-behavior: smooth;
        scrollbar-width: none;
        /* Firefox */
        -webkit-overflow-scrolling: touch;
    }

    .scroll-container::-webkit-scrollbar {
        display: none;
    }

    /* Chrome */

    /* 3. Style Card */
    .hover-lift {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .hover-lift:hover {
        transform: translateY(-5px);
        box-shadow: 0 1rem 3rem rgba(0, 0, 0, .15) !important;
    }

    .overlay-gradient {
        position: absolute;
        inset: 0;
        background: linear-gradient(to bottom, rgba(0, 0, 0, 0) 40%, rgba(0, 0, 0, 0.85) 100%);
    }

    .backdrop-blur {
        backdrop-filter: blur(8px);
    }

    .text-shadow {
        text-shadow: 0 2px 4px rgba(0, 0, 0, 0.8);
    }

    .object-fit-cover {
        object-fit: cover;
    }

    /* 4. Style Icon Stats */
    .icon-box {
        width: 36px;
        height: 36px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
    }

    /* 5. Style Card Add New */
    .add-new-card {
        border-style: dashed !important;
        transition: all 0.3s;
    }

    .add-new-card:hover {
        background-color: #e9ecef !important;
        border-color: var(--bs-primary) !important;
    }

    .add-new-card .icon-circle {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: transform 0.3s;
    }

    .add-new-card:hover .icon-circle {
        transform: scale(1.1) rotate(90deg);
        background-color: var(--bs-primary) !important;
        color: white !important;
    }
</style>

@code {
    private List<HotelOwnerSummaryVM>? hotels;
    private HttpClient? _httpClient;
    private bool showDeleteModal = false;
    private int hotelIdToDelete = 0;
    protected override async Task OnInitializedAsync()
    {
        _httpClient = _httpClientFactory.CreateClient("HotelBookingAPI");
        await SetAuthHeader();
        await LoadHotels();
    }

    private async Task SetAuthHeader()
    {
        var token = await _localStorage.GetItemAsync<string>("accessToken");
        if (!string.IsNullOrEmpty(token))
            _httpClient!.DefaultRequestHeaders.Authorization = new("Bearer", token);
    }

    private async Task LoadHotels()
    {
        try
        {
            var res = await _httpClient!.GetFromJsonAsync<ApiResponse<List<HotelOwnerSummaryVM>>>("hotel/owner/summary");
            hotels = res?.Content ?? new();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Lỗi tải dữ liệu: {ex.Message}", Severity.Error);
        }
    }

    private async Task Delete(int id)
    {
        hotelIdToDelete = id;
        showDeleteModal = true;
    }

    private async Task HandleDeleteConfirmed()
    {
        showDeleteModal = false; // Đóng modal trước

        var res = await _httpClient!.DeleteAsync($"hotel/owner/delete-hotel/{hotelIdToDelete}");
        if (res.IsSuccessStatusCode)
        {
            Snackbar.Add("Xóa khách sạn thành công!", Severity.Success);
            await LoadHotels();
        }
        else
        {
            var error = await res.Content.ReadAsStringAsync();
            Snackbar.Add($"Xóa thất bại: {error}", Severity.Error);
        }
    }
    private string GetStatusText(string status) => status switch
    {
        "Active" => "Đang hoạt động",
        "Suspended" => "Tạm ngừng",
        "PendingVerification" => "Chờ duyệt",
        "Verified" => "Đã duyệt",
        "Rejected" => "Bị từ chối",
        "Draft" => "Đang tạo",
        _ => "Không xác định"
    };

    private string GetStatusBadgeClass(string status) => status switch
    {
        "Active" => "bg-success text-white",
        "Suspended" => "bg-danger text-white",
        "PendingVerification" => "bg-warning text-dark",
        "Draft" => "bg-secondary text-white",
        _ => "bg-light text-dark border"
    };

    private async Task ScrollLeft()
    {
        await JSRuntime.InvokeVoidAsync("eval", "document.getElementById('hotelScrollList').scrollBy({ left: -340, behavior: 'smooth' })");
    }

    private async Task ScrollRight()
    {
        await JSRuntime.InvokeVoidAsync("eval", "document.getElementById('hotelScrollList').scrollBy({ left: 340, behavior: 'smooth' })");
    }
}