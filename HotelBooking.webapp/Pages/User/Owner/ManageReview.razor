@page "/owner/hotels/{HotelId:int}/reviews"
@layout OwnerLayout
@using HotelBooking.webapp.ViewModels.Hotel
@using MudBlazor
@inject IHttpClientFactory _clientFactory
@inject ISnackbar _snackbar
@inject Blazored.LocalStorage.ILocalStorageService _localStorage

<div class="container-fluid py-4 bg-light min-vh-100">
    <div class="row g-4 mb-4 align-items-center">
        <div class="col-md-6">
            <h4 class="fw-bold mb-1 text-primary">Quản lý Đánh giá</h4>
        </div>
        
        <div class="col-md-6">
            <div class="d-flex gap-3 justify-content-md-end">
                <div class="bg-white p-3 rounded-4 shadow-sm border border-light d-flex align-items-center px-4">
                    <div class="me-3 bg-warning bg-opacity-10 p-2 rounded-circle text-warning">
                        <i class="bi bi-star-fill fs-4"></i>
                    </div>
                    <div>
                        <small class="d-block text-muted text-uppercase fw-bold" style="font-size: 0.7rem;">Điểm trung bình</small>
                        <span class="fw-bolder text-dark fs-4">@AverageRating.ToString("0.0")</span>
                        <span class="text-muted fs-6">/10</span>
                    </div>
                </div>
                <div class="bg-white p-3 rounded-4 shadow-sm border border-light d-flex align-items-center px-4">
                    <div class="me-3 bg-primary bg-opacity-10 p-2 rounded-circle text-primary">
                        <i class="bi bi-chat-left-text-fill fs-4"></i>
                    </div>
                    <div>
                        <small class="d-block text-muted text-uppercase fw-bold" style="font-size: 0.7rem;">Tổng đánh giá</small>
                        <span class="fw-bolder text-dark fs-4">@Reviews.Count</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="d-flex justify-content-center py-5">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Large" />
        </div>
    }
    else if (!Reviews.Any())
    {
        <div class="text-center py-5 bg-white rounded-4 shadow-sm">
            <div class="mb-3">
                <i class="bi bi-chat-square-heart fs-1 text-muted opacity-25"></i>
            </div>
            <h5 class="text-dark fw-bold">Chưa có đánh giá nào</h5>
            <p class="text-muted">Khi khách hàng để lại đánh giá, chúng sẽ xuất hiện ở đây.</p>
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var review in Reviews)
            {
                <div class="col-12">
                    <div class="card border-0 shadow-sm rounded-4 overflow-hidden review-card hover-shadow transition-all">
                        <div class="card-body p-4">
                            <div class="row">
                                <div class="col-lg-3 border-end-lg pe-lg-4 mb-3 mb-lg-0">
                                    <div class="d-flex align-items-center mb-3">
                                        @if (!string.IsNullOrEmpty(review.CustomerAvatar))
                                        {
                                            <img src="@review.CustomerAvatar" class="rounded-circle border border-2 border-white shadow-sm" 
                                                 style="width:56px; height:56px; object-fit:cover;">
                                        }
                                        else
                                        {
                                            <div class="rounded-circle bg-primary bg-opacity-10 text-primary d-flex align-items-center justify-content-center fw-bold fs-4" 
                                                 style="width:56px; height:56px;">
                                                @review.CustomerName.FirstOrDefault()
                                            </div>
                                        }
                                        <div class="ms-3">
                                            <h6 class="fw-bold text-dark mb-0">@review.CustomerName</h6>
                                            <small class="text-muted" style="font-size: 0.8rem;">
                                                <i class="bi bi-calendar3 me-1"></i> @review.CreatedAt.ToString("dd/MM/yyyy")
                                            </small>
                                        </div>
                                    </div>
                                    
                                    <div class="bg-light rounded-3 p-2 mb-2">
                                        <small class="text-muted d-block mb-1 text-uppercase fw-bold" style="font-size: 0.65rem;">Phòng đã ở</small>
                                        <div class="d-flex align-items-center text-dark small fw-medium">
                                            <i class="bi bi-door-open me-2 text-secondary"></i>
                                            @review.RoomTypeName
                                        </div>
                                        @if(review.StayNights > 0) {
                                            <div class="d-flex align-items-center text-dark small fw-medium mt-1">
                                                <i class="bi bi-moon-stars me-2 text-secondary"></i>
                                                @review.StayNights đêm
                                            </div>
                                        }
                                    </div>
                                </div>

                                <div class="col-lg-9 ps-lg-4 d-flex flex-column">
                                    
                                    <div class="d-flex justify-content-between align-items-start mb-3">
                                        <div class="d-flex align-items-center">
                                            <span class="badge bg-primary fs-6 px-3 py-2 rounded-pill me-2">@review.Rating.ToString("0.0")</span>
                                            <span class="fw-bold text-dark">@GetRatingText(review.Rating)</span>
                                        </div>
                                        
                                        @if (string.IsNullOrEmpty(review.Reply))
                                        {
                                            <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 px-3 py-2 rounded-pill">
                                                <i class="bi bi-exclamation-circle me-1"></i> Chưa phản hồi
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-3 py-2 rounded-pill">
                                                <i class="bi bi-check2-circle me-1"></i> Đã phản hồi
                                            </span>
                                        }
                                    </div>

                                    <div class="position-relative mb-4 flex-grow-1">
                                        <i class="fs-1 text-muted opacity-25 position-absolute top-0 start-0 translate-middle-x"></i>
                                        <p class="text-secondary fst-italic ps-4 mb-0" style="font-size: 1.05rem; line-height: 1.6;">
                                            @review.Comment
                                        </p>
                                    </div>

                                    <div class="mt-auto">
                                        @if (!string.IsNullOrEmpty(review.Reply))
                                        {
                                            <div class="bg-light border border-secondary border-opacity-10 rounded-3 p-3 position-relative">
                                                <div class="d-flex justify-content-between align-items-center mb-2">
                                                    <div class="d-flex align-items-center text-primary fw-bold small">
                                                        Phản hồi từ khách sạn
                                                    </div>
                                                    <button class="btn btn-link btn-sm p-0 text-decoration-none text-muted" 
                                                            @onclick="() => OpenReplyModal(review)" title="Chỉnh sửa phản hồi">
                                                        <i class="bi bi-pencil-square"></i>
                                                    </button>
                                                </div>
                                                <p class="mb-0 text-dark small">@review.Reply</p>
                                            </div>
                                        }
                                        else
                                        {
                                            <button class="btn btn-outline-primary fw-bold rounded-pill px-4 py-2 hover-scale" 
                                                    @onclick="() => OpenReplyModal(review)">
                                                <i class="bi bi-reply-fill me-2"></i> Viết phản hồi
                                            </button>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@if (showReplyModal)
{
    <div class="modal fade show d-block" style="background: rgba(0,0,0,0.6); backdrop-filter: blur(4px);" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-4">
                <div class="modal-header border-bottom-0 pb-0">
                    <h5 class="modal-title fw-bold text-dark">Phản hồi khách hàng</h5>
                    <button type="button" class="btn-close" @onclick="() => showReplyModal = false"></button>
                </div>
                <div class="modal-body pt-2">
                    <p class="text-muted small mb-3">
                        Bạn đang phản hồi cho đánh giá của <strong>@selectedReview?.CustomerName</strong>. 
                        Hãy thể hiện sự chuyên nghiệp và thân thiện.
                    </p>
                    <div class="bg-light p-3 rounded-3 mb-3 fst-italic text-secondary small border">
                        "@selectedReview?.Comment"
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold small text-dark">Nội dung trả lời</label>
                        <textarea class="form-control bg-white border-secondary border-opacity-25" 
                                  rows="5" @bind="replyContent" 
                                  placeholder="Cảm ơn bạn đã lựa chọn khách sạn của chúng tôi..."></textarea>
                    </div>
                </div>
                <div class="modal-footer border-top-0 pt-0">
                    <button type="button" class="btn btn-light rounded-pill px-4 fw-bold text-muted" @onclick="() => showReplyModal = false">Hủy</button>
                    <button type="button" class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm" 
                            @onclick="SubmitReply" disabled="@isSubmitting">
                        @if (isSubmitting)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        <i class="bi bi-send-fill me-2"></i> Gửi phản hồi
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<style>
    .hover-shadow:hover {
        box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.08) !important;
    }
    .transition-all {
        transition: all 0.3s ease;
    }
    .hover-scale:hover {
        transform: scale(1.02);
    }
    /* Responsive border */
    @@media (min-width: 992px) {
        .border-end-lg {
            border-right: 1px solid #dee2e6 !important;
        }
    }
</style>

@code {
    [Parameter] public int HotelId { get; set; }

    private List<ReviewVM> Reviews = new();
    private bool isLoading = true;
    private decimal AverageRating = 0;

    // Modal logic
    private bool showReplyModal = false;
    private ReviewVM? selectedReview;
    private string replyContent = "";
    private bool isSubmitting = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadReviews();
    }

    private async Task LoadReviews()
    {
        isLoading = true;
        try
        {
            var client = _clientFactory.CreateClient("HotelBookingAPI");
            var token = await _localStorage.GetItemAsync<string>("accessToken");
            if (!string.IsNullOrEmpty(token))
                client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);

            // API lấy danh sách review (bạn đã có api này rồi: GetHotelReviews)
            var res = await client.GetFromJsonAsync<ApiResponse<List<ReviewVM>>>($"hotel/{HotelId}/reviews");

            if (res != null && res.StatusCode == StatusCodeResponse.Success)
            {
                Reviews = res.Content ?? new();
                if (Reviews.Any())
                {
                    AverageRating = Reviews.Average(r => r.Rating);
                }
            }
        }
        catch (Exception ex)
        {
            _snackbar.Add($"Lỗi tải dữ liệu: {ex.Message}", Severity.Error);
        }
        finally { isLoading = false; }
    }

    private void OpenReplyModal(ReviewVM review)
    {
        selectedReview = review;
        replyContent = review.Reply ?? ""; // Load nội dung cũ nếu có
        showReplyModal = true;
    }

    private string GetRatingText(decimal rating) => rating switch
    {
        >= 9.0m => "Tuyệt vời",
        >= 8.0m => "Rất tốt",
        >= 7.0m => "Tốt",
        >= 5.0m => "Trung bình",
        _ => "Kém"
    };
    
    // Thêm biến hotelDetail nếu muốn lấy ảnh Cover
    private HotelDetailVM? hotelDetail;
    private async Task SubmitReply()
    {
        if (selectedReview == null) return;
        isSubmitting = true;

        try
        {
            var client = _clientFactory.CreateClient("HotelBookingAPI");
            var token = await _localStorage.GetItemAsync<string>("accessToken");
            client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);

            // Cần thêm API Reply ở Backend (Xem phần dưới)
            var payload = new ReplyReviewVM
            {
                ReviewId = selectedReview.Id,
                Reply = replyContent
            };
            var res = await client.PostAsJsonAsync("hotel/owner/review/reply", payload);

            if (res.IsSuccessStatusCode)
            {
                _snackbar.Add("Phản hồi thành công!", Severity.Success);
                selectedReview.Reply = replyContent; // Cập nhật UI ngay lập tức
                showReplyModal = false;
            }
            else
            {
                _snackbar.Add("Gửi phản hồi thất bại.", Severity.Error);
            }
        }
        catch
        {
            _snackbar.Add("Lỗi kết nối.", Severity.Error);
        }
        finally { isSubmitting = false; }
    }
}