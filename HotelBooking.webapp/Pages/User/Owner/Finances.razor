@page "/owner/finances"
@using Blazored.LocalStorage
@using HotelBooking.webapp.ViewModels.Hotel
@using System.Net.Http.Headers
@attribute [Authorize(Roles = "Owner")]
@inject IHttpClientFactory _httpClientFactory
@layout OwnerLayout
@inject ISnackbar Snackbar
@inject ILocalStorageService _localStorage
@inject NavigationManager _nav

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold text-primary mb-1">Tài chính & Doanh thu</h3>
            <p class="text-muted mb-0">Theo dõi dòng tiền, doanh thu và thực hiện rút tiền.</p>
        </div>
        <button class="btn btn-outline-primary rounded-pill px-4" @onclick="LoadWalletData" disabled="@isLoading">
            <i class="bi bi-arrow-clockwise me-2 @(isLoading ? "spin-icon" : "")"></i>Làm mới
        </button>
    </div>

    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-2 text-muted">Đang đồng bộ dữ liệu ví...</p>
        </div>
    }
    else
    {
        <div class="row g-4 mb-5">
            <div class="col-md-7 col-lg-7">
                <div class="wallet-card bg-gradient-primary text-white h-100 shadow-lg rounded-4 p-4 position-relative overflow-hidden">
                    <div class="bg-pattern-circle"></div>
                    <div class="position-relative z-1 h-100 d-flex flex-column justify-content-between">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="d-flex align-items-center gap-2 mb-2">
                                    <div class="bg-white bg-opacity-25 rounded-circle p-1">
                                        <i class="bi bi-wallet2 fs-6 text-white"></i>
                                    </div>
                                    <small class="opacity-90 text-uppercase fw-bold ls-1">Số dư khả dụng</small>
                                </div>
                                <h1 class="display-4 fw-bold mb-0 text-white">
                                    @wallet.Balance.ToString("N0") <span class="fs-4 opacity-50">₫</span>
                                </h1>
                            </div>
                            <button class="btn btn-light text-primary fw-bold px-4 py-2 rounded-pill shadow-sm hover-scale"
                                    @onclick="() => showWithdrawModal = true">
                                <i class="bi bi-cash-coin me-2"></i> Rút tiền
                            </button>
                        </div>

                        <div class="mt-4 pt-3 border-top border-white border-opacity-25 d-flex align-items-center justify-content-between">
                            <span class="small opacity-75"><i class="bi bi-shield-check me-1"></i> Bảo mật bởi ChillZone System</span>
                            <span class="small opacity-75">Cập nhật: @DateTime.Now.ToString("HH:mm")</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-5 col-lg-5">
                <div class="card border-0 h-100 shadow-sm rounded-4 bg-white">
                    <div class="card-body p-4 d-flex flex-column justify-content-center">
                        <div class="d-flex align-items-center justify-content-between mb-4">
                            <div class="icon-box bg-success bg-opacity-10 text-success rounded-circle p-3">
                                <i class="bi bi-graph-up-arrow fs-3"></i>
                            </div>
                            <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 rounded-pill px-3">
                                Tổng tích lũy
                            </span>
                        </div>
                        
                        <div>
                            <small class="text-muted text-uppercase fw-bold mb-1 d-block">Tổng thu nhập ròng</small>
                            <h2 class="fw-bold text-dark mb-2 display-6">@wallet.TotalEarnings.ToString("N0") ₫</h2>
                            
                            <div class="d-flex align-items-start text-muted small mt-3 bg-light rounded p-2">
                                <i class="bi bi-info-circle-fill me-2 text-primary mt-1"></i>
                                <span>Đây là số tiền thực nhận (đã trừ phí sàn 10%) từ tất cả các đơn hàng hoàn tất.</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
            <div class="card-header bg-white py-3 px-4 border-bottom d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0 text-dark">Lịch sử giao dịch</h5>
                <span class="badge bg-light text-dark border rounded-pill">@wallet.RecentTransactions.Count giao dịch gần nhất</span>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 custom-table">
                    <thead class="bg-light">
                        <tr>
                            <th class="ps-4" style="width: 180px;">Thời gian</th>
                            <th style="width: 200px;">Loại giao dịch</th>
                            <th>Mô tả chi tiết</th>
                            <th class="text-end pe-4" style="width: 180px;">Biến động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (wallet.RecentTransactions.Any())
                        {
                            @foreach (var item in wallet.RecentTransactions)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <div class="fw-bold text-dark">@item.Date.ToString("dd/MM/yyyy")</div>
                                        <small class="text-muted">@item.Date.ToString("HH:mm")</small>
                                    </td>
                                    <td>
                                        @RenderTransactionType(item.Type)
                                    </td>
                                    <td class="text-secondary small">
                                        @item.Description
                                    </td>
                                    <td class="text-end pe-4 fw-bold fs-6">
                                        @if (item.Amount > 0)
                                        {
                                            <span class="text-success bg-success bg-opacity-10 px-2 py-1 rounded">
                                                +@item.Amount.ToString("N0") ₫
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-danger bg-danger bg-opacity-10 px-2 py-1 rounded">
                                                @item.Amount.ToString("N0") ₫
                                            </span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center py-5 text-muted">
                                    <div class="d-flex flex-column align-items-center">
                                        <div class="bg-light rounded-circle p-4 mb-3">
                                            <i class="bi bi-receipt fs-1 text-secondary opacity-50"></i>
                                        </div>
                                        <p class="mb-0">Chưa có giao dịch nào phát sinh.</p>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@if (showWithdrawModal)
{
    <div class="modal-backdrop fade show" style="background-color: rgba(0,0,0,0.5);"></div>
    <div class="modal fade show d-block" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow rounded-4">
                <div class="modal-header border-bottom-0 pb-0">
                    <div>
                        <h5 class="modal-title fw-bold text-primary">Yêu cầu rút tiền</h5>
                        <p class="mb-0 small text-muted">Tiền sẽ về tài khoản trong 24h làm việc.</p>
                    </div>
                    <button type="button" class="btn-close" @onclick="() => showWithdrawModal = false"></button>
                </div>
                <div class="modal-body p-4">
                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger d-flex align-items-center small mb-3">
                            <i class="bi bi-exclamation-circle-fill me-2"></i>
                            @errorMessage
                        </div>
                    }

                    <EditForm Model="withdrawRequest" OnValidSubmit="HandleWithdraw">
                        <DataAnnotationsValidator />

                        <div class="mb-3">
                            <label class="form-label small fw-bold text-muted text-uppercase">Số tiền rút</label>
                            <div class="input-group input-group-lg">
                                <span class="input-group-text bg-light border-end-0 fw-bold text-muted">₫</span>
                                <input type="number" class="form-control border-start-0 fw-bold text-primary fs-4"
                                    @bind="withdrawRequest.Amount" min="50000" step="10000" />
                            </div>
                            <div class="d-flex justify-content-between mt-1">
                                <small class="text-muted">Tối thiểu: 50.000 ₫</small>
                                <small class="text-primary fw-bold cursor-pointer" @onclick="() => withdrawRequest.Amount = wallet.Balance">Rút tất cả</small>
                            </div>
                        </div>

                        <div class="bg-light p-3 rounded-3 mb-3">
                            <div class="mb-3">
                                <label class="form-label small fw-bold text-muted">Ngân hàng thụ hưởng</label>
                                <InputText class="form-control" placeholder="VD: MB Bank, Vietcombank..."
                                    @bind-Value="withdrawRequest.BankName" />
                            </div>
                            <div class="mb-2">
                                <label class="form-label small fw-bold text-muted">Số tài khoản</label>
                                <InputText class="form-control font-monospace" placeholder="0123456789"
                                    @bind-Value="withdrawRequest.BankAccountNumber" />
                            </div>
                            <div class="mb-0">
                                <label class="form-label small fw-bold text-muted">Tên chủ thẻ (Không dấu)</label>
                                <InputText class="form-control text-uppercase" placeholder="NGUYEN VAN A"
                                    @bind-Value="withdrawRequest.BankAccountName" />
                            </div>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 rounded-pill py-3 fw-bold shadow-sm"
                            disabled="@(isSubmitting || wallet.Balance <= 0)">
                            @if (isSubmitting)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                            }
                            XÁC NHẬN RÚT TIỀN
                        </button>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

<style>
    .bg-gradient-primary { background: linear-gradient(135deg, #2563eb 0%, #0ea5e9 100%); }
    .wallet-card { min-height: 240px; }
    .bg-pattern-circle {
        position: absolute; top: -60px; right: -60px; width: 220px; height: 220px;
        background: radial-gradient(circle, rgba(255,255,255,0.2) 0%, rgba(255,255,255,0) 70%);
        border-radius: 50%;
    }
    .hover-scale { transition: all 0.2s ease; }
    .hover-scale:hover { transform: translateY(-2px); box-shadow: 0 .5rem 1rem rgba(0,0,0,.15)!important; }
    .custom-table th { font-size: 0.8rem; text-transform: uppercase; color: #64748b; letter-spacing: 0.5px; padding-top: 1rem; padding-bottom: 1rem; }
    .custom-table td { padding-top: 1rem; padding-bottom: 1rem; border-bottom: 1px solid #f1f5f9; }
    .spin-icon { animation: spin 1s linear infinite; }
    @@keyframes spin { 100% { transform: rotate(360deg); } }
    .cursor-pointer { cursor: pointer; }
</style>

@code {
    private bool isLoading = true;
    private bool isSubmitting = false;
    private bool showWithdrawModal = false;
    private string errorMessage = "";

    private OwnerWalletVM wallet = new();
    private WithdrawRequestVM withdrawRequest = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadWalletData();
    }

    private async Task LoadWalletData()
    {
        isLoading = true;
        try
        {
            var token = await _localStorage.GetItemAsync<string>("accessToken");
            if (string.IsNullOrEmpty(token)) { _nav.NavigateTo("/customer-login"); return; }

            var client = _httpClientFactory.CreateClient("HotelBookingAPI");
            client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);

            var res = await client.GetFromJsonAsync<ApiResponse<OwnerWalletVM>>("wallet"); // Đảm bảo đúng route API
            
            if (res != null && res.StatusCode == StatusCodeResponse.Success)
            {
                wallet = res.Content;
            }
        }
        catch (Exception ex) { Console.WriteLine(ex.Message); }
        finally { isLoading = false; }
    }

    private async Task HandleWithdraw()
    {
        errorMessage = "";
        if (withdrawRequest.Amount <= 0) { errorMessage = "Số tiền phải lớn hơn 0"; return; }
        if (withdrawRequest.Amount > wallet.Balance) { errorMessage = "Số dư không đủ."; return; }
        if (string.IsNullOrWhiteSpace(withdrawRequest.BankName) || string.IsNullOrWhiteSpace(withdrawRequest.BankAccountNumber))
        {
            errorMessage = "Vui lòng nhập đầy đủ thông tin ngân hàng."; return;
        }

        isSubmitting = true;
        try
        {
            var token = await _localStorage.GetItemAsync<string>("accessToken");
            var client = _httpClientFactory.CreateClient("HotelBookingAPI");
            client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);

            var res = await client.PostAsJsonAsync("wallet/withdraw", withdrawRequest); // Đảm bảo đúng route API
            
            if (res.IsSuccessStatusCode)
            {
                showWithdrawModal = false;
                withdrawRequest = new WithdrawRequestVM(); // Reset form sau khi rút
                Snackbar.Add("Yêu cầu rút tiền thành công!", Severity.Success);
                await LoadWalletData();
            }
            else
            {
                var errorContent = await res.Content.ReadFromJsonAsync<ApiResponse<bool>>();
                errorMessage = errorContent?.Message ?? "Có lỗi xảy ra.";
            }
        }
        catch { errorMessage = "Lỗi kết nối máy chủ."; }
        finally { isSubmitting = false; }
    }

    // Hàm render Label đẹp hơn, dễ nhìn hơn
    private RenderFragment RenderTransactionType(string type)
    {
        return builder =>
        {
            string badgeClass = "bg-light text-dark";
            string text = type;
            string icon = "bi-circle";

            switch (type)
            {
                case "BookingRevenue": // Cộng tiền
                    badgeClass = "bg-success bg-opacity-10 text-success border border-success border-opacity-25";
                    text = "Doanh thu phòng";
                    icon = "bi-arrow-down-left"; // Mũi tên đi vào
                    break;
                case "CommissionFee": // Trừ tiền
                    badgeClass = "bg-warning bg-opacity-10 text-warning-emphasis border border-warning border-opacity-25";
                    text = "Phí dịch vụ sàn";
                    icon = "bi-percent";
                    break;
                case "Withdrawal": // Trừ tiền
                    badgeClass = "bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25";
                    text = "Rút tiền về ví";
                    icon = "bi-bank";
                    break;
                case "RefundDeduction": // Trừ tiền
                    badgeClass = "bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25";
                    text = "Trừ tiền hoàn trả";
                    icon = "bi-arrow-up-right"; // Mũi tên đi ra
                    break;
                case "WithdrawalRefund": // Cộng tiền (Admin từ chối rút -> hoàn lại)
                    badgeClass = "bg-info bg-opacity-10 text-info-emphasis border border-info border-opacity-25";
                    text = "Hoàn tiền rút lỗi";
                    icon = "bi-arrow-counterclockwise";
                    break;
            }

            builder.OpenElement(0, "span");
            builder.AddAttribute(1, "class", $"badge rounded-pill fw-normal px-2 py-1 {badgeClass}");
            builder.AddMarkupContent(2, $"<i class='bi {icon} me-1'></i>{text}");
            builder.CloseElement();
        };
    }
}