@page "/owner/hotels/{HotelId:int}/dashboard"
@attribute [Authorize(Roles = "Owner")]
@layout OwnerLayout
@using System.Globalization
@using HotelBooking.webapp.ViewModels.Hotel

@inject IHttpClientFactory HttpClientFactory
@inject Blazored.LocalStorage.ILocalStorageService localStorage
@inject ISnackbar Snackbar
@inject NavigationManager NavManager



<PageTitle>Thống kê - @(hotelInfo?.HotelName ?? "Đang tải...")</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="py-4">
    @if (isLoading)
    {
        <div class="d-flex justify-content-center align-items-center" style="height: 60vh;">
            <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" />
        </div>
    }
    else if (stats != null)
    {
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <MudText Typo="Typo.h4" Class="fw-bold" Color="Color.Primary">
                    @(hotelInfo?.HotelName ?? "Thống kê")
                </MudText>
                <MudText Typo="Typo.subtitle1" Class="text-muted">
                    <MudIcon Icon="@Icons.Material.Filled.LocationOn" Size="Size.Small" Class="mb-1 me-1" />
                    Tổng quan hoạt động hôm nay (@DateTime.Now.ToString("dd/MM/yyyy"))
                </MudText>
            </div>
            <div class="d-flex gap-2">
                <MudButton Variant="MudBlazor.Variant.Outlined" Color="Color.Secondary"
                    StartIcon="@Icons.Material.Filled.Refresh" OnClick="LoadData">
                    Làm mới
                </MudButton>
                <MudButton Variant="MudBlazor.Variant.Filled" Color="Color.Primary"
                    StartIcon="@Icons.Material.Filled.CalendarMonth" Href="@($"/owner/hotels/{HotelId}/bookings/calendar")">
                    Xem lịch đặt phòng
                </MudButton>
            </div>
        </div>

        <MudGrid Class="mb-4">
            <MudItem xs="12" sm="12" md="4">
                <MudPaper Elevation="0" Class="pa-4 rounded-4 border h-100 d-flex flex-column justify-center"
                    Style="background: linear-gradient(135deg, #e3f2fd 0%, #bbdefb 100%);">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <MudText Typo="Typo.subtitle2" Color="Color.Primary">DOANH THU HÔM NAY</MudText>
                        <MudIcon Icon="@Icons.Material.Filled.AttachMoney" Color="Color.Primary" />
                    </div>
                    <MudText Typo="Typo.h4" Color="Color.Primary" Class="fw-bold">@FormatCurrency(stats.RevenueToday)
                    </MudText>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" sm="6" md="4">
                <MudPaper Elevation="0" Class="pa-4 rounded-4 border h-100">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <MudText Typo="Typo.subtitle2" Class="text-muted">DOANH THU THÁNG @DateTime.Now.Month</MudText>
                        <MudIcon Icon="@Icons.Material.Filled.DateRange" Color="Color.Success" />
                    </div>
                    <MudText Typo="Typo.h4" Class="fw-bold text-success">@FormatCurrency(stats.RevenueThisMonth)</MudText>
                    <MudProgressLinear Color="Color.Success" Class="mt-3"
                        Style="height: 6px; border-radius: 4px;" />
                </MudPaper>
            </MudItem>

            <MudItem xs="12" sm="6" md="4">
                <MudPaper Elevation="0" Class="pa-4 rounded-4 border h-100">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <MudText Typo="Typo.subtitle2" Class="text-muted">TỔNG DOANH THU</MudText>
                        <MudIcon Icon="@Icons.Material.Filled.AccountBalanceWallet" Color="Color.Warning" />
                    </div>
                    <MudText Typo="Typo.h4" Class="fw-bold text-dark">@FormatCurrency(stats.TotalRevenue)</MudText>
                    <MudText Typo="Typo.caption" Class="text-muted">Doanh thu tích lũy toàn thời gian</MudText>
                </MudPaper>
            </MudItem>
        </MudGrid>

        <MudGrid Class="mt-4">
            <MudItem xs="12">
                <MudPaper Elevation="0" Class="pa-4 rounded-4 border">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div>
                            <MudText Typo="Typo.h6" Class="fw-bold">Biểu đồ doanh thu</MudText>
                        </div>

                        <MudButtonGroup Color="Color.Primary" Variant="MudBlazor.Variant.Outlined" Size="Size.Small">
                            <MudButton OnClick="@(() => LoadRevenueChart("Week"))"
                                Variant="@(chartMode == "Week" ? MudBlazor.Variant.Filled : MudBlazor.Variant.Outlined)">7
                                Ngày</MudButton>
                            <MudButton OnClick="@(() => LoadRevenueChart("Month"))"
                                Variant="@(chartMode == "Month" ? MudBlazor.Variant.Filled : MudBlazor.Variant.Outlined)">30
                                Ngày</MudButton>
                        </MudButtonGroup>
                    </div>

                    @if (isChartLoading)
                    {
                        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-5" />
                    }
                    else
                    {
                        <MudChart ChartType="ChartType.Bar" ChartSeries="@Series" XAxisLabels="@XAxisLabels" Width="100%"
                            Height="350px" ChartOptions="@revenueChartOptions">
                        </MudChart>
                    }
                </MudPaper>
            </MudItem>
        </MudGrid>

        <MudText Typo="Typo.h6" Class="my-3 fw-bold">Hoạt động lễ tân</MudText>

        <MudGrid>
            <MudItem xs="12" md="8">
                <MudPaper Elevation="0" Class="pa-4 rounded-4 border h-100">
                    <div class="d-flex justify-content-between mb-4">
                        <MudText Typo="Typo.h6" Class="fw-bold">Trạng thái phòng hiện tại</MudText>
                        <MudChip T="string" Color="Color.Default" Size="Size.Small" Variant="MudBlazor.Variant.Outlined">
                            Tổng:
                            @stats.TotalRooms phòng</MudChip>
                    </div>

                    <div class="d-flex align-center justify-center flex-wrap">
                        <div class="me-5">
                            <MudChart ChartType="ChartType.Donut" Width="180px" Height="180px" InputData="@chartData"
                                InputLabels="@chartLabels" ChartOptions="@chartOptions" LegendPosition="Position.Right">
                            </MudChart>
                        </div>

                        <div class="d-flex flex-column gap-2">
                            <div class="d-flex align-items-center">
                                <div style="width: 12px; height: 12px; background-color: #00c853; border-radius: 50%;"
                                    class="me-2"></div>
                                <MudText>Phòng trống: <b>@stats.AvailableRooms</b></MudText>
                            </div>
                            <div class="d-flex align-items-center">
                                <div style="width: 12px; height: 12px; background-color: #f44336; border-radius: 50%;"
                                    class="me-2"></div>
                                <MudText>Đang có khách: <b>@stats.OccupiedRooms</b></MudText>
                            </div>
                            <div class="d-flex align-items-center">
                                <div style="width: 12px; height: 12px; background-color: #bdbdbd; border-radius: 50%;"
                                    class="me-2"></div>
                                <MudText>Bảo trì/Khác: <b>@(stats.TotalRooms - stats.AvailableRooms -
                                                                            stats.OccupiedRooms)</b></MudText>
                            </div>
                            <div class="mt-2">
                                <MudText Typo="Typo.body2" Class="text-muted">Tỉ lệ lấp đầy: <b>@occupancyRate%</b>
                                </MudText>
                            </div>
                        </div>
                    </div>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" md="4">
                <MudPaper Elevation="0"
                    Class="pa-4 rounded-4 border h-100 d-flex flex-column align-items-center justify-content-center text-center">
                    <MudText Typo="Typo.h6" Class="fw-bold mb-3">Đánh giá của khách</MudText>

                    <div class="d-flex align-items-center justify-content-center mb-2">
                        <MudIcon Icon="@Icons.Material.Filled.Star" Color="Color.Warning" Style="font-size: 3rem;" />
                        <MudText Typo="Typo.h2" Class="fw-bold ms-2">@stats.AverageRating</MudText>
                    </div>

                    <MudRating ReadOnly="true" SelectedValue="@((int)Math.Round(stats.AverageRating / 2))" MaxValue="5" />

                    <MudText Typo="Typo.body2" Class="text-muted mt-2">Dựa trên <b>@stats.TotalReviews</b> lượt đánh giá
                    </MudText>

                    <MudButton Variant="MudBlazor.Variant.Outlined" Color="Color.Primary" Class="mt-4 rounded-pill"
                        Href="@($"/owner/hotels/{HotelId}/reviews")">
                        Xem chi tiết
                    </MudButton>
                </MudPaper>
            </MudItem>
        </MudGrid>
        
        <MudGrid Class="mt-1">
            <MudItem xs="12">
                <MudPaper Elevation="0" Class="rounded-4 border pa-2">
                    <MudTabs @bind-ActivePanelIndex="activeTabIndex" ApplyEffectsToContainer="true" PanelClass="pa-0"
                        Color="Color.Transparent" SliderColor="Color.Primary">

                        <MudTabPanel Text="Đơn đặt gần đây" Icon="@Icons.Material.Filled.FiberNew">
                            <BookingTable Items="@stats?.RecentBookings" OnViewClick="OpenBookingDetail" EmptyText="Chưa có đơn nào mới đặt gần đây." />
                        </MudTabPanel>

                        <MudTabPanel Text="Khách đến hôm nay" Icon="@Icons.Material.Filled.Login">
                            <BookingTable Items="@stats?.TodayCheckIns" OnViewClick="OpenBookingDetail" EmptyText="Hôm nay không có khách đến." />
                        </MudTabPanel>

                        <MudTabPanel Text="Khách đi hôm nay" Icon="@Icons.Material.Filled.Logout">
                            <BookingTable Items="@stats?.TodayCheckOuts" OnViewClick="OpenBookingDetail" EmptyText="Hôm nay không có khách đi." />
                        </MudTabPanel>

                    </MudTabs>
                </MudPaper>
            </MudItem>
            <OwnerBookingDetailModal @ref="bookingModal" />
        </MudGrid>
    }
    else
    {
        <MudAlert Severity="Severity.Info">Không có dữ liệu hiển thị.</MudAlert>
    }
</MudContainer>

<style>
    .avatar-icon {
        width: 50px;
        height: 50px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .border-l-4 {
        border-left-width: 4px !important;
    }

    .border-l-info {
        border-left-color: #03a9f4 !important;
    }

    .border-l-warning {
        border-left-color: #ff9800 !important;
    }

    .border-l-primary {
        border-left-color: #594ae2 !important;
    }

    .hover-scale {
        transition: transform 0.2s;
    }

    .hover-scale:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
    }

    .cursor-pointer {
        cursor: pointer;
    }
</style>

@code {
    [Parameter] public int HotelId { get; set; } // Nhận ID từ URL

    private OwnerDashboardStatsVM? stats;
    private HotelDetailVM? hotelInfo;
    @* private List<BookingRoomDetailVM> recentBookings = new(); *@
    private bool isLoading = true;
    private HttpClient? _httpClient;

    // Chart Data
    private double[] chartData = { };
    private string[] chartLabels = { "Trống", "Đang ở", "Khác" };
    private ChartOptions chartOptions = new ChartOptions { ChartPalette = new[] { "#00c853", "#f44336", "#bdbdbd" } };
    private double occupancyRate = 0;

    // chart revenue
    private bool isChartLoading = false;
    private string chartMode = "Week"; // Mặc định
    private List<ChartSeries> Series = new();
    private string[] XAxisLabels = { };
    private ChartOptions revenueChartOptions = new ChartOptions
    {
        YAxisFormat = "N0", // Số nguyên (bỏ số thập phân)
        ChartPalette = new[] { "#594ae2" } // Màu tím
    };
    // booking detail modal
    private OwnerBookingDetailModal bookingModal;
    // controll tab
    private int activeTabIndex = 0;

    protected override async Task OnInitializedAsync()
    {
        _httpClient = HttpClientFactory.CreateClient("HotelBookingAPI");
        var token = await localStorage.GetItemAsync<string>("accessToken");
        if (string.IsNullOrEmpty(token))
        {
            NavManager.NavigateTo("/customer-login");
            return;
        }
        _httpClient.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer",
        token);

        var culture = new CultureInfo("en-EN");
    CultureInfo.DefaultThreadCurrentCulture = culture;
    CultureInfo.DefaultThreadCurrentUICulture = culture;
        await LoadData();
        await LoadRevenueChart("Week");
        @* await LoadRecentBookings(); *@
    }

    private async Task LoadData()
    {
        isLoading = true;
        try
        {

            // 2. Lấy số liệu thống kê (Gọi API mới sửa lúc nãy)
            var statsRes = await
            _httpClient!.GetFromJsonAsync<ApiResponse<OwnerDashboardStatsVM>>($"Hotel/get-owner-dashboard?hotelId={HotelId}");
            if (statsRes!.StatusCode == StatusCodeResponse.Success && statsRes.Content != null)
            {
                stats = statsRes.Content;
                UpdateChart();
            }
            else
            {
                Snackbar.Add(statsRes?.Message ?? "Không tải được dữ liệu thống kê", Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Lỗi: {ex.Message}", Severity.Error);
        }
        finally
        {
            isLoading = false;
        }
    }


    private async Task LoadRevenueChart(string mode)
    {
        chartMode = mode;
        isChartLoading = true;

        try
        {
            var url = $"Hotel/revenue-chart?hotelId={HotelId}&viewType={mode}";
            var res = await _httpClient!.GetFromJsonAsync<ApiResponse<List<RevenueChartVM>>>(url);

            if (res!.StatusCode == StatusCodeResponse.Success && res.Content != null)
            {
                var dataList = res.Content;

                // 1. Gán nhãn ngày (Trục ngang)
                XAxisLabels = dataList.Select((x, index) =>
                {
                    if (mode == "Month")
                    {
                        // Chỉ hiện label nếu index chia hết cho 4 (hoặc 5)
                        return (index % 4 == 0) ? x.Label : "";
                    }
                    return x.Label; // Week thì hiện hết
                }).ToArray();

                Series = new List<ChartSeries>()
                {
                    new ChartSeries()
                    {
                    Name = "Doanh thu (VNĐ)",
                    Data = dataList.Select(x => (double)x.Value).ToArray()
                    }
                };
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Lỗi tải biểu đồ: {ex.Message}", Severity.Error);
        }
        finally
        {
            isChartLoading = false;
        }
    }

    private async Task OpenBookingDetail(int bookingId)
    {
        // Gọi hàm ShowAsync trong Component OwnerBookingDetailModal
        await bookingModal.ShowAsync(bookingId);
    }

    private void UpdateChart()
    {
        if (stats == null) return;

        double maintenance = Math.Max(0, stats.TotalRooms - stats.AvailableRooms - stats.OccupiedRooms);
        chartData = new double[] { (double)stats.AvailableRooms, (double)stats.OccupiedRooms, maintenance };

        if (stats.TotalRooms > 0)
        {
            occupancyRate = Math.Round((double)stats.OccupiedRooms / stats.TotalRooms * 100, 1);
        }
    }

    private Color GetStatusColor(string status) => status switch
    {
        "Completed" => Color.Success,
        "Confirmed" => Color.Info,
        "CheckedIn" => Color.Primary,
        "PendingPayment" => Color.Warning,
        "Cancelled" => Color.Error,
        _ => Color.Default
    };

    private string GetStatusText(string status) => status switch
    {
        "Completed" => "Hoàn tất",
        "Confirmed" => "Đã xác nhận",
        "CheckedIn" => "Đã nhận phòng",
        "PendingPayment" => "Chờ thanh toán",
        "Cancelled" => "Đã hủy",
        _ => status
    };

    private string FormatCurrency(decimal amount)
    {
        return string.Format(new CultureInfo("vi-VN"), "{0:C0}", amount);
    }

    private string GetRelativeTime(DateTime date)
    {
        var span = DateTime.Now - date;
        if (span.TotalMinutes < 1) return "Vừa xong";
        if (span.TotalMinutes < 60) return $"{span.TotalMinutes:0} phút trước";
        if (span.TotalHours < 24) return $"{span.TotalHours:0} giờ trước";
        if (span.TotalDays < 7) return $"{span.TotalDays:0} ngày trước";
        return date.ToString("dd/MM/yyyy HH:mm");
    }
}