<style>
    .footer-links a {
        color: #b0c4de !important;
        text-decoration: none;
        transition: all 0.3s ease;
        display: inline-block;
    }
    .footer-links a:hover {
        color: white !important; /* Thêm hiệu ứng hover sáng lên */
    }

    .social-icon {
        width: 38px; height: 38px;
        background-color: rgba(255,255,255,0.08);
        color: white;
        text-decoration: none;
        transition: all 0.3s;
        border: 1px solid rgba(255,255,255,0.1);
    }
    .ls-1 { letter-spacing: 1px; font-size: 0.85rem; }
    .payment-icons i { color: #b0c4de; transition: 0.3s; cursor: pointer; }
    .payment-icons i:hover { color: white; }
    ::placeholder { color: #ced4da !important; opacity: 0.7; }
</style>

<PartnerPolicy @bind-IsVisible="_isOpenPolicy" />

@code {
    // Biến trạng thái để bật tắt modal
    private bool _isOpenPolicy = false;

    // Hàm được gọi khi nhấn vào link "Điều khoản & chính sách"
    private void OpenPolicy()
    {
        _isOpenPolicy = true;
    }
}