<footer class="text-white pt-5 pb-3" style="background-color: #0f2b4d !important; color: #eef2f6;">
    <div class="container">
        
        <div class="row border-bottom pb-4 mb-4 align-items-center" style="border-color: rgba(255,255,255,0.1) !important;">
            <div class="col-md-6">
                <h5 class="fw-bold mb-1 text-white">Đừng bỏ lỡ các ưu đãi đặc biệt!</h5>
                <p class="mb-0 small" style="color: #b0c4de;">Đăng ký nhận bản tin để nhận tin tức giảm giá mới nhất.</p>
            </div>
            <div class="col-md-6 mt-3 mt-md-0">
                <form class="d-flex" onsubmit="event.preventDefault();">
                    <input class="form-control me-2 border-0" style="background: rgba(255,255,255,0.1); color: #fff;" type="email" placeholder="Địa chỉ email của bạn..." aria-label="Email">
                    <button class="btn btn-primary px-4 shadow-sm fw-bold" type="button">Đăng ký</button>
                </form>
            </div>
        </div>

        <div class="row">
            <div class="col-lg-3 col-md-6 mb-4">
                <h4 class="fw-bold text-white mb-3" style="font-family: 'Pacifico', cursive;">ChillZone</h4>
                <p class="small" style="color: #b0c4de; line-height: 1.6;">
                    Nền tảng đặt phòng khách sạn trực tuyến hàng đầu, mang đến cho bạn những trải nghiệm nghỉ dưỡng tuyệt vời với chi phí tối ưu nhất.
                </p>
                <div class="d-flex gap-3 mt-3">
                     <a href="#" class="rounded-circle d-flex justify-content-center align-items-center social-icon">
                        <i class="bi bi-facebook"></i>
                     </a>
                     <a href="#" class="rounded-circle d-flex justify-content-center align-items-center social-icon">
                        <i class="bi bi-instagram"></i>
                     </a>
                     <a href="#" class="rounded-circle d-flex justify-content-center align-items-center social-icon">
                        <i class="bi bi-linkedin"></i>
                     </a>
                </div>
            </div>

            <div class="col-lg-3 col-md-6 mb-4">
                <h6 class="fw-bold text-uppercase text-white mb-3 ls-1">Thông tin</h6>
                <ul class="list-unstyled small footer-links">
                    <li class="mb-2"><a href="/gioi-thieu">Về chúng tôi</a></li>
                    <li class="mb-2"><a href="/Hotels">Đặt phòng ngay</a></li>
                    <li class="mb-2"><a href="/travel-guide/1">Cẩm nang du lịch</a></li>
                </ul>
            </div>

            <div class="col-lg-3 col-md-6 mb-4">
                <h6 class="fw-bold text-uppercase text-white mb-3 ls-1">Hỗ trợ & Chính sách</h6>
                <ul class="list-unstyled small footer-links">
                    <li class="mb-2"><a href="/contact">Trung tâm trợ giúp</a></li>
                    
                    <li class="mb-2">
                        <a @onclick="OpenPolicy" class="text-decoration-none" style="cursor: pointer; color: #b0c4de;">
                            Điều khoản & chính sách
                        </a>
                    </li>
                    <li class="mb-2"><a href="/customer-register">Đăng ký thành viên</a></li>
                </ul>
            </div>

            <div class="col-lg-3 col-md-6 mb-4">
                <h6 class="fw-bold text-uppercase text-white mb-3 ls-1">Liên hệ</h6>
                <ul class="list-unstyled small footer-links">
                    <li class="mb-2"><i class="bi bi-geo-alt me-2 text-primary"></i> TP. Hồ Chí Minh, Việt Nam</li>
                    <li class="mb-2"><a href="mailto:support@chillzone.com"><i class="bi bi-envelope me-2 text-primary"></i> support@chillzone.com</a></li>
                    <li class="mb-2"><a href="tel:0324123456"><i class="bi bi-telephone me-2 text-primary"></i> 0324 123 456</a></li>
                </ul>
                
                <h6 class="fw-bold text-uppercase mt-4 mb-3 ls-1">Thanh toán</h6>
                <div class="d-flex gap-2 payment-icons">
                    <i class="bi bi-credit-card-2-front fs-3" title="Visa/MasterCard"></i>
                    <i class="bi bi-paypal fs-3" title="Paypal"></i>
                    <i class="bi bi-cash-coin fs-3" title="Tiền mặt"></i>
                </div>
            </div>
        </div>
    </div>
