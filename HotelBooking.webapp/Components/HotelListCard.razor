@using HotelBooking.webapp.ViewModels.Hotel
@using MudBlazor
@inject NavigationManager NavigationManager

<MudPaper Class="d-flex p-3 rounded shadow-sm hover-elevation-6" Style="gap:1rem; cursor:pointer;"
    @onclick="() => GoToDetail(Hotel.HotelId)">
    <!-- Ảnh -->
    <div class="position-relative" style="width:250px; flex-shrink:0;">
        @if (Hotel.ImageUrls != null && Hotel.ImageUrls.Any())
        {
            <MudCarousel TData="string" Items="@(Hotel.ImageUrls.Take(4).ToList())" ShowArrows="true" AutoCycle="false">
                <ItemTemplate Context="img">
                    <MudImage Src="@img" Alt="@Hotel.HotelName" />
                </ItemTemplate>
            </MudCarousel>
        }
        else
        {
            <MudImage Src="/images/default-Hotels.jpg" Alt="@Hotel.HotelName" />
        }

        <!-- Wishlist -->
        <MudTooltip Text="@(Hotel.IsWishlist ? "Xóa khỏi yêu thích" : "Thêm vào yêu thích")">
            <MudButton Class="position-absolute top-0 end-0 m-2 rounded-circle bg-white shadow-sm"
                Style="width:40px; height:40px; min-width:40px;" Size="Size.Small" Disabled="@isToggling"
                @onclick="HandleWishlistClick" Variant="Variant.Outlined">
                <MudIcon Icon="@(Hotel.IsWishlist ? Icons.Material.Filled.Favorite : 
                                             Icons.Material.Outlined.FavoriteBorder)"
                    Color="@(Hotel.IsWishlist ? Color.Error : Color.Default)" />
            </MudButton>
        </MudTooltip>
    </div>

    <!-- Thông tin -->
    <div class="d-flex flex-column flex-grow-1 justify-content-between">
        <MudText Typo="Typo.h6" Class="fw-bold mb-1">@Hotel.HotelName</MudText>
        <MudText Typo="Typo.subtitle2" Color="Color.Secondary" Class="mb-2">@Hotel.City</MudText>
        <MudText Typo="Typo.body2" Class="mb-1">@Hotel.Address</MudText>
        <!-- Highlight Amenities -->
        <div class="d-flex flex-wrap gap-1 mb-2">
            @foreach (var amenity in Hotel.HighlightAmenities)
            {
                <MudChip T="string" Color="Color.Default" Size="Size.Small"
                    Style="background:none; margin-left: 0; padding-left: 0">
                    <MudIcon Icon="@amenity.IconClass" Size="Size.Small" Class="mr-2"
                        Style="@($"color:{amenity.IconColor}; font-size: 1rem;")" />
                    <span
                        style="font-size: 1rem; font-weight: 500; color: #333; vertical-align: middle;">@amenity.Name</span>
                </MudChip>
            }
        </div>

        <!-- Rate + Price -->
        <div class="d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center gap-2">
                <MudPaper Class="bg-success text-white rounded px-2 py-1">
                    @Hotel.AverageRating.ToString("0.0")
                </MudPaper>
                <MudText Typo="Typo.body2" Class="fw-bold">
                    @GetRatingText(Hotel.AverageRating)
                </MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    (@Hotel.ReviewCount đánh giá)
                </MudText>
            </div>
            <div class="text-end">
                @if (Hotel.IsBookable)
                {
                    @if (Hotel.MinPricePerNight.HasValue)
                    {
                        <MudText Typo="Typo.subtitle1" Class="fw-bold text-dark">
                            @($"{Hotel.MinPricePerNight?.ToString("#,##0")} ₫ / đêm")
                        </MudText>
                    }
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" Class="mt-1">
                        Xem phòng
                    </MudButton>
                }
                else
                {
                    <MudAlert Severity="Severity.Warning" Dense="true" Class="pa-2">
                        <b>Hết phòng</b>
                    </MudAlert>
                }
            </div>
        </div>
    </div>
</MudPaper>

@code {
    [Parameter] public HotelListItemVM Hotel { get; set; } = null!;
    [Parameter] public EventCallback<int> OnWishlistToggle { get; set; }

    private bool isToggling;

    private async Task HandleWishlistClick()
    {
        if (isToggling) return;
        isToggling = true;
        try
        {
            if (OnWishlistToggle.HasDelegate)
                await OnWishlistToggle.InvokeAsync(Hotel.HotelId);
        }
        finally
        {
            isToggling = false;
            StateHasChanged();
        }
    }

    private void GoToDetail(int hotelId)
    {
        NavigationManager.NavigateTo($"/Hotel/{hotelId}");
    }

    private string GetRatingText(decimal Rating)
    {
        return Rating switch
        {
            >= 8.5m => "Excellent",
            >= 7.0m => "Very Good",
            >= 5.5m => "Good",
            >= 4.0m => "Average",
            _ => "Poor"
        };
    }
}