@using Blazored.LocalStorage
@using HotelBooking.webapp.ViewModels.Hotel
@using MudBlazor
@inject NavigationManager NavigationManager
@inject ILocalStorageService _localStorage
@inject AuthenticationStateProvider _auth
@inject ISnackbar Snackbar

<MudPaper Class="d-flex p-3 rounded shadow-sm hover-elevation-6" Style="gap:1rem; cursor:pointer;"
    @onclick="() => GoToDetail(Hotel.HotelId)">

    <div class="position-relative rounded overflow-hidden" style="width:250px; height: 200px; flex-shrink:0;">

        @if (displayImages.Count > 1)
        {
            <MudCarousel Class="h-100 w-100" ShowArrows="true" ShowBullets="false" AutoCycle="false" TData="object">
                @foreach (var img in displayImages)
                {
                    <MudCarouselItem>
                        <div class="h-100 w-100">
                            <img src="@img" alt="@Hotel.HotelName" style="width:100%; height:100%; object-fit:cover;" />
                        </div>
                    </MudCarouselItem>
                }
            </MudCarousel>
        }
        else
        {
            <img src="@displayImages.FirstOrDefault()" alt="@Hotel.HotelName"
                style="width:100%; height:100%; object-fit:cover;" />
        }


        <div class="position-absolute top-0 end-0 m-2" style="z-index: 10;" @onclick:stopPropagation="true">
            <MudButton Class="rounded-circle bg-white shadow-sm" Style="width:40px; height:40px; min-width:40px;"
                Size="Size.Small" Disabled="@isToggling" OnClick="HandleWishlistClick" Variant="MudBlazor.Variant.Outlined">
                <MudIcon
                    Icon="@(Hotel.IsWishlist ? Icons.Material.Filled.Favorite : Icons.Material.Outlined.FavoriteBorder)"
                    Color="@(Hotel.IsWishlist ? Color.Error : Color.Default)" />
            </MudButton>
        </div>
    </div>

    <div class="d-flex flex-column flex-grow-1 justify-content-between">
        <MudText Typo="Typo.h6" Class="fw-bold mb-1">@Hotel.HotelName</MudText>
        <MudText Typo="Typo.subtitle2" Color="Color.Secondary" Class="mb-2">@Hotel.City</MudText>
        <MudText Typo="Typo.body2" Class="mb-1">@Hotel.Address</MudText>

        <div class="d-flex flex-wrap gap-1 mb-2">
            @foreach (var amenity in Hotel.HighlightAmenities)
            {
                <MudChip T="string" Color="Color.Default" Size="Size.Small"
                    Style="background:none; margin-left: 0; padding-left: 0">
                    <MudIcon Icon="@amenity.IconClass" Size="Size.Small" Class="mr-2"
                        Style="@($"color:{amenity.IconColor}; font-size: 1rem;")" />
                    <span
                        style="font-size: 1rem; font-weight: 500; color: #333; vertical-align: middle;">@amenity.Name</span>
                </MudChip>
            }
        </div>

        <div class="d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center gap-2">
                <MudPaper Class="bg-success text-white rounded px-2 py-1">
                    @Hotel.AverageRating.ToString("0.0")
                </MudPaper>
                <MudText Typo="Typo.body2" Class="fw-bold">
                    @GetRatingText(Hotel.AverageRating)
                </MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    (@Hotel.ReviewCount đánh giá)
                </MudText>
            </div>
            <div class="text-end">
                @if (Hotel.IsBookable)
                {
                    @if (Hotel.MinPricePerNight.HasValue)
                    {
                        <MudText Typo="Typo.subtitle1" Class="fw-bold text-dark">
                            @($"{Hotel.MinPricePerNight?.ToString("#,##0")} ₫ / đêm")
                        </MudText>
                    }
                }
                else
                {
                    <MudAlert Severity="Severity.Warning" Dense="true" Class="pa-2">
                        <b>Hết phòng</b>
                    </MudAlert>
                }
            </div>
        </div>
    </div>
</MudPaper>

@code {
    [Parameter] public HotelListItemVM Hotel { get; set; } = null!;
    [Parameter] public EventCallback<int> OnWishlistToggle { get; set; }

    private bool isToggling;
    private List<string> displayImages = new();
    protected override void OnParametersSet()
    {
        displayImages = GetDisplayImages();
    }
    private List<string> GetDisplayImages()
    {
        var images = new List<string>();

        // 1. Ưu tiên CoverImageUrl
        if (!string.IsNullOrWhiteSpace(Hotel.CoverImageUrl))
        {
            images.Add(Hotel.CoverImageUrl);
        }

        // 2. Thêm các ảnh khác từ ImageUrls (loại trùng)
        if (Hotel.ImageUrls != null && Hotel.ImageUrls.Any())
        {
            images.AddRange(Hotel.ImageUrls
            .Where(u => !string.IsNullOrWhiteSpace(u) && !images.Contains(u))
            .Take(5));
        }

        // 3. Nếu vẫn không có ảnh → dùng placeholder
        if (images.Count == 0)
        {
            images.Add("/images/default-Hotels.jpg");
        }

        return images;
    }
    private async Task HandleWishlistClick()
    {
        if (isToggling) return;
        var authState = await _auth.GetAuthenticationStateAsync();
        if (authState.User?.Identity?.IsAuthenticated != true)
        {
            Snackbar.Add("Bạn cần đăng nhập để lưu vào yêu thích!", Severity.Warning);
            // Optional: _nav.NavigateTo("/customer-login");
            return;
        }

        isToggling = true;
        try
        {
            if (OnWishlistToggle.HasDelegate)
                await OnWishlistToggle.InvokeAsync(Hotel.HotelId);
        }
        finally
        {
            isToggling = false;
        }
    }

    private void GoToDetail(int hotelId)
    {
        NavigationManager.NavigateTo($"/Hotel/{hotelId}");
    }

    private string GetRatingText(decimal Rating)
    {
        return Rating switch
        {
            >= 8.5m => "Excellent",
            >= 7.0m => "Very Good",
            >= 5.5m => "Good",
            >= 4.0m => "Average",
            _ => "Poor"
        };
    }
}