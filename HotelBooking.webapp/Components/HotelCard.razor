@using HotelBooking.webapp.ViewModels.Hotel
@using MudBlazor
@inject NavigationManager _nav
@inject AuthenticationStateProvider _auth
@inject ISnackbar Snackbar

<MudPaper Class="p-3 mb-3 rounded hotel-card-container shadow-sm d-flex flex-column hotel-card-half-color"
    Style="position: relative; cursor:pointer; height: 100%; min-height: 350px;" @onclick="() => GoToDetail(Hotel.HotelId)">

    <div class="position-relative mb-3 rounded" style="width: 100%; height: 220px; flex-shrink: 0;">
        
        @if (displayImages.Count > 1)
        {
            <MudCarousel Class="h-100 w-100" ShowArrows="true" ShowBullets="false" AutoCycle="false" TData="object">
                @foreach (var img in displayImages)
                {
                    <MudCarouselItem>
                        <div class="h-100 w-100">
                            <img src="@img" alt="@Hotel.HotelName" style="width:100%; height:100%; object-fit:cover;" />
                        </div>
                    </MudCarouselItem>
                }
            </MudCarousel>
        }
        else
        {
            <img src="@displayImages.FirstOrDefault()" alt="@Hotel.HotelName"
                 style="width:100%; height:100%; object-fit:cover;" />
        }

        <div class="position-absolute top-0 end-0 m-2" style="z-index: 10;" @onclick:stopPropagation="true">
            <MudButton Size="Size.Small" Disabled="@isToggling" OnClick="HandleWishlistToggle" Variant="MudBlazor.Variant.Filled"
                Color="@(Hotel.IsWishlist ? Color.Error : Color.Surface)" Class="rounded-circle shadow-sm"
                Style="min-width: 36px; width: 36px; height: 36px; padding: 0;">
                <MudIcon
                    Icon="@(Hotel.IsWishlist ? Icons.Material.Filled.Favorite : Icons.Material.Outlined.FavoriteBorder)"
                    Size="Size.Small" />
            </MudButton>
        </div>
    </div>

    <MudText Typo="Typo.h6" Class="fw-bold mb-1 text-truncate">@Hotel.HotelName</MudText>
    <MudText Typo="Typo.body2" Class="mb-1 text-truncate" Color="Color.Secondary">@Hotel.Address</MudText>
    <MudText Typo="Typo.body2">@Hotel.City @Hotel.Country</MudText>

    <div class="d-flex align-items-center mb-3 mt-1">
        <div class="d-flex align-items-center gap-1">
            @for (int i = 1; i <= 5; i++)
            {
                <MudIcon Icon="@GetStarIcon(i)" Color="@GetStarColor(i)" Style="font-size:1rem;" />
            }
        </div>
        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="ms-2">
            (@Hotel.ReviewCount reviews)
        </MudText>
    </div>

    <div class="text-start mt-3" style="height: 20px;">
        @if (Hotel.MinPricePerNight.HasValue)
        {
            @if (Hotel.MaxPricePerNight.HasValue && Hotel.MinPricePerNight < Hotel.MaxPricePerNight)
            {
                <MudText Typo="Typo.h6" Class="fw-bold text-success mb-0" Style="line-height: 1.2;">
                    @Hotel.MinPricePerNight.Value.ToString("C0", new System.Globalization.CultureInfo("vi-VN"))
                </MudText>
                <MudText Typo="Typo.caption" Class="text-decoration-line-through text-muted">
                    @Hotel.MaxPricePerNight.Value.ToString("C0", new System.Globalization.CultureInfo("vi-VN"))
                </MudText>
            }
            else
            {
                <MudText Typo="Typo.h6" Class="fw-bold text-dark mb-0" Style="line-height: 1.2;">
                    @Hotel.MinPricePerNight.Value.ToString("C0", new System.Globalization.CultureInfo("vi-VN"))
                </MudText>
                <div style="height: 18px;"></div>
            }
        }
        else
        {
            <MudText Typo="Typo.body2" Color="Color.Secondary">Chưa có giá</MudText>
        }
    </div>
</MudPaper>


<style>
  /* 1. Đảm bảo Card tuân thủ width của scroll-item và không bị nội dung đẩy phình ra */
  .hotel-card-container {
    width: 100% !important;
    min-width: 0 !important;
    /* Quan trọng: Cho phép card co lại đúng calc của scroll-item */
    height: 100%;
    display: flex;
    flex-direction: column;
    transition: transform 0.2s;
  }

  /* 2. Cố định dòng cho Tên khách sạn (1 dòng) */
  .hotel-name-limit {
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-overflow: ellipsis;
    height: 1.5rem;
    /* Cố định chiều cao dòng */
    line-height: 1.5rem;
  }

  /* 3. Cố định dòng cho Địa chỉ (2 dòng) giúp các card cao bằng nhau */
  .hotel-address-limit {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-overflow: ellipsis;
    height: 3rem;
    /* (1.5rem * 2) */
    line-height: 1.5rem;
    font-size: 0.875rem;
  }
</style>

@code {
    [Parameter] public HotelListItemVM Hotel { get; set; } = null!;
    [Parameter] public EventCallback<int> OnWishlistToggle { get; set; }
    private bool isToggling = false;
    private List<string> displayImages = new();

    // Tính toán sao (5 sao)
    private double StarRating => (double)Hotel.AverageRating / 2.0;

    protected override void OnParametersSet()
    {
        displayImages = GetDisplayImages();
    }
    private string GetStarIcon(int starIndex)
    {
        if (starIndex <= Math.Floor(StarRating))
            return Icons.Material.Filled.Star;
        if (starIndex <= Math.Ceiling(StarRating))
            return Icons.Material.Filled.StarHalf;
        return Icons.Material.Filled.StarBorder;
    }

    private Color GetStarColor(int starIndex)
    {
        return starIndex <= Math.Ceiling(StarRating) ? Color.Warning : Color.Default;
    }

    // Lấy danh sách ảnh hiển thị theo ưu tiên
    private List<string> GetDisplayImages()
    {
        var images = new List<string>();

        // 1. Ưu tiên CoverImageUrl
        if (!string.IsNullOrWhiteSpace(Hotel.CoverImageUrl))
        {
            images.Add(Hotel.CoverImageUrl);
        }

        // 2. Thêm các ảnh khác từ ImageUrls (loại trùng)
        if (Hotel.ImageUrls != null && Hotel.ImageUrls.Any())
        {
            images.AddRange(Hotel.ImageUrls
            .Where(u => !string.IsNullOrWhiteSpace(u) && !images.Contains(u))
            .Take(5));
        }

        // 3. Nếu vẫn không có ảnh → dùng placeholder
        if (images.Count == 0)
        {
            images.Add("/images/default-Hotels.jpg");
        }

        return images;
    }

    private async Task HandleWishlistToggle()
    {
        if (isToggling) return;

        var authState = await _auth.GetAuthenticationStateAsync();
        if (authState.User?.Identity?.IsAuthenticated != true)
        {
            Snackbar.Add("Bạn cần đăng nhập để lưu vào yêu thích!", Severity.Warning);
            return;
        }

        isToggling = true;
        try
        {
            if (OnWishlistToggle.HasDelegate)
                await OnWishlistToggle.InvokeAsync(Hotel.HotelId);
        }
        finally
        {
            isToggling = false;
        }
    }

    private void GoToDetail(int hotelId)
    {
        _nav.NavigateTo($"/Hotel/{hotelId}");
    }
}