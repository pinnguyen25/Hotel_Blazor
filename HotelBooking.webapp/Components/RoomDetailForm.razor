@using Blazored.LocalStorage
@using HotelBooking.webapp.ViewModels.Hotel
@inject IHttpClientFactory _httpClientFactory
@inject ILocalStorageService _localStorage
@inject ISnackbar Snackbar
@inject AuthenticationStateProvider _authStateProvider
@if (Show)
{
    <div class="modal-backdrop fade show" style="background-color: rgba(0,0,0,0.5);"></div>
    <div class="modal fade show d-block" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg">

                <div class="modal-header text-white @GetHeaderClass()" style="border-bottom: none;">
                    <div>
                        <div class="text-uppercase small fw-bold opacity-75 mb-1">@GetStatusLabel(Room.Status)</div>
                        <h4 class="modal-title fw-bold"><i class="bi bi-door-closed me-2"></i>Phòng @Room.RoomNumber</h4>
                    </div>
                    <button type="button" class="btn-close btn-close-white" @onclick="Close"></button>
                </div>

                <div class="modal-body bg-light p-4">
                    <div class="d-flex justify-content-center mb-4">
                        <div class="d-flex gap-2 bg-white rounded-pill p-1 shadow-sm border">

                            <button type="button"
                                class="btn btn-sm rounded-pill px-4 transition-all @(activeTab == "operation" ? "btn-primary shadow-sm fw-bold" : "btn-light text-muted bg-transparent border-0")"
                                @onclick='() => activeTab = "operation"'>
                                <i class="bi bi-layers-fill me-1"></i> Nghiệp vụ
                            </button>

                            @if (IsOwner)
                            {
                                <button type="button"
                                    class="btn btn-sm rounded-pill px-4 transition-all @(activeTab == "edit" ? "btn-primary shadow-sm fw-bold" : "btn-light text-muted bg-transparent border-0")"
                                    @onclick='() => activeTab = "edit"'>
                                    <i class="bi bi-gear-fill me-1"></i> Cấu hình
                                </button>
                            }

                        </div>
                    </div>

                    <div class="card border-0 shadow-sm">
                        <div class="card-body p-4">

                            @if (activeTab == "operation")
                            {
                                @if (Room.Status == "Available")
                                {
                                    <div class="text-center mb-4">
                                        <div class="avatar-md bg-success-subtle text-success rounded-circle mx-auto mb-3 d-flex align-items-center justify-content-center"
                                            style="width: 60px; height: 60px;">
                                            <i class="bi bi-check-lg fs-2"></i>
                                        </div>
                                        <h5>Sẵn sàng đón khách</h5>
                                        <p class="text-muted small">Chọn khách từ danh sách chờ để gán phòng.</p>
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label fw-bold small text-muted">DANH SÁCH CHỜ</label>
                                        @if (PendingBookings == null)
                                        {
                                            <div class="text-center">
                                                <div class="spinner-border spinner-border-sm"></div> Loading...
                                            </div>
                                        }
                                        else if (!PendingBookings.Any())
                                        {
                                            <div class="alert alert-secondary text-center small">Không có khách nào đang chờ check-in.
                                            </div>
                                        }
                                        else
                                        {
                                            <select class="form-select form-select-lg mb-3" @bind="SelectedBookingRoomId">
                                                <option value="0">-- Chọn khách hàng --</option>
                                                @foreach (var booking in PendingBookings)
                                                {
                                                    <option value="@booking.Id">
                                                        @booking.GuestName (@booking.RoomTypeName) | @booking.CheckIn.ToString("dd/MM") -
                                                        @booking.CheckOut.ToString("dd/MM") | @booking.Price.ToString("N0")đ
                                                    </option>
                                                }
                                            </select>
                                            <button class="btn btn-success w-100 py-2 fw-bold shadow-sm" @onclick="HandleAssignRoom"
                                                disabled="@(SelectedBookingRoomId == 0)">
                                                <i class="bi bi-box-arrow-in-right me-2"></i> Gán phòng ngay
                                            </button>
                                        }
                                    </div>

                                }

                                else if (Room.Status == "Reserved")
                                {
                                    <div class="text-center mb-4">
                                        <div class="avatar-md bg-info-subtle text-info rounded-circle mx-auto mb-3 d-flex align-items-center justify-content-center"
                                            style="width: 60px; height: 60px;">
                                            <i class="bi bi-calendar-check fs-2"></i>
                                        </div>
                                        <h5>Phòng đã đặt trước</h5>
                                        <p class="text-muted small">Khách hàng sẽ đến trong hôm nay.</p>
                                    </div>

                                    <div class="bg-light rounded p-3 mb-3 border">
                                        <div class="d-flex align-items-center">
                                            <i class="bi bi-person-circle fs-3 text-secondary me-3"></i>
                                            <div>
                                                <div class="fw-bold">@Room.CurrentGuestName</div>
                                                <div class="small text-muted">Check-in dự kiến:
                                                    @Room.CurrentCheckIn?.ToString("dd/MM/yyyy")</div>
                                            </div>
                                        </div>
                                    </div>

                                    <button class="btn btn-primary w-100 py-2 fw-bold shadow-sm" @onclick="HandleManualCheckIn">
                                        <i class="bi bi-check-circle-fill me-2"></i> Xác nhận khách đã đến (Check-in)
                                    </button>
                                }

                                else if (Room.Status == "Occupied")
                                {
                                    <div class="bg-light rounded p-3 mb-4 border">
                                        <div class="d-flex justify-content-between align-items-start mb-2">
                                            <small class="text-uppercase fw-bold text-muted">Thông tin khách</small>
                                            @if (!isEditingName)
                                            {
                                                <button class="btn btn-link btn-sm p-0 text-decoration-none" @onclick="StartEditName">
                                                    <i class="bi bi-pencil-square"></i> Sửa tên
                                                </button>
                                            }
                                        </div>

                                        @if (isEditingName)
                                        {
                                            <div class="input-group input-group-sm mb-2">
                                                <input type="text" class="form-control" @bind="tempGuestName" />
                                                <button class="btn btn-primary" @onclick="SaveGuestName"><i
                                                        class="bi bi-check"></i></button>
                                                <button class="btn btn-outline-secondary" @onclick="() => isEditingName = false"><i
                                                        class="bi bi-x"></i></button>
                                            </div>
                                        }
                                        else
                                        {
                                            <h5 class="fw-bold text-dark mb-3">@(Room.CurrentGuestName ?? "Khách lẻ")</h5>
                                        }

                                        <div class="row g-2 small">
                                            <div class="col-6">
                                                <div class="text-muted mb-1">Check-in</div>
                                                <div class="fw-bold"><i
                                                        class="bi bi-calendar-check me-1"></i>@Room.CurrentCheckIn?.ToString("dd/MM/yyyy")
                                                </div>
                                            </div>
                                            <div class="col-6">
                                                <div class="text-muted mb-1">Check-out</div>
                                                <div class="fw-bold text-danger"><i
                                                        class="bi bi-calendar-x me-1"></i>@Room.CurrentCheckOut?.ToString("dd/MM/yyyy")
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    @if (Room.CurrentCheckOut.HasValue)
                                    {
                                        var daysLeft = (Room.CurrentCheckOut.Value.Date - DateTime.Now.Date).Days;
                                        <div class="text-center mb-3">
                                            <span class="badge bg-info-subtle text-info rounded-pill px-3">
                                                @(daysLeft > 0 ? $"Còn {daysLeft} ngày lưu trú" : "Đã đến hạn trả phòng")
                                            </span>
                                        </div>
                                    }

                                    <div class="d-grid gap-2 mb-3">
                                        <button class="btn btn-outline-primary fw-bold shadow-sm" @onclick="OpenAddServiceModal">
                                            <i class="bi bi-cart-plus me-2"></i> Thêm dịch vụ (Nước, Giặt...)
                                        </button>

                                        <button class="btn btn-danger fw-bold shadow-sm" @onclick="HandleCheckout" ...>
                                            <i class="bi bi-box-arrow-right me-2"></i> Trả phòng & Thanh toán
                                        </button>
                                    </div>
                                }

                                else if (Room.Status == "Cleaning")
                                {
                                    <div class="text-center py-3">
                                        <div class="avatar-md bg-warning-subtle text-warning rounded-circle mx-auto mb-3 d-flex align-items-center justify-content-center"
                                            style="width: 60px; height: 60px;">
                                            <i class="bi bi-stars fs-2"></i>
                                        </div>
                                        <h5 class="text-dark">Phòng cần dọn dẹp</h5>
                                        <p class="text-muted small mb-4">Khách đã trả phòng. Vui lòng dọn dẹp trước khi mở bán lại.
                                        </p>

                                        @if (!showAssignSection)
                                        {
                                            <div class="d-grid gap-2">
                                                <button class="btn btn-success fw-bold" @onclick="HandleQuickClean">
                                                    <i class="bi bi-check-circle me-2"></i> Đã dọn xong (Owner tự làm)
                                                </button>
                                                <button class="btn btn-outline-primary" @onclick="LoadStaffsForAssign">
                                                    <i class="bi bi-person-badge me-2"></i> Giao cho nhân viên
                                                </button>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="card bg-light border-0 p-3 animate__animated animate__fadeIn">
                                                <h6 class="fw-bold text-start mb-2 small text-muted">CHỌN NHÂN VIÊN:</h6>
                                                <select class="form-select mb-3" @bind="SelectedStaffId">
                                                    <option value="0">-- Chọn nhân viên --</option>
                                                    @foreach (var s in AvailableStaffs)
                                                    {
                                                        <option value="@s.Id">@s.FullName (@s.Position)</option>
                                                    }
                                                </select>
                                                <div class="d-flex gap-2">
                                                    <button class="btn btn-secondary flex-fill"
                                                        @onclick="() => showAssignSection = false">Hủy</button>
                                                    <button class="btn btn-primary flex-fill fw-bold" disabled="@(SelectedStaffId == 0)"
                                                        @onclick="HandleAssignTask">Giao ngay</button>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }

                                else if (Room.Status == "Maintenance")
                                {
                                    <div class="text-center py-4">
                                        <i class="bi bi-cone-striped text-secondary display-4 mb-3"></i>
                                        <h5>Đang bảo trì</h5>
                                        <button class="btn btn-success mt-3" @onclick="HandleFinishMaintenance">
                                            <i class="bi bi-check-lg me-2"></i> Hoàn tất bảo trì
                                        </button>
                                    </div>
                                }
                            }
                            else if (activeTab == "edit" && IsOwner)
                            {
                                <h6 class="fw-bold mb-3">Cập nhật thông tin phòng</h6>
                                <div class="mb-3">
                                    <label class="form-label small text-muted">Số phòng / Tên phòng</label>
                                    <input type="text" class="form-control" @bind="EditRoomNumber" />
                                </div>
                                <div class="mb-4">
                                    <label class="form-label small text-muted">Trạng thái thủ công</label>
                                    <select class="form-select" @bind="EditStatus">
                                        <option value="Available">Sẵn sàng</option>
                                        <option value="Maintenance">Đang bảo trì</option>
                                        <option value="Cleaning">Chưa dọn</option>
                                    </select>
                                    <div class="form-text text-warning small"><i class="bi bi-exclamation-triangle"></i> Lưu ý:
                                        Thay đổi trạng thái thủ công có thể ảnh hưởng đến quy trình dọn dẹp.</div>
                                </div>

                                <div class="d-flex justify-content-between pt-3 border-top">
                                    <button class="btn btn-outline-danger btn-sm" @onclick="HandleDeleteRoom">
                                        <i class="bi bi-trash me-1"></i> Xóa phòng này
                                    </button>
                                    <button class="btn btn-primary" @onclick="HandleUpdateRoom">
                                        <i class="bi bi-save me-1"></i> Lưu thay đổi
                                    </button>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@if (showInvoiceModal && currentInvoice != null)
{
    <div class="modal-backdrop fade show" style="z-index: 1060;"></div>

    <div class="modal fade show d-block" style="z-index: 1070;" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered modal-lg"> 
            <div class="modal-content shadow-lg border-0">
                
                <div class="modal-header bg-primary text-white py-3">
                    <div>
                        <h5 class="modal-title fw-bold mb-0"><i class="bi bi-receipt-cutoff me-2"></i>Hóa đơn thanh toán</h5>
                        <small class="opacity-75">Mã đơn: #@currentInvoice.GuestName</small>
                    </div>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => showInvoiceModal = false"></button>
                </div>

                <div class="modal-body p-0 bg-light">
                    <div class="row g-0">
                        
                        <div class="col-md-8 p-4 bg-white" style="max-height: 70vh; overflow-y: auto;">
                            
                            <div class="d-flex align-items-center mb-4 p-3 bg-light rounded border">
                                <div class="bg-white p-2 rounded-circle shadow-sm me-3 text-primary">
                                    <i class="bi bi-person-vcard fs-3"></i>
                                </div>
                                <div>
                                    <h6 class="fw-bold mb-1">@currentInvoice.GuestName</h6>
                                    <div class="small text-muted">
                                        <i class="bi bi-telephone me-1"></i> @(string.IsNullOrEmpty(currentInvoice.PhoneNumber) ? "Chưa cập nhật SĐT" : currentInvoice.PhoneNumber)
                                        <span class="mx-2">|</span>
                                        <i class="bi bi-calendar-range me-1"></i> @currentInvoice.CheckIn.ToString("dd/MM") - @currentInvoice.CheckOut.ToString("dd/MM")
                                        <span class="fw-bold text-primary">(@currentInvoice.TotalNights đêm)</span>
                                    </div>
                                </div>
                            </div>

                            <h6 class="text-uppercase fw-bold text-muted small mb-3 border-bottom pb-2">
                                <i class="bi bi-houses me-1"></i> Chi tiết phòng (@currentInvoice.RoomDetails?.Count)
                            </h6>
                            
                            <div class="mb-4">
                                @if (currentInvoice.RoomDetails != null)
                                {
                                    @foreach (var room in currentInvoice.RoomDetails)
                                    {
                                        <div class="d-flex justify-content-between align-items-center mb-2 p-2 rounded hover-bg-light">
                                            <div>
                                                <span class="fw-bold text-dark">@room.RoomTypeName</span>
                                            </div>
                                            <div class="text-end">
                                                <div class="fw-bold">@((room.Price * currentInvoice.TotalNights).ToString("N0")) đ</div>
                                                <small class="text-muted">@room.Price.ToString("N0") x @currentInvoice.TotalNights đêm</small>
                                            </div>
                                        </div>
                                    }
                                    <div class="d-flex justify-content-between border-top pt-2 mt-2">
                                        <span class="fw-bold text-secondary">Tổng tiền phòng</span>
                                        <span class="fw-bold">@currentInvoice.RoomTotal.ToString("N0") đ</span>
                                    </div>
                                }
                            </div>

                            <h6 class="text-uppercase fw-bold text-muted small mb-3 border-bottom pb-2">
                                <i class="bi bi-cup-straw me-1"></i> Dịch vụ sử dụng
                            </h6>
                            
                            @if (currentInvoice.Services != null && currentInvoice.Services.Any())
                            {
                                <table class="table table-hover table-sm">
                                    <thead class="table-light text-muted small">
                                        <tr>
                                            <th>Tên dịch vụ</th>
                                            <th class="text-center">SL</th>
                                            <th class="text-end">Đơn giá</th>
                                            <th class="text-end">Thành tiền</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var s in currentInvoice.Services)
                                        {
                                            <tr>
                                                <td>
                                                    @s.ServiceName
                                                    @if (s.IsPaid) { <span class="badge bg-success ms-1" style="font-size: 0.6rem;">Đã trả</span> }
                                                </td>
                                                <td class="text-center">@s.Quantity</td>
                                                <td class="text-end text-muted small">@s.Price.ToString("N0")</td>
                                                <td class="text-end fw-bold">
                                                    @if(s.IsPaid) { <span class="text-decoration-line-through text-muted">@s.Total.ToString("N0")</span> }
                                                    else { <span>@s.Total.ToString("N0")</span> }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            }
                            else
                            {
                                <div class="text-muted small fst-italic py-2">Khách không sử dụng thêm dịch vụ nào.</div>
                            }
                        </div>

                        <div class="col-md-4 bg-light border-start">
                            <div class="p-4 h-100 d-flex flex-column">
                                <h6 class="fw-bold mb-4">Tổng kết thanh toán</h6>

                                <div class="d-flex justify-content-between mb-2">
                                    <span class="text-muted">Tổng cộng</span>
                                    <span class="fw-bold">@currentInvoice.GrandTotal.ToString("N0")</span>
                                </div>
                                <div class="d-flex justify-content-between mb-3 text-success">
                                    <span>Đã trả trước</span>
                                    <span>-@currentInvoice.PaidAmount.ToString("N0")</span>
                                </div>

                                <div class="p-3 bg-white border border-danger rounded mb-4 shadow-sm">
                                    <div class="text-center text-danger text-uppercase small fw-bold mb-1">Cần thanh toán</div>
                                    <div class="text-center text-danger display-6 fw-bold">@currentInvoice.RemainingAmount.ToString("N0")</div>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label small fw-bold">Khách đưa (VNĐ)</label>
                                    <input type="text" 
                                        class="form-control form-control-lg fw-bold text-end text-primary" 
                                        @bind="AmountPaidString" 
                                        @bind:event="oninput"
                                        placeholder="0" />
                                    
                                    <div class="form-text text-end small fst-italic">
                                        @amountPaid.ToString("N0") VNĐ
                                    </div>
                                </div>

                                <div class="mb-4">
                                    <label class="form-label small fw-bold">Phương thức</label>
                                    <div class="btn-group w-100" role="group">
                                        <input type="radio" class="btn-check" name="pm" id="pmCash" autocomplete="off" 
                                               checked="@(paymentMethod == "Cash")" @onchange='() => paymentMethod = "Cash"'>
                                        <label class="btn btn-outline-secondary" for="pmCash"><i class="bi bi-cash me-1"></i>Tiền mặt</label>

                                        <input type="radio" class="btn-check" name="pm" id="pmBank" autocomplete="off"
                                               checked="@(paymentMethod == "Banking")" @onchange='() => paymentMethod = "Banking"'>
                                        <label class="btn btn-outline-secondary" for="pmBank"><i class="bi bi-bank me-1"></i>CK</label>
                                    </div>
                                </div>

                                @if(amountPaid > currentInvoice.RemainingAmount)
                                {
                                    <div class="alert alert-success py-2 px-3 small mb-3">
                                        <div class="d-flex justify-content-between fw-bold">
                                            <span>Tiền thừa trả khách:</span>
                                            <span>@((amountPaid - currentInvoice.RemainingAmount).ToString("N0"))</span>
                                        </div>
                                    </div>
                                }

                                <div class="mt-auto">
                                    <button class="btn btn-primary w-100 py-3 fw-bold shadow-sm" @onclick="SubmitPayment" disabled="@isSubmitting">
                                        @if(isSubmitting)
                                        {
                                            <span class="spinner-border spinner-border-sm me-2"></span> <span>Đang xử lý...</span>
                                        }
                                        else
                                        {
                                            <span><i class="bi bi-check-circle-fill me-2"></i> HOÀN TẤT THANH TOÁN</span>
                                        }
                                    </button>
                                    <button class="btn btn-link text-muted w-100 mt-2 text-decoration-none small" 
                                            @onclick="() => showInvoiceModal = false">Đóng, không thanh toán</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@if (showAddServiceModal)
{
    <div class="modal-backdrop fade show" style="z-index: 1080;"></div>
    <div class="modal fade show d-block" style="z-index: 1090;" tabindex="-1">
        <div class="modal-dialog modal-sm modal-dialog-centered">
            <div class="modal-content shadow border-0">
                <div class="modal-header bg-primary text-white py-2">
                    <h6 class="modal-title fw-bold"><i class="bi bi-plus-circle me-2"></i>Thêm dịch vụ</h6>
                    <button type="button" class="btn-close btn-close-white"
                        @onclick="() => showAddServiceModal = false"></button>
                </div>
                <div class="modal-body">

                    @if (availableServices == null)
                    {
                        <div class="text-center"><span class="spinner-border spinner-border-sm"></span></div>
                    }
                    else if (!availableServices.Any())
                    {
                        <div class="alert alert-warning small">Khách sạn chưa cấu hình dịch vụ nào.</div>
                    }
                    else
                    {
                        <div class="mb-3">
                            <label class="form-label small text-muted fw-bold">Chọn dịch vụ</label>
                            <select class="form-select" @bind="selectedServiceId">
                                @foreach (var s in availableServices)
                                {
                                    <option value="@s.ServiceId">
                                        @s.Name - @s.Price.ToString("N0") / @s.Unit
                                    </option>
                                }
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label small text-muted fw-bold">Số lượng</label>
                            <div class="input-group">
                                <button class="btn btn-outline-secondary" type="button"
                                    @onclick="() => { if (serviceQuantity > 1) serviceQuantity--; }">
                                    <i class="bi bi-dash"></i>
                                </button>
                                <input type="number" class="form-control text-center fw-bold" @bind="serviceQuantity" />
                                <button class="btn btn-outline-secondary" type="button" @onclick="() => serviceQuantity++">
                                    <i class="bi bi-plus"></i>
                                </button>
                            </div>
                        </div>

                        @if (selectedServiceId > 0)
                        {
                            var selectedSv = availableServices.FirstOrDefault(s => s.ServiceId == selectedServiceId);
                            if (selectedSv != null)
                            {
                                <div class="text-end text-primary small fw-bold">
                                    Thành tiền: @((selectedSv.Price * serviceQuantity).ToString("N0")) đ
                                </div>
                            }
                        }
                    }

                </div>
                <div class="modal-footer border-0 pt-0">
                    <button class="btn btn-secondary btn-sm" @onclick="() => showAddServiceModal = false">Hủy</button>
                    <button class="btn btn-primary btn-sm px-4 fw-bold" @onclick="SubmitAddService">
                        Thêm ngay <i class="bi bi-check"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool Show { get; set; }
    [Parameter] public RoomPhysicalVM Room { get; set; } = new();
    [Parameter] public int HotelId { get; set; }
    [Parameter] public EventCallback OnClose { get; set; } // Gọi khi đóng modal
    [Parameter] public EventCallback OnChange { get; set; } // Gọi khi dữ liệu thay đổi -> Reload Map
    private bool IsOwner = false;
    private HttpClient? _httpClient;
    private string activeTab = "operation";

    // Data Binding
    private List<BookingRoomDetailVM>? PendingBookings;
    private int SelectedBookingRoomId;

    // Edit Binding
    private string EditRoomNumber = "";
    private string EditStatus = "";

    // housekeeping
    private bool showAssignSection = false; // Toggle hiển thị list nhân viên
    private List<StaffVM> AvailableStaffs = new(); // List nhân viên để chọn
    private int SelectedStaffId = 0;
    // Thêm logic xử lý sửa tên
    private bool isEditingName = false;
    private string tempGuestName = "";
    private bool showInvoiceModal = false; // Biến bật tắt popup hóa đơn
    private bool isLoadingInvoice = false;
    private InvoiceVM? currentInvoice;
    private string paymentMethod = "Cash";
    private decimal amountPaid = 0;

    private bool isSubmitting = false;

    // dịch vụ
    private bool showAddServiceModal = false;
    private List<ServiceAddOnVM> availableServices = new();
    private int selectedServiceId = 0;
    private int serviceQuantity = 1;

    protected override async Task OnParametersSetAsync()
    {
        if (Show && Room != null)
        {
            _httpClient = _httpClientFactory.CreateClient("HotelBookingAPI"); // Hoặc inject token nếu cần
            var token = await _localStorage.GetItemAsync<string>("accessToken");
            if (!string.IsNullOrEmpty(token))
                _httpClient.DefaultRequestHeaders.Authorization = new("Bearer", token);

            // Kiểm tra role
            var authState = await _authStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            IsOwner = user.IsInRole("Owner");

            // Reset form
            EditRoomNumber = Room.RoomNumber;
            EditStatus = Room.Status;
            SelectedBookingRoomId = 0;
            activeTab = "operation";
            showAssignSection = false;
            isEditingName = false; // Reset sửa tên

            if (Room.Status == "Available")
            {
                await LoadPendingBookings();
            }
        }
    }

    private async Task LoadPendingBookings()
    {
        try
        {
            var res = await
            _httpClient!.GetFromJsonAsync<ApiResponse<List<BookingRoomDetailVM>>>($"hotel/owner/{HotelId}/pending-bookings");
            if (res.StatusCode == StatusCodeResponse.Success)
                PendingBookings = res.Content!.Where(x => x.RoomTypeId == Room.RoomTypeId).ToList();
        }
        catch
        {
            // Demo data nếu chưa có API
            PendingBookings = new List<BookingRoomDetailVM>();
        }
    }

    // --- ACTIONS ---
    private void StartEditName()
    {
        tempGuestName = Room.CurrentGuestName ?? "";
        isEditingName = true;
    }

    private async Task SaveGuestName()
    {
        var request = new UpdateGuestNameVM
        {
            BookingRoomId = Room.CurrentBookingRoomId ?? 0,
            GuestName = tempGuestName
        };
        // Gọi API cập nhật tên khách thực tế trong BookingRoom
        var res = await _httpClient!.PutAsJsonAsync("hotel/owner/bookingroom/update-guestname", request);

        if (res.IsSuccessStatusCode)
        {
            Snackbar.Add("Cập nhật tên khách thành công!", Severity.Success);
            Room.CurrentGuestName = tempGuestName;
            isEditingName = false;
        }
        else
        {
            var err = await res.Content.ReadAsStringAsync();
            Snackbar.Add($"Lỗi: {err}", Severity.Error);
        }
    }

    private async Task HandleManualCheckIn()
    {
        var request = new UpdateRoomPhysicalVM { RoomNumber = Room.RoomNumber, Status = "Occupied" };
        var res = await _httpClient!.PutAsJsonAsync($"hotel/owner/room/{Room.Id}/update", request);
        if (res.IsSuccessStatusCode) await SuccessAction("Check-in thành công!");
    }

    // 1. Gán phòng (Assign)
    private async Task HandleAssignRoom()
    {
        var request = new AssignRoomRequestVM
        {
            BookingRoomId = SelectedBookingRoomId,
            PhysicalRoomId = Room.Id
        };
        var res = await _httpClient!.PostAsJsonAsync("hotel/owner/room/assign", request);
        if (res.IsSuccessStatusCode) await SuccessAction("Gán phòng thành công!");
        else Snackbar.Add("Gán phòng thất bại", Severity.Error);
    }

    // 2. Trả phòng (Check-out)
    private async Task HandleCheckout()
    {
        if (Room.CurrentBookingId == null || Room.CurrentBookingId <= 0)
        {
            Snackbar.Add("Không tìm thấy thông tin đơn đặt phòng.", Severity.Error);
            return;
        }

        isLoadingInvoice = true;
        try
        {
            var url = $"hotel/owner/booking/{Room.CurrentBookingId}/invoice";
            var res = await _httpClient!.GetFromJsonAsync<ApiResponse<InvoiceVM>>(url);

            if (res != null && res.StatusCode == StatusCodeResponse.Success)
            {
                currentInvoice = res.Content;
                amountPaid = currentInvoice!.RemainingAmount; // Tự động điền số tiền cần trả
                showInvoiceModal = true; // <--- MỞ POPUP HÓA ĐƠN
            }
            else
            {
                Snackbar.Add(res?.Message ?? "Không tải được hóa đơn", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Lỗi hệ thống: {ex.Message}", Severity.Error);
        }
        finally
        {
            isLoadingInvoice = false;
        }
    }

    private async Task SubmitPayment()
    {
        isSubmitting = true;
        try
        {
            // Dùng Class VM thay vì new { } để đảm bảo đúng kiểu dữ liệu
            var payload = new PaymentRequestVM
            {
                BookingId = Room.CurrentBookingId ?? 0,
                Amount = amountPaid,
                PaymentMethod = paymentMethod,
                TransactionId = "" // Server tự sinh
            };

            var res = await _httpClient!.PostAsJsonAsync($"hotel/owner/booking/{Room.CurrentBookingId}/checkout", payload);

            if (res.IsSuccessStatusCode)
            {
                showInvoiceModal = false; // Đóng popup hóa đơn
                await SuccessAction("Thanh toán & Trả phòng thành công!");
            }
            else
            {
                // Đọc thông báo lỗi từ backend (ApiResponseHelper trả về)
                var errorContent = await res.Content.ReadAsStringAsync();
                // Parse thử JSON lỗi nếu cần, hoặc hiển thị text
                Snackbar.Add($"Lỗi: {errorContent}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Lỗi kết nối: {ex.Message}", Severity.Error);
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task OpenAddServiceModal()
    {
        try
        {
            // Gọi API lấy danh sách dịch vụ của Hotel (Cần đảm bảo Controller có API này)
            // Route dự kiến: GET api/hotel/{HotelId}/services/addon
            var res = await _httpClient!.GetFromJsonAsync<ApiResponse<List<ServiceAddOnVM>>>($"hotel/services-add/{HotelId}");

            if (res != null && res.StatusCode == StatusCodeResponse.Success)
            {
                availableServices = res.Content ?? new();

                // Chọn mặc định cái đầu tiên nếu có
                if (availableServices.Any())
                {
                    selectedServiceId = availableServices.First().ServiceId;
                }

                serviceQuantity = 1; // Reset số lượng
                showAddServiceModal = true; // Mở popup
            }
            else
            {
                Snackbar.Add("Không tải được danh sách dịch vụ.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Lỗi tải dịch vụ: {ex.Message}", Severity.Error);
        }
    }

    private async Task SubmitAddService()
    {
        if (selectedServiceId == 0) return;
        if (Room.CurrentBookingId == null)
        {
            Snackbar.Add("Lỗi: Không xác định được đơn đặt phòng.", Severity.Error);
            return;
        }

        // Tạo VM request (Khớp với AddServiceRequestVM của bạn)
        var request = new AddServiceRequestVM
        {
            BookingId = Room.CurrentBookingId.Value,
            // Thay vì gán trực tiếp ServiceId, ta tạo một List chứa 1 phần tử
            Services = new List<ServiceItemRequestVM> 
            { 
                new ServiceItemRequestVM 
                { 
                    ServiceId = selectedServiceId, 
                    Quantity = serviceQuantity 
                } 
            }
        };

        try
        {
            // Gọi API Backend (Route dự kiến: POST api/hotel/owner/booking/service/add)
            // Bạn cần kiểm tra lại Route trong HotelController cho chính xác
            var res = await _httpClient!.PostAsJsonAsync("hotel/booking/service/add", request);

            if (res.IsSuccessStatusCode)
            {
                Snackbar.Add("Thêm dịch vụ thành công!", Severity.Success);
                showAddServiceModal = false; 
                serviceQuantity = 1;
            }
            else
            {
                var err = await res.Content.ReadAsStringAsync();
                Snackbar.Add($"Thêm thất bại: {err}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Lỗi kết nối: {ex.Message}", Severity.Error);
        }
    }

    // 3. Sửa phòng
    private async Task HandleUpdateRoom()
    {
        var request = new UpdateRoomPhysicalVM { RoomNumber = EditRoomNumber, Status = EditStatus };
        var res = await _httpClient!.PutAsJsonAsync($"hotel/owner/room/{Room.Id}/update", request);
        if (res.IsSuccessStatusCode) await SuccessAction("Cập nhật thành công!");
    }

    private async Task HandleDeleteRoom()
    {
        var res = await _httpClient!.DeleteAsync($"hotel/owner/room/{Room.Id}/delete");
        if (res.IsSuccessStatusCode) await SuccessAction("Xóa phòng thành công!");
    }

    // 4. Dọn nhanh (Quick Clean) -> Update Status về Available
    private async Task HandleQuickClean()
    {
        var request = new UpdateRoomPhysicalVM { RoomNumber = Room.RoomNumber, Status = "Available" };
        var res = await _httpClient!.PutAsJsonAsync($"hotel/owner/room/{Room.Id}/update", request);
        if (res.IsSuccessStatusCode) await SuccessAction("Phòng đã sạch!");
    }

    // 5. Hoàn tất bảo trì
    private async Task HandleFinishMaintenance()
    {
        await HandleQuickClean(); // Logic giống dọn dẹp, chuyển về Available
    }

    // Housekeeping - Giao việc dọn phòng
    private async Task LoadStaffsForAssign()
    {
        showAssignSection = true; // Hiện vùng chọn nhân viên
        if (AvailableStaffs.Count == 0) // Nếu chưa tải thì tải
        {
            try
            {
                var res = await _httpClient!.GetFromJsonAsync<ApiResponse<List<StaffVM>>>($"hotel/owner/{HotelId}/staffs");
                if (res.StatusCode == StatusCodeResponse.Success)
                    AvailableStaffs = res.Content.Where(s => s.IsActive).ToList();
            }
            catch { }
        }
    }
    private async Task HandleAssignTask()
    {
        // lấy Task của phòng này
        try
        {
            var tasksRes = await
            _httpClient!.GetFromJsonAsync<ApiResponse<List<HousekeepingTaskVM>>>($"hotel/housekeeping/tasks/{HotelId}");
            var currentTask = tasksRes.Content.FirstOrDefault(t => t.RoomId == Room.Id && t.TaskStatus != "Completed");

            if (currentTask == null)
            {
                Snackbar.Add("Không tìm thấy công việc dọn dẹp nào.", Severity.Warning);
                return;
            }

            var req = new AssignTaskRequestVM
            {
                TaskId = currentTask.Id,
                StaffId = SelectedStaffId,
                Priority = "High",
                Note = "Owner giao việc trực tiếp."
            };

            var res = await _httpClient!.PostAsJsonAsync("hotel/owner/housekeeping/assign", req);
            if (res.IsSuccessStatusCode) await SuccessAction("Đã giao việc thành công!");
            else Snackbar.Add("Lỗi khi giao việc", Severity.Error);
        }
        catch { Snackbar.Add("Lỗi kết nối", Severity.Error); }
    }

    private async Task SuccessAction(string msg)
    {
        Snackbar.Add(msg, Severity.Success);
        await OnChange.InvokeAsync(); // Reload map
        await Close();
    }

    private string AmountPaidString
    {
        get => amountPaid.ToString("N0"); // Hiển thị: 12,000,000
        set
        {
            // 1. Loại bỏ tất cả ký tự không phải số (dấu phẩy, dấu chấm, chữ...)
            // Ví dụ: "12,000.abc" -> "12000"
            var digitsOnly = new string(value.Where(char.IsDigit).ToArray());

            // 2. Parse lại thành decimal
            if (decimal.TryParse(digitsOnly, out var result))
            {
                amountPaid = result;
            }
            else
            {
                amountPaid = 0;
            }
        }
    }

    private async Task Close() => await OnClose.InvokeAsync();

    private string GetHeaderClass() => Room.Status switch
    {
        "Available" => "bg-success",
        "Reserved" => "bg-info", // Màu xanh dương nhạt cho Sắp đến
        "Occupied" => "bg-danger",
        "Cleaning" => "bg-warning text-dark",
        "Maintenance" => "bg-secondary",
        _ => "bg-primary"
    };

    private string GetStatusLabel(string status) => status switch
    {
        "Available" => "Trống",
        "Reserved" => "Sắp đến",
        "Occupied" => "Có khách",
        "Cleaning" => "Chờ dọn",
        "Maintenance" => "Bảo trì",
        _ => status
    };
}