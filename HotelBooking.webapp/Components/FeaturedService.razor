@using Blazored.LocalStorage
@using HotelBooking.webapp.ViewModels.Hotel
@using System.Net.Http.Headers
@inject IHttpClientFactory _httpClientFactory
@inject ILocalStorageService _localStorage
@inject NavigationManager _nav
<div class="container my-15 py-5 bg-light-subtle">
    
    <div class="text-center mb-5">
        <h2 class="handwriting section-title" style="color:#54a9ffff">Nâng tầm kỳ nghỉ</h2>
        <p class="text-muted">Tận hưởng kỳ nghỉ cùng với các dịch vụ nổi bật</p>
    </div>
    @if (upcomingTrip != null)
    {
        <div class="card border-0 shadow-sm rounded-4 mb-5 overflow-hidden bg-white animate-up">
            <div class="row g-0">
                <div class="col-md-4 position-relative">
                    <img src="@(upcomingTrip.HotelImage ?? "/images/default-hotel.jpg")" class="w-100 h-100 object-fit-cover" style="min-height: 200px;">
                    <div class="position-absolute top-0 start-0 m-3 badge bg-warning text-dark shadow-sm">
                        <i class="bi bi-clock-history me-1"></i> Còn @upcomingTrip.TotalDays ngày nữa
                    </div>
                </div>
                <div class="col-md-8">
                    <div class="card-body p-4 d-flex flex-column h-100 justify-content-center">
                        <h5 class="text-uppercase text-muted small fw-bold mb-2">Chuyến đi sắp tới của bạn</h5>
                        <h3 class="fw-bold text-primary mb-3">@upcomingTrip.HotelName</h3>
                        
                        <div class="d-flex align-items-center gap-3">
                            <button class="btn btn-outline-secondary rounded-pill px-4" 
                                    @onclick="() => OpenBookingModal(upcomingTrip.Id)">
                                <i class="bi bi-ticket-detailed me-2"></i>Xem chi tiết
                            </button>
                        </div>
                        
                        <div class="mt-3 text-muted small fst-italic">
                            <i class="bi bi-info-circle me-1"></i> Bạn có thể đặt trước Spa, Xe đưa đón để chuyến đi trọn vẹn hơn.
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (featuredServices != null)
    {
        <div class="row g-4">
            @foreach (var sv in featuredServices)
            {
                <div class="col-6 col-md-3">
                    <div class="card h-100 border-0 shadow-hover cursor-pointer service-card" 
                         @onclick="() => NavigateToSearch(sv.Id)">
                        <div class="card-body text-center p-4">
                            <div class="mb-3 mx-auto icon-box bg-light rounded-circle text-primary d-flex align-items-center justify-content-center" 
                                 style="width: 60px; height: 60px;">
                                <i class="bi bi-stars fs-3"></i> 
                            </div>
                            <h6 class="fw-bold text-dark mb-1">@sv.Name</h6>
                            <small class="text-muted line-clamp-2">@sv.Description</small>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<BookingDetail @ref="_detailModal" />

<style>
    .shadow-hover { transition: all 0.3s; }
    .shadow-hover:hover { transform: translateY(-5px); box-shadow: 0 10px 20px rgba(0,0,0,0.1) !important; }
    .animate-up { animation: slideUp 0.5s ease-out; }
    @@keyframes slideUp { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }
    .icon-box { transition: 0.3s; }
    .service-card:hover .icon-box { background-color: var(--mud-palette-primary) !important; color: white !important; }
</style>

@code {
    private List<ServicesVM> featuredServices = new();
    private BookingShortVM? upcomingTrip;
    private BookingDetail _detailModal; // Ref đến Modal

    protected override async Task OnInitializedAsync()
    {
        var client = _httpClientFactory.CreateClient("HotelBookingAPI");
        
        // 1. Load Dịch vụ nổi bật (Public)
        try 
        {
            var svRes = await client.GetFromJsonAsync<ApiResponse<List<ServicesVM>>>("hotel/get-featured-services");
            featuredServices = svRes?.Content ?? new();
        } catch {}

        // 2. Load Chuyến đi sắp tới (Nếu đã login)
        var token = await _localStorage.GetItemAsync<string>("accessToken");
        if (!string.IsNullOrEmpty(token))
        {
            try
            {
                client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);
                var bookRes = await client.GetFromJsonAsync<ApiResponse<BookingShortVM>>("hotel/booking/upcoming-trip");
                upcomingTrip = bookRes?.Content;
            }
            catch {}
        }
    }

    // Chức năng 1: Tìm kiếm theo dịch vụ
    private void NavigateToSearch(int serviceId)
    {
        _nav.NavigateTo($"/hotels?serviceIds={serviceId}");
    }

    // Chức năng 2: Mở Modal xem chi tiết
    private async Task OpenBookingModal(int bookingId)
    {
        await _detailModal.ShowAsync(bookingId);
    }

}