@inject NavigationManager _nav
@inject AuthenticationStateProvider _authStateProvider
<div class="d-flex flex-column h-100 sidebar-theme">

    <div class="p-3 border-bottom border-secondary border-opacity-25">
        @if (HotelId > 0)
        {
            @if (IsOwner) 
            {
                <a href="/owner/hotels"
                   class="btn btn-link text-decoration-none text-white-50 p-0 mb-3 d-flex align-items-center hover-bright">
                    <i class="bi bi-chevron-left me-1 small"></i>
                    <span style="font-size: 0.9rem;">Danh sách Hotel</span>
                </a>
            }
            else
            {
                <div class="text-white-50 mb-3 small">
                    <i class="bi bi-building me-1"></i> Khu vực làm việc
                </div>
            }
        }
        else
        {
            <div class="text-center py-4 text-white-50">
                <i class="bi bi-buildings fs-1 mb-2 d-block opacity-25"></i>
                <small>Chọn khách sạn để bắt đầu</small>
                <div class="mt-3">
                    <a href="/owner/hotels" class="btn btn-outline-light btn-sm w-100">Chọn ngay</a>
                </div>
            </div>
        }
    </div>

    <div class="flex-grow-1 overflow-auto custom-scrollbar p-3 pt-2">
        @if (HotelId > 0)
        {
            <ul class="nav flex-column gap-1">

                <li class="nav-label mt-2 mb-2">VẬN HÀNH</li>
                @if(IsHousekeeper)
                {
                    <li class="nav-item">
                        <NavLink class="nav-link" href="@($"/owner/hotels/{HotelId}/housekeeping-tasks")">
                            <i class="bi bi-brush-fill"></i> <span>Buồng phòng</span>
                        </NavLink>
                    </li>
                }

                @if (IsOwner)
                {
                    <li class="nav-item">
                        <NavLink class="nav-link" href="@($"/owner/hotels/{HotelId}/dashboard")">
                            <i class="bi bi-speedometer2"></i> <span>Dashboard</span>
                        </NavLink>
                    </li>
                }

                @if (IsOwner || IsReceptionist)
                {
                    <li class="nav-item">
                        <NavLink class="nav-link" href="@($"/owner/hotels/{HotelId}/room-map")">
                            <i class="bi bi-grid-3x3-gap-fill"></i> <span>Sơ đồ phòng</span>
                        </NavLink>
                    </li>
                }

                @if (IsOwner || IsHousekeeper)
                {
                    <li class="nav-item">
                        <NavLink class="nav-link" href="@($"/owner/hotels/{HotelId}/housekeeping-tasks")">
                            <i class="bi bi-brush-fill"></i> <span>Buồng phòng</span>
                        </NavLink>
                    </li>
                }

                @if (IsOwner || IsReceptionist)
                {
                    <li class="nav-item">
                        <NavLink class="nav-link" href="@($"/owner/hotels/{HotelId}/bookings/calendar")">
                            <i class="bi bi-calendar-check"></i> <span>Đặt phòng</span>
                        </NavLink>
                    </li>
                }

                @if (IsOwner)
                {
                    <li class="nav-item">
                        <NavLink class="nav-link" href="@($"/owner/hotels/{HotelId}/reviews")">
                            <i class="bi bi-star-half"></i> <span>Đánh giá & Phản hồi</span>
                        </NavLink>
                    </li>

                    <li class="nav-label mt-4 mb-2">CẤU HÌNH</li>

                    <li class="nav-item">
                        <NavLink class="nav-link" href="@($"/owner/hotel-wizard/{HotelId}")">
                            <i class="bi bi-pencil-square"></i> <span>Thông tin & Ảnh</span>
                        </NavLink>
                    </li>
                    <li class="nav-item">
                        <NavLink class="nav-link" href="@($"/owner/hotels/{HotelId}/room-types")">
                            <i class="bi bi-door-open"></i> <span>Loại phòng</span>
                        </NavLink>
                    </li>
                    <li class="nav-item">
                        <NavLink class="nav-link" href="@($"/owner/hotels/{HotelId}/services")">
                            <i class="bi bi-cup-hot"></i> <span>Dịch vụ</span>
                        </NavLink>
                    </li>
                    <li class="nav-item">
                        <NavLink class="nav-link" href="@($"/owner/hotels/{HotelId}/staffs")">
                            <i class="bi bi-people"></i> <span>Nhân viên</span>
                        </NavLink>
                    </li>
                    <li class="nav-item">
                        <NavLink class="nav-link" href="@($"/owner/hotels/{HotelId}/policies")">
                            <i class="bi bi-file-earmark-text"></i> <span>Chính sách</span>
                        </NavLink>
                    </li>
                }
            </ul>
        }
    </div>

</div>

<style>
    /* Tổng thể Sidebar */
    .sidebar-theme {
        background-color: #1e2125;
        /* Màu tối hiện đại */
        color: #adb5bd;
    }

    /* Card hiển thị ID Hotel */
    .bg-gradient-primary {
        background: linear-gradient(45deg, #0d6efd, #0a58ca);
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.2);
    }

    .icon-box {
        width: 36px;
        height: 36px;
    }

    /* Style cho các link Menu */
    .nav-label {
        font-size: 0.7rem;
        font-weight: 700;
        color: #6c757d;
        padding-left: 12px;
        letter-spacing: 0.5px;
    }

    .nav-link {
        color: #adb5bd !important;
        padding: 10px 12px;
        border-radius: 8px;
        transition: all 0.2s ease-in-out;
        display: flex;
        align-items: center;
        font-weight: 500;
        font-size: 0.9rem;
    }

    .nav-link i {
        font-size: 1.1rem;
        margin-right: 12px;
        width: 20px;
        text-align: center;
        transition: transform 0.2s;
    }

    /* Hiệu ứng Hover */
    .nav-link:hover {
        background-color: rgba(255, 255, 255, 0.08);
        color: #fff !important;
        padding-left: 16px;
        /* Dịch nhẹ sang phải */
    }

    .nav-link:hover i {
        transform: scale(1.1);
        color: #fff;
    }

    .hover-bright:hover {
        color: #fff !important;
    }

    /* Trạng thái Active */
    .nav-link.active {
        background-color: #0d6efd !important;
        /* Màu xanh brand */
        color: #fff !important;
        box-shadow: 0 4px 12px rgba(13, 110, 253, 0.3);
    }

    /* Thanh cuộn (Scrollbar) tinh tế */
    .custom-scrollbar::-webkit-scrollbar {
        width: 5px;
    }

    .custom-scrollbar::-webkit-scrollbar-track {
        background: transparent;
    }

    .custom-scrollbar::-webkit-scrollbar-thumb {
        background: #495057;
        border-radius: 10px;
    }

    .custom-scrollbar::-webkit-scrollbar-thumb:hover {
        background: #6c757d;
    }
</style>

@code {
    [Parameter] public int HotelId { get; set; }
    private bool IsOwner { get; set; } = false;
    private bool IsReceptionist { get; set; } = false;
    private bool IsHousekeeper { get; set; } = false;
    protected override async Task OnInitializedAsync()
    {
        await CheckUserRoles();
    }

    protected override async Task OnParametersSetAsync()
    {
        await CheckUserRoles();
    }
    private async Task CheckUserRoles()
    {
        var authState = await _authStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity != null && user.Identity.IsAuthenticated)
        {
            // 1. Kiểm tra Role Owner
            IsOwner = user.IsInRole("Owner");

            // 2. Nếu là Staff, kiểm tra Position (Chức vụ)
            // Lưu ý: Bạn cần đảm bảo Claim "Position" đã được lưu trong Token khi đăng nhập
            if (user.IsInRole("Staff"))
            {
                var positionClaim = user.FindFirst("Position")?.Value;
                
                // Chuẩn hóa chuỗi để so sánh (Lễ tân / Receptionist)
                if (!string.IsNullOrEmpty(positionClaim))
                {
                    // Giả sử DB lưu là "Receptionist" hoặc "Lễ tân"
                    if (positionClaim.Equals("Receptionist", StringComparison.OrdinalIgnoreCase) || 
                        positionClaim.Equals("Lễ tân", StringComparison.OrdinalIgnoreCase))
                    {
                        IsReceptionist = true;
                    }

                    // Giả sử DB lưu là "Housekeeper" hoặc "Buồng phòng"
                    if (positionClaim.Equals("Housekeeper", StringComparison.OrdinalIgnoreCase) || 
                        positionClaim.Equals("Buồng phòng", StringComparison.OrdinalIgnoreCase))
                    {
                        IsHousekeeper = true;
                    }
                }
            }
        }
    }
}