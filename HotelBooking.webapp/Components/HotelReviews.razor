@using HotelBooking.webapp.ViewModels.Hotel
@using MudBlazor

<div class="container my-5" id="reviews-section">
    <div class="row g-4 mb-4">
        <div class="col-md-4">
            <div class="card border-0 rounded-4 p-4 h-100">
                <div class="text-center mb-3">
                    <h2 class="display-3 fw-bold mb-0" style="color:#54a9ffff">@AverageRating.ToString("0.0")</h2>
                    <div class="d-flex justify-content-center my-2">
                        <MudRating ReadOnly="true" SelectedValue="@((int)Math.Round(AverageRating / 2))" MaxValue="5" Size="Size.Medium" Color="Color.Warning" />
                    </div>
                    <span class="text-muted fw-semibold">@GetRatingLabel(AverageRating)</span>
                    <div class="small text-muted">(@ReviewCount đánh giá xác thực)</div>
                </div>

                <div class="mt-4">
                    <div class="d-flex justify-content-between small mb-1">
                        <span>Vệ sinh</span> <span class="fw-bold">@((AverageRating * 0.95m).ToString("0.0"))</span>
                    </div>
                    <MudProgressLinear Value="@((double)(AverageRating * 9.5m))" Color="Color.Success" Class="mb-3 rounded-pill" Size="Size.Small" />

                    <div class="d-flex justify-content-between small mb-1">
                        <span>Tiện nghi</span> <span class="fw-bold">@((AverageRating * 0.9m).ToString("0.0"))</span>
                    </div>
                    <MudProgressLinear Value="@((double)(AverageRating * 9.0m))" Color="Color.Info" Class="mb-3 rounded-pill" Size="Size.Small" />

                    <div class="d-flex justify-content-between small mb-1">
                        <span>Vị trí</span> <span class="fw-bold">@((AverageRating * 0.98m).ToString("0.0"))</span>
                    </div>
                    <MudProgressLinear Value="@((double)(AverageRating * 9.8m))" Color="Color.Primary" Class="mb-3 rounded-pill" Size="Size.Small" />
                    
                    <div class="d-flex justify-content-between small mb-1">
                        <span>Dịch vụ</span> <span class="fw-bold">@AverageRating.ToString("0.0")</span>
                    </div>
                    <MudProgressLinear Value="@((double)(AverageRating * 10))" Color="Color.Warning" Class="mb-2 rounded-pill" Size="Size.Small" />
                </div>
            </div>
        </div>

        <div class="col-md-8">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <h5 class="fw-bold text-dark mb-0">Khách hàng nói gì?</h5>
                </div>

            @if (Reviews != null && Reviews.Any())
            {
                <MudCarousel TData="ReviewVM" ShowArrows="true" AutoCycle="false" Class="rounded-4 border" Style="height:320px;" ShowBullets="false">
                    @foreach (var review in Reviews)
                    {
                        <MudCarouselItem>
                            <div class="p-4 d-flex flex-column h-100 bg-white">
                                <div class="d-flex align-items-start mb-3">
                                    <div class="me-3">
                                        @if (!string.IsNullOrEmpty(review.CustomerAvatar))
                                        {
                                            <img src="@review.CustomerAvatar" class="rounded-circle border" style="width:56px; height:56px; object-fit:cover;" />
                                        }
                                        else
                                        {
                                            <div class="rounded-circle bg-light d-flex align-items-center justify-content-center border" style="width:56px; height:56px;">
                                                <span class="fw-bold text-primary fs-4">@review.CustomerName.FirstOrDefault()</span>
                                            </div>
                                        }
                                    </div>
                                    <div class="flex-grow-1">
                                        <div class="d-flex justify-content-between">
                                            <h6 class="fw-bold mb-0">@review.CustomerName</h6>
                                            <div class="d-flex align-items-center">
                                                <span class="fw-bold text-dark">@review.Rating.ToString("0.0")</span>
                                                <MudIcon Icon="@Icons.Material.Filled.Star" Color="Color.Warning" Size="Size.Small" Class="me-1"/>
                                            </div>
                                        </div>
                                        <div class="text-muted small mt-1">
                                            <i class="bi bi-calendar-check me-1"></i> @review.CreatedAt.ToString("dd/MM/yyyy") 
                                        </div>
                                    </div>
                                </div>

                                <div class="flex-grow-1 overflow-auto pe-2">
                                    <div class="position-relative ps-4">
                                        <i class="position-absolute top-0 start-0 text-muted opacity-25 display-6" style="line-height:0;"></i>
                                        <p class="fst-italic text-dark mb-2">@review.Comment</p>
                                    </div>

                                    @if (!string.IsNullOrEmpty(review.Reply))
                                    {
                                        <div class="mt-3 ms-4 p-3 bg-light rounded-3 border-start">
                                            <div class="d-flex align-items-center mb-1">
                                                <i class="bi bi-arrow-return-right me-2 text-warning"></i>
                                                <small class="fw-bold text-dark">Phản hồi từ chỗ nghỉ:</small>
                                            </div>
                                            <small class="text-muted d-block">@review.Reply</small>
                                        </div>
                                    }
                                </div>
                            </div>
                        </MudCarouselItem>
                    }
                </MudCarousel>
            }
            else
            {
                <div class="d-flex flex-column align-items-center justify-content-center bg-light rounded-4 text-center border border-dashed p-4" style="min-height: 320px; ">
                    <div class="bg-white p-3 rounded-circle shadow-sm ">
                        <i class="bi bi-chat-heart fs-1 text-muted opacity-50"></i>
                    </div>
                    <h6 class="fw-bold text-muted">Chưa có đánh giá nào</h6>
                    <p class="small text-muted mb-0">Hãy là người đầu tiên trải nghiệm và chia sẻ cảm nghĩ!</p>
                </div>
            }
        </div>
    </div>
</div>

@code {
    [Parameter] public List<ReviewVM> Reviews { get; set; } = new();
    [Parameter] public int ReviewCount { get; set; }
    [Parameter] public decimal AverageRating { get; set; }

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        StateHasChanged();
    }

    private string GetRatingLabel(decimal rating) => rating switch
    {
        >= 9.5m => "Xuất sắc",
        >= 9.0m => "Tuyệt vời",
        >= 8.5m => "Rất tốt",
        >= 8.0m => "Tốt",
        >= 7.0m => "Khá tốt",
        _ => "Điểm đánh giá"
    };
}