@using HotelBooking.Client
@inject ICurrentUserService CurrentUserService

<header class="@HeaderClass" style="z-index: 1000;">
    <div class="container">
        <!-- Logo -->
        <a class="navbar-brand d-flex align-items-center fw-bold fs-4 text-primary" href="/">
            <img src="/images/logo/chillzone.png" alt="Hotel Booking Logo" class="logo " style="height:50px; width: auto" />
        </a>

        <!-- Toggle button -->
        <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
            aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>

        <!-- Navigation -->
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav mx-auto gap-lg-5 fw-semibold fs-5">
                <li class="nav-item">
                    <NavLink class="nav-link custom-nav" href="/" Match="NavLinkMatch.All">Trang chủ</NavLink>
                </li>
                <li class="nav-item">
                    <NavLink class="nav-link custom-nav" href="/Hotels">Khách sạn</NavLink>
                </li>
                <li class="nav-item">
                    <NavLink class="nav-link custom-nav" href="/gioi-thieu">Giới thiệu</NavLink>
                </li>
                <li class="nav-item">
                    <NavLink class="nav-link custom-nav" href="/contact">Hỗ trợ</NavLink>
                </li>
            </ul>

            <!-- User Actions -->
            <div class="d-flex align-items-center">
                @if (user?.IsAuthenticated == true)
                {
                    <div class="dropdown">
                        <a class="d-flex align-items-center text-decoration-none dropdown-toggle" href="#" data-bs-toggle="dropdown">
                            @if (!string.IsNullOrEmpty(user.Avatar) && user.Avatar.StartsWith("http"))
                            {
                                <img src="@user.Avatar" class="rounded-circle me-2" style="width:40px;height:40px;" />
                            }
                            else
                            {
                                <div class="rounded-circle me-2 d-flex align-items-center justify-content-center bg-primary text-white fw-bold"
                                     style="width:40px;height:40px;">
                                    @GetFirstLetter(user.FullName)
                                </div>
                            }
                            <span class="fw-semibold text-dark">@user.FullName</span>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                            <li><a class="dropdown-item" href="user/profile"><i class="bi bi-person me-2"></i>Hồ sơ cá nhân</a></li>
                            
                            <li><hr class="dropdown-divider" /></li>

                            @* === [LOGIC STAFF] === *@
                            @if (user.Roles.Contains("Staff") && !string.IsNullOrEmpty(user.StaffHotelId))
                            {
                                <li>
                                    <a class="dropdown-item fw-bold text-primary mb-1" 
                                       href="/owner/hotels/@user.StaffHotelId/room-map">
                                        <i class="bi bi-briefcase-fill me-2"></i>Vào ca làm việc
                                    </a>
                                </li>
                            }

                            @* === [LOGIC OWNER] === *@
                            @if (user.Roles.Contains("Owner"))
                            {
                                <li>
                                    <a class="dropdown-item fw-bold text-success" href="/owner/hotels">
                                        <i class="bi bi-building-gear me-2"></i>Quản lý khách sạn
                                    </a>
                                </li>
                            }
                            
                            @* === [LOGIC CUSTOMER - Ẩn nếu đã là Owner] === *@
                            @if (user.Roles.Contains("Customer") && !user.Roles.Contains("Owner"))
                            {
                                <li><a class="dropdown-item" href="/upgrade-owner"><i class="bi bi-pen me-2"></i>Đăng ký đối tác</a></li>
                            }

                            @if (user.Roles.Contains("Admin"))
                            {
                                <li><a class="dropdown-item" href="/admin/dashboard"><i class="bi bi-gear me-2"></i>Quản trị</a></li>
                            }

                            <li><hr class="dropdown-divider" /></li>
                            <li>
                                <button class="dropdown-item text-danger" @onclick="Logout">
                                    <i class="bi bi-box-arrow-right me-2"></i>Đăng xuất
                                </button>
                            </li>
                        </ul>
                    </div>
                }
                else
                {
                    <div class="d-flex align-items-center">
                        <NavLink class="btn btn-outline-light me-2 d-flex align-items-center gap-2" href="/customer-register">
                            <i class="bi bi-person-plus fs-5"></i>
                            <span>Đăng ký</span>
                        </NavLink>

                        <NavLink class="btn btn-light d-flex align-items-center gap-2" href="/customer-login">
                            <i class="bi bi-box-arrow-in-right fs-5"></i>
                            <span>Đăng nhập</span>
                        </NavLink>
                    </div>
                }
            </div>
        </div>
    </div>
</header>

@code {
    private CurrentUserVM? user;

    // Tạo chuỗi class động
    [Parameter] public bool IsFixed { get; set; } = true;
    private string HeaderClass => IsFixed 
        ? "navbar navbar-expand-lg position-fixed top-0 start-0 w-100 shadow-sm" 
        : "navbar navbar-expand-lg w-100 shadow-sm";
    protected override async Task OnInitializedAsync()
    {
        user = await CurrentUserService.GetCurrentUserAsync();
    }

    private string GetFirstLetter(string fullName)
    {
        if (string.IsNullOrWhiteSpace(fullName)) return "?";
        var name = fullName?.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        var lastName = name?.LastOrDefault();
        return string.IsNullOrEmpty(lastName) ? "?" : lastName[0].ToString().ToUpper();
    }

    private async Task Logout()
    {
        await CurrentUserService.LogoutAsync();
    }
}
