@using HotelBooking.webapp.ViewModels.Hotel
@using System.ComponentModel.DataAnnotations
@inherits ComponentBase

<EditForm Model="@FormModel" OnValidSubmit="@HandleSubmit">
    <DataAnnotationsValidator />
    <ValidationSummary class="text-danger small mb-3" />

    <div class="mb-3">
        <label class="form-label fw-medium">Tên tiện ích <span class="text-danger">*</span></label>
        <InputText @bind-Value="FormModel.Name" class="form-control" placeholder="VD: Wifi miễn phí, Hồ bơi..." />
        <ValidationMessage For="@(() => FormModel.Name)" class="text-danger small" />
    </div>

    <div class="mb-3">
        <label class="form-label fw-medium">Icon (class FontAwesome)</label>
        <InputText @bind-Value="FormModel.IconClass" class="form-control" placeholder="fa fa-wifi" />
        <ValidationMessage For="@(() => FormModel.IconClass)" class="text-danger small" />

        @if (!string.IsNullOrWhiteSpace(FormModel.IconClass))
        {
            <div class="mt-2 text-center">
                <i class="@FormModel.IconClass fa-2x text-primary"></i>
            </div>
        }
    </div>

    <div class="mb-3">
        <label class="form-label fw-medium">Mô tả</label>
        <InputTextArea @bind-Value="FormModel.Description"
                       class="form-control"
                       rows="3"
                       placeholder="Nhập mô tả ngắn gọn về tiện ích..." />
        <ValidationMessage For="@(() => FormModel.Description)" class="text-danger small" />
    </div>

    <div class="d-flex justify-content-end gap-2">
        <button type="button" class="btn btn-outline-secondary" @onclick="OnCancel">Hủy</button>
        <button type="submit" class="btn btn-primary">
            @(IsEditMode ? "Cập nhật" : "Tạo mới")
        </button>
    </div>
</EditForm>

@code {
    [Parameter] public AmenityVM FormModel { get; set; } = new();
    [Parameter] public bool IsEditMode { get; set; }
    [Parameter] public EventCallback<AmenityVM> OnValidSubmit { get; set; }
    [Parameter] public EventCallback OnCancelClicked { get; set; }

    private async Task HandleSubmit() => await OnValidSubmit.InvokeAsync(FormModel);
    private async Task OnCancel() => await OnCancelClicked.InvokeAsync();
}
