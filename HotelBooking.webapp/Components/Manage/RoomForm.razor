<EditForm Model="@FormModel" OnSubmit="@HandleSubmit">
    <DataAnnotationsValidator />
    <ValidationSummary class="text-danger small mb-3" />

    <!-- Các field như cũ -->
    <div class="mb-3">
        <label class="form-label fw-medium">Tên <span class="text-danger">*</span></label>
        <InputText @bind-Value="FormModel.Name" class="form-control" placeholder="VD: King Bed, Ocean View..." />
        <ValidationMessage For="@(() => FormModel.Name)" />
    </div>

    <div class="mb-3">
        <label class="form-label fw-medium">Icon Class <span class="text-danger">*</span></label>
        <InputText @bind-Value="FormModel.IconClass" class="form-control" placeholder="fa-bed, fa-water..." />
        <small class="text-muted">Dùng FontAwesome 6 Free/Pro</small>

        @if (!string.IsNullOrWhiteSpace(FormModel.IconClass))
        {
            <div class="mt-3 text-center p-3 bg-light rounded">
                <i class="@FormModel.IconClass fa-3x" style="color:@FormModel.IconColor"></i>
                <p class="mt-2 mb-0 text-muted">@FormModel.IconClass</p>
            </div>
        }
    </div>

    <div class="mb-3">
        <label class="form-label fw-medium">Màu icon</label>
        <div class="input-group">
            <InputText @bind-Value="FormModel.IconColor" class="form-control" placeholder="#8B4513" />
            <span class="input-group-text">
                <div style="width:30px;height:30px;background:@FormModel.IconColor;border:1px solid #ddd;"></div>
            </span>
        </div>
        <small class="text-muted">Mặc định: @DefaultColor</small>
    </div>

    <div class="mb-3">
        <label class="form-label fw-medium">Mô tả (tùy chọn)</label>
        <InputTextArea @bind-Value="FormModel.Description" class="form-control" rows="3" />
    </div>

    <div class="d-flex justify-content-end gap-2">
        <button type="button" class="btn btn-outline-secondary" @onclick="OnCancel">Hủy</button>
        <button type="submit" class="btn btn-primary">
            @(FormModel.Id > 0 ? "Cập nhật" : "Tạo mới")
        </button>
    </div>
</EditForm>

@code {
    [Parameter] public IconItemVM FormModel { get; set; } = new();
    [Parameter] public string DefaultIconClass { get; set; } = "fa-bed";
    [Parameter] public string DefaultColor { get; set; } = "#8B4513";
    [Parameter] public string ItemName { get; set; } = "mục";
    [Parameter] public EventCallback<IconItemVM> OnValidSubmit { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    private async Task HandleSubmit(EditContext context)
    {
        if (context.Validate())
        {
            await OnValidSubmit.InvokeAsync(FormModel);
        }
        // Nếu không valid → tự động hiện lỗi từ DataAnnotationsValidator
    }
}