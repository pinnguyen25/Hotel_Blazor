@using Blazored.LocalStorage
@using HotelBooking.webapp.ViewModels.Hotel
@using System.Net.Http.Headers
@inject IJSRuntime JSRuntime
@inject IHttpClientFactory HttpClientFactory
@inject ILocalStorageService _localStorage
@inject ISnackbar Snackbar
<div class="container mt-15 ">
  <h2 class="handwriting mb-6 text-center" style="color: #54a9ffff;">Nơi lưu trú hàng đầu</h2>
  @if (hotels == null)
  {
    <p>Loading...</p>
  }
  else if (!hotels.Any())
  {
    <p>Không có khách sạn nào được đánh giá cao.</p>
  }
  else
  {
    <div class="scroll-container-wrapper position-relative">
      <!-- Nút Prev -->
      <button class="scroll-btn prev-btn" @onclick="() => Scroll(-1)">
        <i class="bi bi-chevron-left"></i>
      </button>

      <!-- Vùng hiển thị các hotel -->
      <div class="scroll-container" id="hotelScrollContainer">
        @foreach (var hotel in hotels)
        {
          <div class="scroll-item">
            <HotelCard Hotel="hotel" OnWishlistToggle="ToggleWishlist" />
          </div>
        }
      </div>

      <!-- Nút Next -->
      <button class="scroll-btn next-btn" @onclick="() => Scroll(1)">
        <i class="bi bi-chevron-right"></i>
      </button>
    </div>
  }
</div>

@code {
  private List<HotelListItemVM>? hotels;
  private HashSet<int> loadingHotels = new();
  private HttpClient? _httpClient;
  private bool isLoading = true;
  private async Task<bool> EnsureAuthTokenAsync()
  {
    // Nếu Header đã có Token rồi thì thôi
    if (_httpClient!.DefaultRequestHeaders.Authorization != null) return true;

    var token = await _localStorage.GetItemAsync<string>("accessToken");
    if (!string.IsNullOrEmpty(token))
    {
      _httpClient.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);
      return true;
    }
    return false;
  }
  protected override async Task OnInitializedAsync()
  {
    _httpClient = HttpClientFactory.CreateClient("HotelBookingAPI");
    var token = await _localStorage.GetItemAsync<string>("accessToken");
    await EnsureAuthTokenAsync();
    try
    {
      hotels = await _httpClient.GetFromJsonAsync<List<HotelListItemVM>>("Hotel/highly-rated");
    }
    catch { hotels = new List<HotelListItemVM>(); }
    finally { isLoading = false; }
  }


  private async Task ToggleWishlist(int hotelId)
  {
    if (loadingHotels.Contains(hotelId)) return;

    if (!await EnsureAuthTokenAsync())
    {
      Snackbar.Add("Vui lòng đăng nhập để lưu khách sạn.", Severity.Warning);
      return;
    }

    loadingHotels.Add(hotelId);
    var hotel = hotels?.FirstOrDefault(h => h.HotelId == hotelId);

    if (hotel != null)
    {
      var oldState = hotel.IsWishlist;
      hotel.IsWishlist = !hotel.IsWishlist;

      try
      {
        // Dùng _httpClient đã được EnsureAuthTokenAsync xử lý Header
        var response = await _httpClient!.PostAsync($"wishlist/toggle/{hotelId}", null);

        if (!response.IsSuccessStatusCode)
        {
          // Lỗi -> Rollback UI
          hotel.IsWishlist = oldState;

          if (response.StatusCode == System.Net.HttpStatusCode.Unauthorized)
          {
            Snackbar.Add("Phiên đăng nhập hết hạn.", Severity.Error);
            _httpClient.DefaultRequestHeaders.Authorization = null; // Clear header lỗi
            await _localStorage.RemoveItemAsync("accessToken");
          }
          else
          {
            Snackbar.Add("Lỗi cập nhật.", Severity.Error);
          }
        }
      }
      catch
      {
        hotel.IsWishlist = oldState;
        Snackbar.Add("Lỗi kết nối.", Severity.Error);
      }
      finally
      {
        loadingHotels.Remove(hotelId);
        StateHasChanged();
      }
    }
  }
  private async Task Scroll(int direction)
  {
    await JSRuntime.InvokeVoidAsync("scrollContainer", direction);
  }
}