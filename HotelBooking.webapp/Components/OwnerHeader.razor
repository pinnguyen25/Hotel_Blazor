@using HotelBooking.Client
@inject ICurrentUserService CurrentUserService
@inject NavigationManager _nav
@inject IHttpClientFactory ClientFactory

<nav class="navbar navbar-expand bg-dark border-bottom shadow-sm sticky-top px-4" style="height: 64px;">
    <div class="d-flex justify-content-between w-100 align-items-center">
        
        <div class="d-flex align-items-center gap-3">
            <a class="navbar-brand fw-bold text-primary d-flex align-items-center gap-2" href="/owner/hotels">
                <img src="/images/logo/chillzone.png" alt="Logo" style="height: 32px;" />
            </a>
        </div>

        <div class="d-flex align-items-center gap-3">
            @if (_walletBalance > 0)
            {
                <a href="/owner/finances" class="text-decoration-none d-none d-md-block animate-fade-in">
                    <div class="d-flex align-items-center px-3 py-1 rounded-pill bg-success bg-opacity-25 border border-success border-opacity-25">
                        <i class="bi bi-wallet2 text-success me-2"></i>
                        <span class="fw-bold text-success">@_walletBalance.ToString("N0") ₫</span>
                    </div>
                </a>
            }

            <a href="/" class="btn btn-outline-light text-secondary border-0 d-none d-md-flex align-items-center gap-2">
                <i class="bi bi-house-door"></i> <span>Trang chủ</span>
            </a>

            <div class="vr mx-2"></div>

            <div class="dropdown">
                <a class="d-flex align-items-center text-decoration-none dropdown-toggle text-white" 
                   href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                    
                    <div class="text-end me-2 d-none d-md-block" style="line-height: 1.2;">
                        <div class="fw-bold small">@_currentUser?.FullName</div>
                        @* <div class="text-muted" style="font-size: 0.75rem;">@(_currentUser?.Roles.FirstOrDefault() ?? "Owner")</div> *@
                    </div>

                    @if (!string.IsNullOrEmpty(_currentUser?.Avatar))
                    {
                        <img src="@_currentUser.Avatar" class="rounded-circle border" width="38" height="38" style="object-fit: cover;" />
                    }
                    else
                    {
                        <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center fw-bold" 
                             style="width: 38px; height: 38px;">
                            @(_currentUser?.FullName?.FirstOrDefault().ToString().ToUpper() ?? "U")
                        </div>
                    }
                </a>

                <ul class="dropdown-menu dropdown-menu-end border-0 shadow-lg mt-2 p-2 rounded-3" style="min-width: 200px;">
                    <li><h6 class="dropdown-header">Tài khoản</h6></li>
                    <li><a class="dropdown-item rounded-2" href="/user/profile"><i class="bi bi-person me-2"></i>Hồ sơ cá nhân</a></li>
                    <li>
                        <a class="dropdown-item rounded-2 d-flex justify-content-between align-items-center" href="/owner/finances">
                            <span><i class="bi bi-cash-stack me-2"></i>Ví & Tài chính</span>
                            @if(_walletBalance > 0) { <span class="badge bg-success-subtle text-success rounded-pill">$$$</span> }
                        </a>
                    </li>
                    <li><hr class="dropdown-divider"></li>
                    <li>
                        <button class="dropdown-item rounded-2 text-danger fw-bold" @onclick="Logout">
                            <i class="bi bi-box-arrow-right me-2"></i>Đăng xuất
                        </button>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</nav>

@code {
    private CurrentUserVM? _currentUser;
    private decimal _walletBalance = 0;
    protected override async Task OnInitializedAsync()
    {
        _currentUser = await CurrentUserService.GetCurrentUserAsync();
        if (_currentUser != null)
        {
            await LoadWalletBalance();
        }
    }

    private async Task LoadWalletBalance()
    {
        try
        {
            var client = ClientFactory.CreateClient("HotelBookingAPI");
            var res = await client.GetFromJsonAsync<ApiResponse<OwnerWalletVM>>("wallet");
            if (res != null && res.StatusCode == StatusCodeResponse.Success)
            {
                _walletBalance = res.Content.Balance;
            }
        }
        catch { /* Kệ lỗi, không hiện số dư cũng ko sao */ }
    }

    private async Task Logout()
    {
        await CurrentUserService.LogoutAsync();
    }
}