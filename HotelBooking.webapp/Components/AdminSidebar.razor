<style>
    /* Sử dụng chung style với OwnerSidebar 
       để đảm bảo đồng bộ hoàn toàn về giao diện.
    */

    /* Tổng thể Sidebar */
    .sidebar-theme {
        background-color: #1e2125; /* Màu nền tối */
        color: #adb5bd; /* Màu chữ xám */
    }

    /* Style cho Label (Tiêu đề nhóm) */
    .nav-label {
        font-size: 0.7rem;
        font-weight: 700;
        color: #6c757d;
        @* padding-left: 12px; *@
        letter-spacing: 0.5px;
    }

    /* Style cho Link chính */
    .nav-link {
        color: #adb5bd !important;
        padding: 10px 12px;
        display: flex;
        align-items: center;
        font-weight: 500;
        font-size: 0.9rem;
        cursor: pointer;
    }

    .nav-link i {
        font-size: 1.1rem;
        margin-right: 12px;
        width: 20px;
        text-align: center;
        transition: transform 0.2s;
    }

    /* Hiệu ứng Hover */
    .nav-link:not(.active):hover {
        background-color: rgba(255, 255, 255, 0.08);
        color: #fff !important;
        padding-left: 16px; /* Hiệu ứng trượt nhẹ */
    }

    .nav-link:hover i {
        transform: scale(1.1);
        color: #fff;
    }

    .hover-bright:hover {
        color: #fff !important;
    }

    /* Trạng thái Active */
    @* .nav-link.active {
        background-color: #0d6efd !important; /* Màu xanh Brand đồng bộ Owner */
        color: #fff !important;
        box-shadow: 0 4px 12px rgba(13, 110, 253, 0.3);
    } *@
    
    /* Xử lý riêng cho nút cha của Dropdown khi đang mở (không active màu xanh nền) */
    .nav-link[data-bs-toggle="collapse"][aria-expanded="true"] {
        color: #fff !important;
    }
    .nav-link[data-bs-toggle="collapse"].active {
        background-color: transparent !important;
        box-shadow: none !important;
        color: #adb5bd !important;
    }

    /* --- Sub-link (Menu con) --- */
    .sub-link {
        font-size: 0.85rem;
        padding: 8px 10px;
        border-radius: 6px;
    }
    
    .sub-link.active {
        background-color: rgba(255, 255, 255, 0.1) !important;
        color: #fff !important;
        font-weight: 600;
        box-shadow: none !important;
    }
    
    .sub-link:hover {
  
        background-color: rgba(255, 255, 255, 0.05);
    }

    /* Mũi tên xoay */
    .nav-link[aria-expanded="true"] .transition-icon {
        transform: rotate(180deg);
    }
    .transition-icon {
        transition: transform 0.3s ease;
    }

    /* Thanh cuộn */
    .custom-scrollbar::-webkit-scrollbar { width: 5px; }
    .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
    .custom-scrollbar::-webkit-scrollbar-thumb { background: #495057; border-radius: 10px; }
    .custom-scrollbar::-webkit-scrollbar-thumb:hover { background: #6c757d; }
</style>