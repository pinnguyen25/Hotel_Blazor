@using Blazored.LocalStorage
@using HotelBooking.webapp.ViewModels
@using System.Net.Http.Headers
@inject IHttpClientFactory _httpClientFactory
@inject ILocalStorageService _localStorage
@inject ISnackbar Snackbar

@if (IsVisible)
{
    <div class="modal-backdrop fade show"></div>

    <div class="modal fade show d-block" tabindex="-1" role="dialog" aria-modal="true">
        <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
            <div class="modal-content rounded-4 shadow border-0">
                
                <div class="modal-header border-bottom-0 pb-0">
                    <h5 class="handwriting modal-title" style="color: #54a9ffff;">Chi tiết đơn đặt phòng</h5>
                    <button type="button" class="btn-close" @onclick="Close"></button>
                </div>

                <div class="modal-body p-4">
                    @if (IsLoading)
                    {
                        <div class="d-flex justify-content-center align-items-center py-5">
                            <div class="spinner-border text-primary me-3" role="status"></div>
                            <span class="text-muted">Đang tải dữ liệu...</span>
                        </div>
                    }
                    else if (BookingDetails == null)
                    {
                        <div class="alert alert-danger rounded-3">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>
                            Không tìm thấy thông tin đơn hàng.
                        </div>
                    }
                    else
                    {
                        <div class="d-flex align-items-start mb-4">
                            <img src="@(BookingDetails.HotelImage ?? "/images/default-hotel.jpg")" 
                                 class="rounded-3 me-3 border shadow-sm" 
                                 style="width: 100px; height: 75px; object-fit: cover;" />
                            <div class="flex-grow-1">
                                <h5 class="fw-bold text-primary mb-1">@BookingDetails.HotelName</h5>
                                <p class="text-muted small mb-1">
                                    <i class="bi bi-geo-alt-fill text-danger me-1"></i>@BookingDetails.HotelAddress
                                </p>
                                <span class="badge @GetStatusBadgeClass(BookingDetails.Status) rounded-pill">
                                    @GetStatusTextVietnamese(BookingDetails.Status)
                                </span>
                            </div>
                        </div>

                        <hr class="opacity-25" />

                        <div class="row g-2 mb-4 small">
                            <div class="col-6">
                                <span class="text-muted d-block">Mã đơn hàng</span>
                                <span class="fw-bold text-dark">#@BookingDetails.Id</span>
                            </div>
                            <div class="col-6 text-end">
                                <span class="text-muted d-block">Ngày đặt</span>
                                <span class="fw-bold text-dark">@BookingDetails.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span>
                            </div>
                            <div class="col-6 mt-2">
                                <span class="text-muted d-block">Nhận phòng</span>
                                <span class="fw-bold text-success fs-6">@BookingDetails.CheckIn.ToString("dd/MM/yyyy")</span>
                            </div>
                            <div class="col-6 text-end mt-2">
                                <span class="text-muted d-block">Trả phòng</span>
                                <span class="fw-bold text-danger fs-6">@BookingDetails.CheckOut.ToString("dd/MM/yyyy")</span>
                            </div>
                        </div>

                        <h6 class="text-dark mb-3">
                            <i class="bi bi-houses me-2"></i>Chi tiết phòng (@BookingDetails.Rooms.Count)
                        </h6>
                        <div class="d-flex flex-column gap-3 mb-4">
                            @foreach (var room in BookingDetails.Rooms)
                            {
                                <div class="bg-light p-3 rounded-3 border border-light-subtle position-relative overflow-hidden">
                                    <div class="position-absolute top-0 start-0 bottom-0 bg-primary" style="width: 4px;"></div>

                                    <div class="d-flex justify-content-between align-items-start ps-2">
                                        <div>
                                            <h6 class="fw-bold text-dark mb-1">@room.RoomTypeName</h6>
                                            <div class="d-flex flex-column gap-1 small text-secondary">
                                                <span>
                                                    <i class="bi bi-hdd-network me-2 text-primary"></i>
                                                    @(room.RoomNumber ?? "Tiêu chuẩn")
                                                </span>
                                                
                                                @if (!string.IsNullOrEmpty(room.RoomNumber))
                                                {
                                                    <span class="text-success fw-bold">
                                                        <i class="bi bi-door-open me-2"></i>Phòng số: @room.RoomNumber
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="fst-italic text-warning-dark">
                                                        <i class="bi bi-hourglass-split me-2"></i>Đang chờ xếp phòng
                                                    </span>
                                                }

                                                <span>
                                                    <i class="bi bi-person me-2 text-primary"></i>
                                                    Khách: <span class="fw-medium text-dark">@(room.GuestName ?? BookingDetails.ContactName)</span>
                                                </span>
                                            </div>
                                        </div>

                                        <div class="text-end">
                                            <div class="fw-bold text-primary fs-6">@room.Price.ToString("N0") ₫</div>
                                            <small class="text-muted" style="font-size: 0.75rem;">
                                                (@room.PricePerNight.ToString("N0")/đêm)
                                            </small>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>

                        <hr class="my-4 dashed-line" />

                        <h6 class="fw-bold text-dark mb-3"><i class="bi bi-stars me-2"></i>Dịch vụ đi kèm</h6>
                        <div class="card bg-light border-0 mb-4">
                            <div class="card-header bg-transparent border-0 fw-bold text-muted text-uppercase small">
                                <i class="bi bi-bag-check-fill me-1"></i> Dịch vụ đang có
                            </div>
                            <div class="card-body pt-0">
                                @if (BookingDetails.Services != null && BookingDetails.Services.Any())
                                {
                                    <ul class="list-group list-group-flush bg-transparent">
                                        @foreach (var sv in BookingDetails.Services)
                                        {
                                            <li class="list-group-item bg-transparent d-flex justify-content-between align-items-center px-0 py-2 border-bottom-dashed">
                                                <div>
                                                    <span class="fw-medium">@sv.ServiceName</span>
                                                    <span class="badge bg-secondary rounded-pill ms-1">x@(sv.Quantity)</span>
                                                    <div class="small">
                                                        @if (sv.IsPaid) { <span class="text-success"><i class="bi bi-check-all"></i> Đã thanh toán</span> }
                                                        else { <span class="text-warning-dark"><i class="bi bi-clock"></i> Chưa thanh toán</span> }
                                                    </div>
                                                </div>
                                                <span class="fw-bold">@((sv.Price * sv.Quantity).ToString("N0")) ₫</span>
                                            </li>
                                        }
                                    </ul>
                                }
                                else
                                {
                                    <small class="text-muted fst-italic">Chưa có dịch vụ nào.</small>
                                }
                            </div>
                        </div>

                        @if (IsAddingMode)
                        {
                            <div class="border border-primary bg-primary bg-opacity-10 rounded-3 p-3 animate-fade-in">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <h6 class="fw-bold text-primary m-0"><i class="bi bi-plus-circle-fill me-2"></i>Chọn thêm dịch vụ</h6>
                                    <button class="btn btn-sm btn-link text-decoration-none" @onclick="() => IsAddingMode = false">Hủy</button>
                                </div>

                                <div class="d-flex flex-column gap-2 overflow-auto custom-scrollbar pe-1" style="max-height: 300px;">
                                    @if (AvailableServices.Any())
                                    {
                                        @foreach (var item in AvailableServices)
                                        {
                                            <div class="bg-white p-2 rounded border d-flex justify-content-between align-items-center shadow-sm">
                                                <div>
                                                    <div class="fw-bold text-dark">@item.Name</div>
                                                    <small class="text-primary fw-bold">@item.Price.ToString("N0") ₫ <span class="text-muted fw-normal">/@item.Unit</span></small>
                                                </div>
                                                
                                                <div class="d-flex align-items-center bg-light rounded-pill border px-2 py-1">
                                                    <button class="btn btn-sm p-0 text-secondary" @onclick="() => UpdateNewQty(item, -1)" disabled="@(item.Quantity <= 0)">
                                                        <i class="bi bi-dash-lg"></i>
                                                    </button>
                                                    <span class="mx-3 fw-bold small" style="width: 20px; text-align: center;">@item.Quantity</span>
                                                    <button class="btn btn-sm p-0 text-primary" @onclick="() => UpdateNewQty(item, 1)">
                                                        <i class="bi bi-plus-lg"></i>
                                                    </button>
                                                </div>
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <div class="text-center text-muted small py-3">Đang tải danh sách...</div>
                                    }
                                </div>

                                <div class="mt-3 pt-3 border-top border-primary border-opacity-25">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <span class="fw-bold text-dark">Tổng phát sinh:</span>
                                        <span class="fw-bold text-danger fs-5">+@NewTotalAmount.ToString("N0") ₫</span>
                                    </div>
                                    <button class="btn btn-primary w-100 fw-bold shadow-sm" 
                                            @onclick="SubmitNewServices" 
                                            disabled="@(NewTotalAmount <= 0 || IsSubmitting)">
                                        @if (IsSubmitting) { <span class="spinner-border spinner-border-sm me-2"></span><span>Đang xử lý...</span> }
                                        else { <span><i class="bi bi-cart-check me-2"></i>Xác nhận thêm</span> }
                                    </button>
                                </div>
                            </div>
                        }
                        else
                        {
                            @if (BookingDetails.Status == "Confirmed" || BookingDetails.Status == "CheckedIn")
                            {
                                <button class="btn btn-outline-primary w-100 py-2 border-dashed" @onclick="OpenAddMode">
                                    <i class="bi bi-cart-plus me-2"></i>Mua thêm dịch vụ / tiện ích
                                </button>
                            }
                        }

                        <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                            <span class="fs-5 fw-bold text-dark">TỔNG CỘNG</span>
                            <span class="fs-4 fw-bold text-danger">@BookingDetails.TotalPrice.ToString("N0") ₫</span>
                        </div>

                        <div class="mt-4 p-3 bg-light-subtle border rounded-3 small">
                            <div class="fw-bold text-uppercase text-secondary mb-2" style="font-size: 0.75rem;">Người đặt phòng</div>
                            <div class="mb-1"><i class="bi bi-person-circle me-2"></i> @BookingDetails.ContactName</div>
                            <div class="mb-1"><i class="bi bi-telephone-fill me-2"></i> @BookingDetails.ContactPhone</div>
                            <div class="mb-1"><i class="bi bi-envelope-fill me-2"></i> @BookingDetails.ContactEmail</div>
                            @if (!string.IsNullOrEmpty(BookingDetails.Note))
                            {
                                <div class="mt-2 pt-2 border-top fst-italic text-muted">
                                    <i class="bi bi-sticky-fill me-1"></i> "Ghi chú: @BookingDetails.Note"
                                </div>
                            }
                        </div>
                    }
                </div>

                <div class="modal-footer border-top-0 pt-0">
                    <button type="button" class="btn btn-secondary rounded-pill px-4" @onclick="Close">Đóng</button>
                    @if (BookingDetails?.Status == "PendingPayment")
                    {
                        <button type="button" class="btn btn-primary rounded-pill px-4" @onclick="PayNow">
                            <i class="bi bi-credit-card me-2"></i>Thanh toán ngay
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
}

<style>
    .border-bottom-dashed { border-bottom: 1px dashed #dee2e6; }
    .border-dashed { border-style: dashed !important; }
    .text-warning-dark { color: #d35400; }
    .animate-fade-in { animation: fadeIn 0.3s; }
    @@keyframes fadeIn { from { opacity: 0; transform: translateY(-10px); } to { opacity: 1; transform: translateY(0); } }
</style>

@code {
    // 1. Biến điều khiển hiển thị
    public bool IsVisible { get; private set; } = false;
    public bool IsLoading { get; private set; } = false;

    public bool IsAddingMode { get; set; } = false;
    public bool IsSubmitting { get; set; } = false;

    public BookingDetailVM? BookingDetails { get; set; }
    public List<ServiceAddOnVM> AvailableServices { get; set; } = new();
    private decimal NewTotalAmount => AvailableServices.Sum(s => s.Price * s.Quantity);
    private HttpClient? _httpClient;

    // 2. Hàm Show - Được gọi từ trang cha (UserProfile)
    public async Task ShowAsync(int bookingId)
    {
        IsVisible = true;
        IsLoading = true;
        IsAddingMode = false;
        BookingDetails = null; // Reset data cũ
        StateHasChanged(); // Cập nhật UI để hiện Loading

        await LoadBookingData(bookingId);

        IsLoading = false;
        StateHasChanged(); // Cập nhật UI để hiện Data
    }
    
    // 3. Hàm Đóng
    public void Close()
    {
        IsVisible = false;
        StateHasChanged();
    }

    private async Task SetAuthHeader()
    {
        var token = await _localStorage.GetItemAsync<string>("accessToken");
        if (!string.IsNullOrEmpty(token))
            _httpClient!.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);
    }

    // 4. Logic gọi API
    private async Task LoadBookingData(int bookingId)
    {
        _httpClient = _httpClientFactory.CreateClient("HotelBookingAPI");
        try
        {
           
            await SetAuthHeader();

            var response = await _httpClient.GetFromJsonAsync<ApiResponse<BookingDetailVM>>($"hotel/booking/detail/{bookingId}");

            if (response != null && response.Content != null)
            {
                BookingDetails = response.Content;
            }
            else
            {
                Snackbar.Add(response?.Message ?? "Lỗi tải dữ liệu", Severity.Error);
            }
        }
        catch (Exception)
        {
            Snackbar.Add("Không thể kết nối đến máy chủ.", Severity.Error);
            Close();
        }
    }

    private async Task OpenAddMode()
    {
        IsAddingMode = true;
        // Gọi API lấy list dịch vụ của khách sạn này (nếu chưa có)
        if (!AvailableServices.Any() && BookingDetails != null)
        {
            try 
            {
                var res = await _httpClient!.GetFromJsonAsync<ApiResponse<List<ServiceAddOnVM>>>($"hotel/services-add/{BookingDetails.HotelId}");
                if (res?.Content != null)
                {
                    // Reset số lượng về 0 (QUAN TRỌNG: Để tách biệt với cái đã mua)
                    AvailableServices = res.Content.Select(s => { s.Quantity = 0; return s; }).ToList();
                }
            }
            catch {}
        }
        else 
        {
            // Reset lại số lượng nếu mở lại
            foreach(var item in AvailableServices) item.Quantity = 0;
        }
    }

    private void UpdateNewQty(ServiceAddOnVM item, int change)
    {
        item.Quantity += change;
        if (item.Quantity < 0) item.Quantity = 0;
    }

    private async Task SubmitNewServices()
    {
        var itemsToAdd = AvailableServices.Where(x => x.Quantity > 0).ToList();
        if (!itemsToAdd.Any()) return;

        IsSubmitting = true;
        try
        {
            // Gọi API Bulk Insert (Backend bạn vừa sửa)
            var payload = new 
            { 
                BookingId = BookingDetails!.Id,
                Services = itemsToAdd.Select(s => new { ServiceId = s.ServiceId, Quantity = s.Quantity }).ToList()
            };

            var res = await _httpClient!.PostAsJsonAsync("hotel/booking/service/add", payload);
            
            if (res.IsSuccessStatusCode)
            {
                Snackbar.Add("Thêm dịch vụ thành công!", Severity.Success);
                IsAddingMode = false; // Tắt khung mua thêm
                await LoadBookingData(BookingDetails.Id); // Reload lại data chính để cập nhật list History
            }
            else
            {
                Snackbar.Add("Lỗi khi thêm dịch vụ", Severity.Error);
            }
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { IsSubmitting = false; }
    }
    private void PayNow()
    {
        Snackbar.Add("Chức năng đang phát triển", Severity.Info);
    }

    // 5. Helper màu sắc trạng thái (Bootstrap Classes)
    private string GetStatusBadgeClass(string status) => status switch
    {
        "Confirmed" => "bg-success",
        "Completed" => "bg-primary",
        "Cancelled" => "bg-danger",
        "PendingPayment" => "bg-warning text-dark",
        "PendingRefund" => "bg-secondary",
        _ => "bg-secondary"
    };

    private string GetStatusTextVietnamese(string status) => status switch
    {
        "Confirmed" => "Đã xác nhận",
        "PendingPayment" => "Chờ thanh toán",
        "Paid" => "Đã thanh toán",
        "Completed" => "Hoàn tất",
        "Cancelled" => "Đã hủy",
        "PendingRefund" => "Chờ hoàn tiền",
        "Refunded" => "Đã hoàn tiền",
        "CheckedIn" => "Đã nhận phòng",
        _ => "Không xác định" // Default
    };
}